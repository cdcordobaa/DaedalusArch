# ============================================================
# DaedalusArch — Architectural Firewall Environment Config
# Copy to .env and fill in your values
# ============================================================

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=daedalus-dev
NEO4J_MAX_POOL_SIZE=10
NEO4J_CONNECTION_TIMEOUT_MS=5000

# --- LLM Provider ---
# Provider: "claude" | "openai"
LLM_PROVIDER=claude

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (optional alternative)
OPENAI_API_KEY=sk-...

# --- LLM Behaviour ---
# Model to use (e.g. claude-sonnet-4-6, gpt-4o)
LLM_MODEL=claude-sonnet-4-6
# Temperature MUST be 0 for reproducibility
LLM_TEMPERATURE=0
# Fixed seed for deterministic sampling (optional but recommended)
LLM_SEED=42
# Max concurrent LLM calls (Concurrency Governor)
LLM_MAX_CONCURRENT_CALLS=3
# Max retries on 429 / 5xx
LLM_MAX_RETRIES=3
# Timeout per LLM call in ms
LLM_TIMEOUT_MS=30000

# --- Evaluation ---
# Number of LLM runs per function for ICC computation
LLM_RUNS_PER_FUNCTION=3
# ICC threshold below which a function is flagged as unstable
LLM_ICC_THRESHOLD=0.70
# Confidence thresholds
LLM_CONFIDENCE_HIGH=0.85
LLM_CONFIDENCE_MEDIUM=0.60

# --- Storage ---
# Directory for APG snapshots (persistent mode)
APG_STORE_PATH=./APG_Store
# Directory for VCR cassettes (neuronal test replay)
VCR_CASSETTE_PATH=./tests/cassettes

# --- Audit Logging ---
AUDIT_LOG_PATH=./logs/audit.jsonl

# --- Pipeline ---
# Default pipeline mode: "stateless" | "persistent"
PIPELINE_MODE=stateless
# Default evaluation mode: "full" | "symbolic-only" | "neuronal-only"
EVALUATION_MODE=full
