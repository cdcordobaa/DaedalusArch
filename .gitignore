# Dependencies
node_modules/
!fixtures/unit/u2-alias/node_modules/
yarn.lock
pnpm-lock.yaml
!tests/fixtures/lockfiles/**/yarn.lock
!tests/fixtures/lockfiles/**/pnpm-lock.yaml

# Build and Distribution
dist/
build/
out/
# Fixture source directories named like build output (e.g. hexagonal application/ports/out) are source, not output.
!tests/fixtures/**/ports/out/
# Puzzle and pilot seed trees use the same layout (PUZZLE-01 baseline R1, 2026-10-21).
!experiments/**/ports/out/
# Committed agent snapshots under results/ keep the same source folders (TRAPRATE-01 lost them, 2026-10-28).
!results/**/ports/out/
!results/**/adapters/out/
.next/
.cache/

# Environment Variables
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.nyc_output/
*.lcov
cucumber.json

# IDEs and Editors
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store

# Project Specific
aidlc-docs/audit.log
tmp/
temp/

# DaedalusArch
APG_Store/
logs/
tests/cassettes/
*.jsonl
# The SDD demo transcript is the replay input of `npm run demo:sdd` (Docs/v1.3/sdd-demo.md)
!examples/sdd-library-loans/transcript/transcript.jsonl
# Pilot run records (TRAP-PILOT-v2 ladder): the per-turn and call logs are part of the results
!results/v1.5-pilot-ladder/**/*.jsonl
.firewall/

# Internal communications live in the private thesis repo, never here
Docs/reports/
Docs/presentation-kit/
Docs/v1.3/director-email*

# Python bytecode caches (compiled .pyc must not be committed)
__pycache__/

# DETECT-01 (exploratory): the semantic call ledger and fixture port folders named like build output are kept
!experiments/detect-01/calls.jsonl
!experiments/detect-01/fixtures/**/ports/out/

# SO5 taxonomy model panel: the raw coder answers (one line per call attempt) are the second-coder record
!experiments/so5-taxonomy/panel/*.jsonl

# HCAL-06 admission scoring: the R-MIRROR-SEM call ledger and the judged-candidate record are kept
!experiments/hcal-06/results/*.jsonl
