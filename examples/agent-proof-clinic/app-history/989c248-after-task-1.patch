+import type { BookAppointmentUseCase } from "../../application/book-appointment.js";
+import type { GetAppointmentUseCase } from "../../application/get-appointment.js";
+import type { Appointment } from "../../domain/appointment.js";
+import { DomainError, NotFoundError, SlotUnavailableError } from "../../domain/errors.js";
+import type { HttpHandler, HttpRequest, HttpResponse } from "./http.js";
+
+const APPOINTMENT_PATH = /^\/appointments\/([^/]+)$/;
+
+export function createAppointmentsHandler(
+  bookAppointment: BookAppointmentUseCase,
+  getAppointment: GetAppointmentUseCase,
+): HttpHandler {
+  return async (request: HttpRequest): Promise<HttpResponse> => {
+    try {
+      if (request.method === "POST" && request.path === "/appointments") {
+        const command = parseBookRequest(request.body);
+        if (typeof command === "string") return { status: 400, body: { error: command } };
+        const appointment = await bookAppointment.execute(command);
+        return { status: 201, body: toDto(appointment) };
+      }
+      const match = request.method === "GET" ? APPOINTMENT_PATH.exec(request.path) : null;
+      if (match) {
+        const appointment = await getAppointment.execute(decodeURIComponent(match[1]!));
+        return { status: 200, body: toDto(appointment) };
+      }
+      return { status: 404, body: { error: "Route not found" } };
+    } catch (error) {
+      return toErrorResponse(error);
+    }
+  };
+}
+
+function parseBookRequest(body: unknown): { patientId: string; doctorId: string; start: Date } | string {
+  if (typeof body !== "object" || body === null) return "Body must be a JSON object";
+  const { patientId, doctorId, start } = body as Record<string, unknown>;
+  if (typeof patientId !== "string" || !patientId) return "patientId is required";
+  if (typeof doctorId !== "string" || !doctorId) return "doctorId is required";
+  if (typeof start !== "string") return "start is required (ISO-8601 string)";
+  const startDate = new Date(start);
+  if (Number.isNaN(startDate.getTime())) return "start must be a valid ISO-8601 date";
+  return { patientId, doctorId, start: startDate };
+}
+
+function toDto(appointment: Appointment) {
+  return {
+    id: appointment.id,
+    patientId: appointment.patientId,
+    doctorId: appointment.doctorId,
+    start: appointment.slot.start.toISOString(),
+    end: appointment.slot.end.toISOString(),
+    status: appointment.status,
+  };
+}
+
+function toErrorResponse(error: unknown): HttpResponse {
+  if (error instanceof NotFoundError) return { status: 404, body: { error: error.message } };
+  if (error instanceof SlotUnavailableError) return { status: 409, body: { error: error.message } };
+  if (error instanceof DomainError) return { status: 422, body: { error: error.message } };
+  return { status: 500, body: { error: "Internal server error" } };
+}
