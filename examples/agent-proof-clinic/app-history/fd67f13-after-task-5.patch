diff --git a/src/adapters/inbound/csv.ts b/src/adapters/inbound/csv.ts
new file mode 100644
index 0000000..3e02499
--- /dev/null
+++ b/src/adapters/inbound/csv.ts
@@ -0,0 +1,19 @@
+import type { HttpResponse } from "./http.js";
+
+export type CsvValue = string | number;
+
+/** A CSV document with CRLF line endings and a trailing newline. */
+export function toCsv(header: readonly string[], rows: readonly (readonly CsvValue[])[]): string {
+  return [header, ...rows].map((row) => row.map(csvCell).join(",")).join("\r\n") + "\r\n";
+}
+
+export function csvResponse(csv: string): HttpResponse {
+  return { status: 200, headers: { "content-type": "text/csv; charset=utf-8" }, body: csv };
+}
+
+/** Quotes when needed and neutralises spreadsheet formula prefixes. */
+function csvCell(value: CsvValue): string {
+  let text = String(value);
+  if (typeof value === "string" && /^[=+\-@\t\r]/.test(text)) text = `'${text}`;
+  return /[",\r\n]/.test(text) ? `"${text.replace(/"/g, '""')}"` : text;
+}
diff --git a/src/adapters/inbound/error-responses.ts b/src/adapters/inbound/error-responses.ts
new file mode 100644
index 0000000..9166cbc
--- /dev/null
+++ b/src/adapters/inbound/error-responses.ts
@@ -0,0 +1,26 @@
+import {
+  DomainError,
+  ForbiddenError,
+  InvalidStateError,
+  NotFoundError,
+  SlotUnavailableError,
+} from "../../domain/errors.js";
+import type { HttpResponse } from "./http.js";
+import { BadRequest } from "./request-parsing.js";
+
+export function routeNotFound(): HttpResponse {
+  return { status: 404, body: { error: "Route not found" } };
+}
+
+/** Maps request and domain errors to HTTP statuses; anything else is a 500. */
+export function toErrorResponse(error: unknown): HttpResponse {
+  if (error instanceof BadRequest) return { status: 400, body: { error: error.message } };
+  if (error instanceof NotFoundError) return { status: 404, body: { error: error.message } };
+  if (error instanceof ForbiddenError) return { status: 403, body: { error: error.message } };
+  if (error instanceof SlotUnavailableError || error instanceof InvalidStateError) {
+    return { status: 409, body: { error: error.message } };
+  }
+  if (error instanceof DomainError) return { status: 422, body: { error: error.message } };
+  console.error(error);
+  return { status: 500, body: { error: "Internal server error" } };
+}
