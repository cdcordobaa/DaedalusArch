{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "allowJs": false,
    "baseUrl": ".",
    "paths": { "paynet-sdk": ["vendor/paynet-sdk/index.d.ts"] }
  },
  "include": ["src/**/*.ts", "vendor/**/*.d.ts"]
}
