{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@nestjs/common": ["vendor/nestjs-common"],
      "@nestjs/typeorm": ["vendor/nestjs-typeorm"],
      "typeorm": ["vendor/typeorm"],
      "express": ["vendor/express"]
    }
  },
  "include": ["src/**/*.ts", "vendor/**/*.d.ts"]
}
