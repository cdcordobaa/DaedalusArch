{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "express": ["vendor/express"],
      "@prisma/client": ["vendor/prisma-client"],
      "typeorm": ["vendor/typeorm"]
    }
  },
  "include": ["src/**/*.ts", "vendor/**/*.d.ts"]
}
