{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "express": ["vendor/express"],
      "typedi": ["vendor/typedi"],
      "typeorm": ["vendor/typeorm"],
      "typeorm-typedi-extensions": ["vendor/typeorm-typedi-extensions"]
    }
  },
  "include": ["src/**/*.ts", "vendor/**/*.d.ts"]
}
