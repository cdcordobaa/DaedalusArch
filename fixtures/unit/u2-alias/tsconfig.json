{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@app/*": ["src/*"],
      "~/*": ["src/*"],
      "@libs/*": ["../u2-alias-libs/*"],
      "@internal/pg": ["node_modules/@internal/pg"]
    }
  },
  "include": ["src/**/*.ts"]
}
