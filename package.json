{
  "name": "daedalus-arch",
  "version": "0.1.0",
  "description": "Architectural Firewall — spec-driven compliance tool using neuro-symbolic evaluation",
  "main": "dist/cli/index.js",
  "bin": {
    "daedalus": "dist/cli/bin.js",
    "daedalus-mcp": "dist/mcp-server/main.js",
    "daedalus-arch": "dist/cli/bin.js",
    "daedalus-arch-mcp": "dist/mcp-server/main.js"
  },
  "files": [
    "dist/**/*.js",
    "presets/*.yaml",
    "specs/*.yaml",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.json",
    "build:watch": "tsc --project tsconfig.json --watch",
    "prepare": "npm run build",
    "start": "node dist/cli/bin.js",
    "dev": "tsx src/cli/index.ts",
    "mcp": "tsx src/mcp-server/main.ts",
    "mcp:check-file": "tsx src/mcp-server/check-file-cli.ts",
    "loop:replay": "tsx scripts/loop-replay-cli.ts",
    "test:loop-replay": "jest --maxWorkers=2 --forceExit tests/integration/loop",
    "test": "jest --forceExit --passWithNoTests",
    "test:unit": "jest --testPathPattern='tests/unit' --forceExit --passWithNoTests",
    "test:integration": "jest --testPathPattern='tests/integration' --forceExit --passWithNoTests",
    "test:coverage": "jest --forceExit --coverage",
    "test:golden": "jest --config jest.golden.config.cjs --runInBand --forceExit",
    "test:golden:full": "jest --config jest.golden-full.config.cjs --runInBand --forceExit",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "typecheck:u0-tests": "tsc -p tsconfig.u0-tests.json",
    "u5b:score": "tsx scripts/score-golden-cli.ts",
    "u5b:rescore": "tsx scripts/rescore-cli.ts",
    "u5b:label": "tsx scripts/llm-label-cli.ts",
    "u5b:run": "tsx scripts/run-experiment-cli.ts",
    "u5b:aggregate": "tsx scripts/aggregate-cli.ts",
    "u5b:env": "tsx scripts/record-env-cli.ts"
  },
  "keywords": [
    "architecture",
    "compliance",
    "typescript",
    "neuro-symbolic",
    "fitness-functions"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "antlr4ng": "3.0.16",
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "dotenv": "^16.4.7",
    "neo4j-driver": "^5.28.1",
    "openai": "^4.104.0",
    "ora": "^8.2.0",
    "p-limit": "^6.2.0",
    "ts-morph": "^25.0.0",
    "yaml": "^2.8.2",
    "zod": "^3.25.20"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@neo4j-cypher/language-support": "2.0.0-next.38",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "@types/picomatch": "^4.0.2",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "antlr-ng": "1.0.10",
    "eslint": "^9.30.0",
    "jest": "^29.7.0",
    "jest-cucumber": "^4.5.0",
    "playwright-core": "1.56.1",
    "prettier": "^3.5.3",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vega": "^6.4.0",
    "vega-lite": "^6.5.0"
  }
}
