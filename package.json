{
  "name": "daedalus-arch",
  "version": "0.1.0",
  "description": "Architectural Firewall — spec-driven compliance tool using neuro-symbolic evaluation",
  "main": "dist/cli/index.js",
  "bin": {
    "daedalus-arch": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:watch": "tsc --project tsconfig.json --watch",
    "start": "node dist/cli/index.js",
    "dev": "tsx src/cli/index.ts",
    "test": "jest --forceExit --passWithNoTests",
    "test:unit": "jest --testPathPattern='tests/unit' --forceExit --passWithNoTests",
    "test:integration": "jest --testPathPattern='tests/integration' --forceExit --passWithNoTests",
    "test:coverage": "jest --forceExit --coverage",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "architecture",
    "compliance",
    "typescript",
    "neuro-symbolic",
    "fitness-functions"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@google/generative-ai": "^0.24.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "dotenv": "^16.4.7",
    "neo4j-driver": "^5.28.1",
    "openai": "^4.104.0",
    "ora": "^8.2.0",
    "p-limit": "^6.2.0",
    "ts-morph": "^25.0.0",
    "yaml": "^2.8.2",
    "zod": "^3.25.20"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "@types/picomatch": "^4.0.2",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "eslint": "^9.30.0",
    "jest": "^29.7.0",
    "jest-cucumber": "^4.5.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3"
  }
}
