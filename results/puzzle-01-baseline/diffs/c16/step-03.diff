diff --git a/b/src/ledger/application/GetStatement.ts b/b/src/ledger/application/GetStatement.ts
new file mode 100644
index 00000000..a30950af
--- /dev/null
+++ b/b/src/ledger/application/GetStatement.ts
@@ -0,0 +1,17 @@
+import type { AccountRepository } from '../domain/account/AccountRepository';
+import { AccountId } from '../domain/account/value-objects/AccountId';
+import { LedgerError } from '../domain/LedgerError';
+import type { StatementItem, StatementLog } from './StatementLog';
+
+export class GetStatement {
+  constructor(
+    private readonly accounts: AccountRepository,
+    private readonly log: StatementLog,
+  ) {}
+
+  execute(accountId: string): StatementItem[] {
+    const account = this.accounts.byId(AccountId.of(accountId));
+    if (account === undefined) throw new LedgerError(`no account ${accountId}`);
+    return this.log.newestFirst(account.id.value);
+  }
+}
diff --git a/b/src/ledger/application/StatementLog.ts b/b/src/ledger/application/StatementLog.ts
new file mode 100644
index 00000000..a0ecc5f3
--- /dev/null
+++ b/b/src/ledger/application/StatementLog.ts
@@ -0,0 +1,20 @@
+export type StatementKind = 'deposit' | 'withdrawal' | 'transfer-out' | 'transfer-in';
+
+export interface StatementItem {
+  readonly kind: StatementKind;
+  readonly amount: number;
+  readonly counterpart: string | null;
+}
+
+/** Every stored movement per account, in the order it happened; shared by every use case. */
+export class StatementLog {
+  private readonly rows = new Map<string, StatementItem[]>();
+
+  record(accountId: string, item: StatementItem): void {
+    this.rows.set(accountId, [...(this.rows.get(accountId) ?? []), item]);
+  }
+
+  newestFirst(accountId: string): StatementItem[] {
+    return [...(this.rows.get(accountId) ?? [])].reverse();
+  }
+}
