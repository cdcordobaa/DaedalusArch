+import { Allocation, Gardener, Plot } from '../domain/garden';
+
+export interface PlotRepository {
+  save(plot: Plot): void;
+  find(number: number): Plot | undefined;
+  all(): Plot[];
+}
+
+export interface GardenerRepository {
+  save(g: Gardener): void;
+  find(id: string): Gardener | undefined;
+  all(): Gardener[];
+}
+
+export interface AllocationRepository {
+  save(a: Allocation): void;
+  find(id: string): Allocation | undefined;
+  findByPaymentRef(ref: string): Allocation | undefined;
+  active(): Allocation[];
+}
+
+export interface WaitingList {
+  enqueue(gardenerId: string): void;
+  remove(gardenerId: string): void;
+  first(): string | undefined;
+  all(): string[];
+}
+
+export interface PaymentProvider {
+  createPaymentLink(reference: string, amount: number, description: string): Promise<string>;
+}
+
+export interface Clock {
+  now(): Date;
+}
diff --git a/src/config/main.ts b/src/config/main.ts
new file mode 100644
index 0000000..e58ed2f
--- /dev/null
+++ b/src/config/main.ts
@@ -0,0 +1,26 @@
+import { GardenService } from '../application/garden-service';
+import {
+  InMemoryAllocationRepository,
+  InMemoryGardenerRepository,
+  InMemoryPlotRepository,
+  InMemoryWaitingList,
+} from '../adapters/outbound/in-memory';
+import { PayBeeClient } from '../adapters/outbound/paybee';
+import { SystemClock } from '../adapters/outbound/system-clock';
+import { createApp } from '../adapters/inbound/http';
+
+const garden = new GardenService(
+  new InMemoryPlotRepository(),
+  new InMemoryGardenerRepository(),
+  new InMemoryAllocationRepository(),
+  new InMemoryWaitingList(),
+  new PayBeeClient(process.env.PAYBEE_URL ?? 'https://api.paybee.example', process.env.PAYBEE_KEY ?? '', process.env.PAYBEE_WEBHOOK ?? ''),
+  new SystemClock(),
+);
+
+// check for overdue payments every hour
+setInterval(() => {
+  garden.releaseOverdue().catch((e) => console.error('release failed', e));
+}, 60 * 60 * 1000);
+
+createApp(garden).listen(Number(process.env.PORT ?? 3000), () => console.log('garden service up'));
diff --git a/src/domain/garden.ts b/src/domain/garden.ts
new file mode 100644
index 0000000..3c3614c
--- /dev/null
+++ b/src/domain/garden.ts
@@ -0,0 +1,42 @@
+export interface Plot {
+  number: number;
+  sizeM2: number;
+  raisedBed: boolean;
+}
+
+export interface Gardener {
+  id: string;
+  name: string;
+  email: string;
+  appliedAt: string;
+}
+
+export type AllocationStatus = 'awaiting-payment' | 'paid' | 'released';
+
+export interface Allocation {
+  id: string;
+  plotNumber: number;
+  gardenerId: string;
+  allocatedAt: string;
+  fee: number;
+  status: AllocationStatus;
+  paymentLink?: string;
+  paymentRef?: string;
+}
+
+export const PAYMENT_DEADLINE_DAYS = 14;
+
+export function feeFor(plot: Plot): number {
+  // yearly fee: 1.5 per m2, raised beds +10
+  return Math.round(plot.sizeM2 * 1.5 + (plot.raisedBed ? 10 : 0));
+}
+
+export function isPaymentOverdue(a: Allocation, now: Date): boolean {
+  if (a.status !== 'awaiting-payment') return false;
+  const deadline = new Date(a.allocatedAt).getTime() + PAYMENT_DEADLINE_DAYS * 24 * 3600 * 1000;
+  return now.getTime() > deadline;
+}
+
+export function isActive(a: Allocation): boolean {
+  return a.status !== 'released';
+}
