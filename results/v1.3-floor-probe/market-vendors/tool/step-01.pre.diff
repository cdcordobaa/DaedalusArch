@@ -0,0 +1,41 @@
+import { randomUUID } from 'node:crypto';
+import { BusinessError, CardSale, ReaderLink } from './models';
+import {
+  bookingRepository,
+  cardSaleRepository,
+  marketDayRepository,
+  readerLinkRepository,
+  vendorRepository,
+} from '../persistence/repositories';
+
+export const salesService = {
+  linkReader(readerId: string, marketDayId: string, vendorId: string): ReaderLink {
+    if (!marketDayRepository.find(marketDayId)) throw new BusinessError('unknown market day', 404);
+    if (!vendorRepository.find(vendorId)) throw new BusinessError('unknown vendor', 404);
+    return readerLinkRepository.save({ readerId, marketDayId, vendorId });
+  },
+
+  /** A PayLane card sale: accepted only from a reader linked to a vendor with a booking that day. */
+  recordPayLaneSale(readerId: string, amount: number, time: string): CardSale {
+    if (!(amount > 0)) throw new BusinessError('amount must be positive');
+    const day = marketDayRepository.findByDate(time.slice(0, 10));
+    if (!day) throw new BusinessError('no market day on the sale date', 422);
+    const link = readerLinkRepository.find(day.id, readerId);
+    if (!link) throw new BusinessError('reader is not linked to a vendor for this market day', 422);
+    const booked = bookingRepository.forDay(day.id).some((b) => b.vendorId === link.vendorId);
+    if (!booked) throw new BusinessError('vendor has no booking on this market day', 422);
+    return cardSaleRepository.save({
+      id: randomUUID(),
+      readerId,
+      vendorId: link.vendorId,
+      marketDayId: day.id,
+      amount,
+      time,
+      provider: 'paylane',
+    });
+  },
+
+  salesForVendor(vendorId: string, marketDayId?: string): CardSale[] {
+    return marketDayId ? cardSaleRepository.forVendorAndDay(vendorId, marketDayId) : cardSaleRepository.forVendor(vendorId);
+  },
+};
diff --git a/src/persistence/repositories.ts b/src/persistence/repositories.ts
new file mode 100644
index 0000000..c41aa00
--- /dev/null
+++ b/src/persistence/repositories.ts
@@ -0,0 +1,41 @@
+import { Booking, CardSale, MarketDay, Pitch, ReaderLink, Vendor } from '../business/models';
+import { bookings, cardSales, marketDays, pitches, readerLinks, vendors } from './store';
+
+export const marketDayRepository = {
+  save: (d: MarketDay) => marketDays.upsert(d),
+  find: (id: string) => marketDays.get(id),
+  findByDate: (date: string) => marketDays.where((d) => d.date === date)[0],
+  all: () => marketDays.all().sort((a, b) => a.date.localeCompare(b.date)),
+};
+
+export const pitchRepository = {
+  save: (p: Pitch) => pitches.upsert(p),
+  find: (n: number) => pitches.get(String(n)),
+  all: () => pitches.all().sort((a, b) => a.number - b.number),
+};
+
+export const vendorRepository = {
+  save: (v: Vendor) => vendors.upsert(v),
+  find: (id: string) => vendors.get(id),
+  all: () => vendors.all(),
+};
+
+export const bookingRepository = {
+  save: (b: Booking) => bookings.upsert(b),
+  find: (id: string) => bookings.get(id),
+  delete: (id: string) => bookings.delete(id),
+  forDay: (marketDayId: string) => bookings.where((b) => b.marketDayId === marketDayId),
+  forVendor: (vendorId: string) => bookings.where((b) => b.vendorId === vendorId),
+};
+
+export const readerLinkRepository = {
+  save: (l: ReaderLink) => readerLinks.upsert(l),
+  find: (marketDayId: string, readerId: string) => readerLinks.get(`${marketDayId}|${readerId}`),
+};
+
+export const cardSaleRepository = {
+  save: (s: CardSale) => cardSales.upsert(s),
+  forVendorAndDay: (vendorId: string, marketDayId: string) =>
+    cardSales.where((s) => s.vendorId === vendorId && s.marketDayId === marketDayId),
+  forVendor: (vendorId: string) => cardSales.where((s) => s.vendorId === vendorId),
+};
