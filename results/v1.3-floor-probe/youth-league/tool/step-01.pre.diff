+export type AgeGroup = `U${number}`;
+
+export interface Team {
+  id: string;
+  name: string;
+  ageGroup: AgeGroup;
+  coachName: string;
+  coachEmail: string;
+}
+
+export interface Player {
+  id: string;
+  name: string;
+  birthDate: string;
+  parentEmail: string;
+  teamId: string;
+}
+
+export interface Result {
+  homeGoals: number;
+  awayGoals: number;
+  recordedAt: string;
+}
+
+export interface Fixture {
+  id: string;
+  homeTeamId: string;
+  awayTeamId: string;
+  pitch: string;
+  kickOff: string; // ISO date-time
+  result?: Result;
+}
+
+export class ValidationError extends Error {}
+export class NotFoundError extends Error {}
diff --git a/src/business/fixture-service.ts b/src/business/fixture-service.ts
