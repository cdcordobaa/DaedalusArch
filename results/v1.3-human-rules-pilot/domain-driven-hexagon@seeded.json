   {
    "name": "no-infra-to-api-deps",
    "severity": "error",
    "comment": "Infrastructure layer cannot depend on api layer",
    "from": {
     "path": "infrastructure|infra|database|repository"
    },
    "to": {
     "path": "controller|dtos|request|response|dto\\.ts$|controller\\.ts$|resolver\\.ts$"
    }
