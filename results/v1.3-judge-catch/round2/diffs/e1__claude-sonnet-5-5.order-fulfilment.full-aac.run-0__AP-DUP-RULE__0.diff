 import { OrderRepository } from "../domain/order-repository";
 import { OrderDto, toOrderDto } from "./order-dto";
 import { requireOrder } from "./require-order";
+import { DomainError } from "../domain/domain-error";
+import { isOrderState } from "../domain/order-state";
 
 export class GetOrderUseCase {
   constructor(private readonly orders: OrderRepository) {}
 
   async execute(orderId: string): Promise<OrderDto> {
     return toOrderDto(await requireOrder(this.orders, orderId));
+  }
+
+  validateExecute(state: string): void {
+    if (!isOrderState(state)) {
+          throw new DomainError("validation", `Unknown order state: ${state}`);
+        }
   }
 }
