diff --git a/src/adapters/outbound/in-memory-waiting-list-repository.ts b/src/adapters/outbound/in-memory-waiting-list-repository.ts
new file mode 100644
index 0000000..a83067b
--- /dev/null
+++ b/src/adapters/outbound/in-memory-waiting-list-repository.ts
@@ -0,0 +1,20 @@
+import type { WaitingListRepository } from '../../application/ports/waiting-list-repository';
+import type { WaitingListEntry } from '../../domain/waiting-list';
+
+export class InMemoryWaitingListRepository implements WaitingListRepository {
+  private readonly queues = new Map<string, WaitingListEntry[]>();
+
+  async forTool(toolId: string): Promise<WaitingListEntry[]> {
+    return [...(this.queues.get(toolId) ?? [])];
+  }
+
+  async append(entry: WaitingListEntry): Promise<void> {
+    const q = this.queues.get(entry.toolId) ?? [];
+    q.push(entry);
+    this.queues.set(entry.toolId, q);
+  }
+
+  async removeFirst(toolId: string): Promise<WaitingListEntry | undefined> {
+    return this.queues.get(toolId)?.shift();
+  }
+}
diff --git a/src/application/join-waiting-list.ts b/src/application/join-waiting-list.ts
new file mode 100644
index 0000000..31193e5
--- /dev/null
+++ b/src/application/join-waiting-list.ts
@@ -0,0 +1,22 @@
+import type { MemberRepository } from './ports/member-repository';
+import type { ToolRepository } from './ports/tool-repository';
+import type { WaitingListRepository } from './ports/waiting-list-repository';
+
+export class JoinWaitingList {
+  constructor(
+    private readonly tools: ToolRepository,
+    private readonly members: MemberRepository,
+    private readonly waitingList: WaitingListRepository,
+  ) {}
+
+  async execute(toolId: string, memberId: string, now = new Date()): Promise<number> {
+    const tool = await this.tools.findById(toolId);
+    if (tool === undefined) throw new Error(`unknown tool ${toolId}`);
+    if (tool.status !== 'on-loan') throw new Error(`${tool.name} is not out; it can be borrowed now`);
+    if ((await this.members.findById(memberId)) === undefined) throw new Error(`unknown member ${memberId}`);
+    const queue = await this.waitingList.forTool(toolId);
+    if (queue.some((e) => e.memberId === memberId)) throw new Error('member is already on the waiting list');
+    await this.waitingList.append({ toolId, memberId, since: now });
+    return queue.length + 1;
+  }
+}
