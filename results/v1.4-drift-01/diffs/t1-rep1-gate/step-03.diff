+import type { OrderCountQuery } from '../../ordering/index.js';
+import type { OrderCountSource, OrderMonthCount } from '../application/ports/OrderCountSource.js';
+
+/** Anti-corruption layer: translates ordering's order counts into billing's model. */
+export class OrderCountAcl implements OrderCountSource {
+  constructor(private readonly ordering: OrderCountQuery) {}
+
+  async placedBetween(from: Date, toExclusive: Date): Promise<OrderMonthCount[]> {
+    const counts = await this.ordering.countPlaced(from, toExclusive);
+    return counts.map((c) => ({ customerId: c.customerId, currency: c.currency, month: c.month, orders: c.count }));
+  }
+}
