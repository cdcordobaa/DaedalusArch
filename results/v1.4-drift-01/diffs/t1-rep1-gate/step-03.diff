diff --git a/src/shared-kernel/value-objects/Month.ts b/src/shared-kernel/value-objects/Month.ts
new file mode 100644
index 000000000..138f84a30
--- /dev/null
+++ b/src/shared-kernel/value-objects/Month.ts
@@ -0,0 +1,33 @@
+/** A calendar month in UTC, written YYYY-MM. */
+export class Month {
+  private constructor(readonly year: number, readonly month: number) {}
+
+  static parse(text: string): Month {
+    const m = /^(\d{4})-(0[1-9]|1[0-2])$/.exec(text);
+    if (m === null) throw new Error(`Invalid month "${text}", expected YYYY-MM`);
+    return new Month(Number(m[1]), Number(m[2]));
+  }
+
+  static of(date: Date): Month {
+    return new Month(date.getUTCFullYear(), date.getUTCMonth() + 1);
+  }
+
+  /** Number of months from this one to other (negative when other is earlier). */
+  monthsTo(other: Month): number {
+    return (other.year * 12 + other.month) - (this.year * 12 + this.month);
+  }
+
+  next(): Month {
+    return this.month === 12 ? new Month(this.year + 1, 1) : new Month(this.year, this.month + 1);
+  }
+
+  start(): Date {
+    const d = new Date(0);
+    d.setUTCFullYear(this.year, this.month - 1, 1);
+    return d;
+  }
+
+  toString(): string {
+    return `${String(this.year).padStart(4, '0')}-${String(this.month).padStart(2, '0')}`;
+  }
+}
