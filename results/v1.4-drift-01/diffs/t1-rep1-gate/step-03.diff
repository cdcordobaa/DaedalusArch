index 000000000..083bd837b
--- /dev/null
+++ b/src/ordering/application/CountPlacedOrders.ts
@@ -0,0 +1,20 @@
+import type { OrderCount, OrderCountQuery } from '../contracts/OrderCounts.js';
+import type { OrderRepository } from '../domain/order/OrderRepository.js';
+import { Month } from '../../shared-kernel/value-objects/Month.js';
+
+/** Query service behind the published OrderCountQuery contract. */
+export class CountPlacedOrders implements OrderCountQuery {
+  constructor(private readonly orders: OrderRepository) {}
+
+  async countPlaced(from: Date, toExclusive: Date): Promise<OrderCount[]> {
+    const counts = new Map<string, OrderCount>();
+    for (const order of await this.orders.placedBetween(from, toExclusive)) {
+      const month = Month.of(order.placedAt() as Date).toString();
+      const customerId = order.customerId.value;
+      const key = JSON.stringify([customerId, order.currency, month]);
+      const prev = counts.get(key);
+      counts.set(key, { customerId, currency: order.currency, month, count: (prev?.count ?? 0) + 1 });
+    }
+    return [...counts.values()];
+  }
+}
