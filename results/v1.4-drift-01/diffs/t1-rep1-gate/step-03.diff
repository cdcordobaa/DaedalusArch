+++ b/src/billing/application/GetMonthlyRevenueReport.ts
@@ -0,0 +1,45 @@
+import type { RevenueReportRow } from '../contracts/RevenueReport.js';
+import type { InvoiceRepository } from '../domain/invoice/InvoiceRepository.js';
+import type { OrderCountSource } from './ports/OrderCountSource.js';
+import { Month } from '../../shared-kernel/value-objects/Month.js';
+
+export const MAX_REPORT_MONTHS = 24;
+
+/** Per customer, month and currency: orders placed, invoiced net/tax, paid and outstanding (as of now). */
+export class GetMonthlyRevenueReport {
+  constructor(private readonly invoices: InvoiceRepository, private readonly orders: OrderCountSource) {}
+
+  async execute(fromMonth: string, toMonth: string): Promise<RevenueReportRow[]> {
+    const from = Month.parse(fromMonth);
+    const to = Month.parse(toMonth);
+    const span = from.monthsTo(to) + 1;
+    if (span < 1) throw new Error('The report range must not end before it starts');
+    if (span > MAX_REPORT_MONTHS) throw new Error(`The report range must not exceed ${MAX_REPORT_MONTHS} months`);
+    const start = from.start();
+    const end = to.next().start();
+
+    const rows = new Map<string, RevenueReportRow>();
+    const row = (customerId: string, month: string, currency: string): RevenueReportRow => {
+      const key = JSON.stringify([customerId, month, currency]);
+      let r = rows.get(key);
+      if (r === undefined) {
+        r = { customerId, month, currency, orders: 0, netCents: 0, taxCents: 0, paidCents: 0, outstandingCents: 0 };
+        rows.set(key, r);
+      }
+      return r;
+    };
+
+    for (const c of await this.orders.placedBetween(start, end)) row(c.customerId, c.month, c.currency).orders += c.orders;
+    for (const i of await this.invoices.issuedBetween(start, end)) {
+      const r = row(i.customerId, Month.of(i.issuedAt() as Date).toString(), i.currency);
+      r.netCents += i.net().cents;
+      r.taxCents += i.tax().cents;
+      r.paidCents += i.paid().cents;
+      r.outstandingCents += i.outstanding().cents;
+    }
+
+    return [...rows.values()].sort(
+      (a, b) => a.customerId.localeCompare(b.customerId) || a.month.localeCompare(b.month) || a.currency.localeCompare(b.currency),
+    );
+  }
+}
