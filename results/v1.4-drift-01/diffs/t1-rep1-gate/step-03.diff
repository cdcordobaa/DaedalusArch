+import type { GetMonthlyRevenueReport } from '../application/GetMonthlyRevenueReport.js';
+import type { RevenueReportRow } from '../contracts/RevenueReport.js';
+
+/** Inbound adapter for finance: GET /reports/revenue?from=YYYY-MM&to=YYYY-MM (at most 24 months). */
+export class RevenueReportController {
+  constructor(private readonly report: GetMonthlyRevenueReport) {}
+
+  async get(query: { from: string; to: string }): Promise<{ status: number; body: { rows: RevenueReportRow[] } }> {
+    return { status: 200, body: { rows: await this.report.execute(query.from, query.to) } };
+  }
+}
