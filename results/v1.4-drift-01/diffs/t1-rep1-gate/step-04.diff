+import type { ChangeTaxRate } from '../application/ChangeTaxRate.js';
+
+/** Inbound adapter for finance. */
+export class TaxRateController {
+  constructor(private readonly changeTaxRate: ChangeTaxRate) {}
+
+  async putRate(body: { country: string; rate: number }): Promise<{ status: number }> {
+    await this.changeTaxRate.execute(body.country, body.rate);
+    return { status: 204 };
+  }
+}
diff --git a/src/ordering/application/ChangeTaxRate.ts b/src/ordering/application/ChangeTaxRate.ts
new file mode 100644
index 000000000..14a83c5e2
--- /dev/null
+++ b/src/ordering/application/ChangeTaxRate.ts
@@ -0,0 +1,12 @@
+import type { TaxRateRepository } from '../domain/tax/TaxRateRepository.js';
+
+/** Application service: finance changes a country's rate; it applies to orders placed afterwards. */
+export class ChangeTaxRate {
+  constructor(private readonly rates: TaxRateRepository) {}
+
+  async execute(country: string, rate: number): Promise<void> {
+    if (!/^[A-Z]{2}$/.test(country)) throw new Error('Unknown country');
+    if (!Number.isFinite(rate) || rate < 0) throw new Error('A tax rate cannot be negative');
+    await this.rates.setRate(country, rate);
+  }
+}
