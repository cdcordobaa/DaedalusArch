+import { OrderId } from '../domain/order/value-objects/OrderId.js';
+
+/** Application service behind the published OrderInvoicingCommand contract. */
+export class MarkOrderInvoiced implements OrderInvoicingCommand {
+  constructor(private readonly orders: OrderRepository) {}
+
+  async markInvoiced(orderId: string): Promise<void> {
+    const order = await this.orders.byId(new OrderId(orderId));
+    if (order === null) throw new Error('Unknown order');
+    order.markInvoiced();
+    await this.orders.save(order);
+  }
+}
