--- /dev/null
+++ b/src/ordering/domain/order/LineDiscount.ts
@@ -0,0 +1,32 @@
+import { Money } from '../../../shared-kernel/value-objects/Money.js';
+
+export const MAX_DISCOUNT_PERCENT = 30;
+
+export type DiscountKind = { readonly type: 'percent'; readonly percent: number } | { readonly type: 'amount'; readonly amount: Money };
+
+/** Value object: a discount on one order line, either a percentage (capped) or a fixed amount, always with a reason. */
+export class LineDiscount {
+  private constructor(readonly kind: DiscountKind, readonly reason: string) {}
+
+  static percent(percent: number, reason: string): LineDiscount {
+    if (!Number.isFinite(percent) || percent <= 0) throw new Error('A discount percentage must be positive');
+    if (percent > MAX_DISCOUNT_PERCENT) throw new Error(`A discount cannot exceed ${MAX_DISCOUNT_PERCENT}%`);
+    return new LineDiscount({ type: 'percent', percent }, LineDiscount.checkedReason(reason));
+  }
+
+  static amount(amount: Money, reason: string): LineDiscount {
+    if (amount.cents <= 0) throw new Error('A discount amount must be positive');
+    return new LineDiscount({ type: 'amount', amount }, LineDiscount.checkedReason(reason));
+  }
+
+  private static checkedReason(reason: string): string {
+    const trimmed = typeof reason === 'string' ? reason.trim() : '';
+    if (trimmed === '') throw new Error('A discount needs a reason');
+    return trimmed;
+  }
+
+  /** What this discount takes off the given line subtotal. */
+  amountOff(subtotal: Money): Money {
+    return this.kind.type === 'percent' ? subtotal.times(this.kind.percent / 100) : this.kind.amount;
+  }
+}
