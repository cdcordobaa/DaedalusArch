diff --git a/src/ordering/infrastructure/InMemoryTaxRates.ts b/src/ordering/infrastructure/InMemoryTaxRates.ts
new file mode 100644
index 000000000..587de5cef
--- /dev/null
+++ b/src/ordering/infrastructure/InMemoryTaxRates.ts
@@ -0,0 +1,13 @@
+import type { TaxRates } from '../domain/tax/TaxRates.js';
+
+export class InMemoryTaxRates implements TaxRates {
+  private readonly rates = new Map<string, number>([['GB', 0.2], ['DE', 0.19], ['ES', 0.21]]);
+
+  async rateFor(country: string): Promise<number> {
+    return this.rates.get(country) ?? 0;
+  }
+
+  async setRate(country: string, rate: number): Promise<void> {
+    this.rates.set(country, rate);
+  }
+}
