diff --git a/src/ordering/application/SetTaxRate.ts b/src/ordering/application/SetTaxRate.ts
new file mode 100644
index 000000000..987430987
--- /dev/null
+++ b/src/ordering/application/SetTaxRate.ts
@@ -0,0 +1,12 @@
+import type { TaxRates } from '../domain/tax/TaxRates.js';
+
+/** Application service: finance changes a country's tax rate; it applies to orders placed afterwards. */
+export class SetTaxRate {
+  constructor(private readonly rates: TaxRates) {}
+
+  async execute(country: string, rate: number): Promise<void> {
+    if (!/^[A-Z]{2}$/.test(country)) throw new Error('Country must be an ISO 3166 alpha-2 code');
+    if (!Number.isFinite(rate) || rate < 0 || rate >= 1) throw new Error('A tax rate must be a fraction from 0 up to (not including) 1');
+    await this.rates.setRate(country, rate);
+  }
+}
