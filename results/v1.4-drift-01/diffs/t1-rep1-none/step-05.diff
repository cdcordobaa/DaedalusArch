--- /dev/null
+++ b/src/ordering/domain/order/LineDiscount.ts
@@ -0,0 +1,36 @@
+import { Money } from '../../../shared-kernel/value-objects/Money.js';
+
+export const MAX_DISCOUNT_PERCENT = 30;
+
+/** Value object: a percentage (up to 30%) or a fixed amount off one order line, always with a reason. */
+export class LineDiscount {
+  private constructor(
+    readonly percent: number | null,
+    readonly fixed: Money | null,
+    readonly reason: string,
+  ) {}
+
+  static percentage(percent: number, reason: string): LineDiscount {
+    if (!Number.isFinite(percent) || percent <= 0 || percent > MAX_DISCOUNT_PERCENT) {
+      throw new Error(`A percentage discount must be above 0 and at most ${MAX_DISCOUNT_PERCENT}%`);
+    }
+    return new LineDiscount(percent, null, LineDiscount.checkedReason(reason));
+  }
+
+  static fixedAmount(amount: Money, reason: string): LineDiscount {
+    if (amount.cents <= 0) throw new Error('A fixed discount must be positive');
+    return new LineDiscount(null, amount, LineDiscount.checkedReason(reason));
+  }
+
+  /** What comes off a line worth the given subtotal. */
+  amountOff(subtotal: Money): Money {
+    if (this.fixed !== null) return this.fixed;
+    return subtotal.times((this.percent ?? 0) / 100);
+  }
+
+  private static checkedReason(reason: string): string {
+    const trimmed = typeof reason === 'string' ? reason.trim() : '';
+    if (trimmed === '') throw new Error('A discount needs a reason');
+    return trimmed;
+  }
+}
