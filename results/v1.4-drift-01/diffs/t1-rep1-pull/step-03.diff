index 000000000..bff8b7df3
--- /dev/null
+++ b/src/ordering/application/GetOrderActivity.ts
@@ -0,0 +1,19 @@
+import type { OrderActivityQuery, OrderCount } from '../contracts/OrderActivity.js';
+import type { OrderRepository } from '../domain/order/OrderRepository.js';
+
+/** Query service behind the published OrderActivityQuery contract. */
+export class GetOrderActivity implements OrderActivityQuery {
+  constructor(private readonly orders: OrderRepository) {}
+
+  async placedBetween(from: Date, to: Date): Promise<OrderCount[]> {
+    const counts = new Map<string, { customerId: string; month: string; currency: string; count: number }>();
+    for (const order of await this.orders.placedBetween(from, to)) {
+      const month = (order.placedOn() as Date).toISOString().slice(0, 7);
+      const key = `${order.customerId.value}|${month}|${order.currency}`;
+      const row = counts.get(key) ?? { customerId: order.customerId.value, month, currency: order.currency, count: 0 };
+      row.count += 1;
+      counts.set(key, row);
+    }
+    return [...counts.values()];
+  }
+}
