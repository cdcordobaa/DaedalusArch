+import type { GetMonthlyRevenueReport } from '../application/GetMonthlyRevenueReport.js';
+import type { RevenueReportRow } from '../contracts/RevenueReport.js';
+
+/** Inbound adapter: GET /reports/revenue?from=YYYY-MM&to=YYYY-MM (at most 24 months). */
+export class RevenueReportController {
+  constructor(private readonly report: GetMonthlyRevenueReport) {}
+
+  async get(query: { from: string; to: string }): Promise<{ status: number; body: RevenueReportRow[] }> {
+    return { status: 200, body: await this.report.execute(query.from, query.to) };
+  }
+}
diff --git a/src/billing/application/GetMonthlyRevenueReport.ts b/src/billing/application/GetMonthlyRevenueReport.ts
