+import type { OrderActivityQuery } from '../../ordering/index.js';
+import type { OrderActivitySource, OrdersPlaced } from '../application/ports/OrderActivity.js';
+
+/** Anti-corruption layer: translates ordering's order counts into billing's model. */
+export class OrderActivityAcl implements OrderActivitySource {
+  constructor(private readonly ordering: OrderActivityQuery) {}
+
+  async placedBetween(from: Date, to: Date): Promise<OrdersPlaced[]> {
+    const counts = await this.ordering.placedBetween(from, to);
+    return counts.map((c) => ({ customerId: c.customerId, month: c.month, currency: c.currency, count: c.count }));
+  }
+}
