index 000000000..d0f4c9370
--- /dev/null
+++ b/src/billing/application/GetMonthlyRevenueReport.ts
@@ -0,0 +1,52 @@
+import type { RevenueReportRow } from '../contracts/RevenueReport.js';
+import type { InvoiceRepository } from '../domain/invoice/InvoiceRepository.js';
+import type { OrderActivitySource } from './ports/OrderActivity.js';
+
+export const MAX_REPORT_MONTHS = 24;
+
+type MutableRow = { -readonly [K in keyof RevenueReportRow]: RevenueReportRow[K] };
+
+/** Read-only query: invoices are attributed to the month they were issued, orders to the month they were placed. */
+export class GetMonthlyRevenueReport {
+  constructor(private readonly invoices: InvoiceRepository, private readonly orders: OrderActivitySource) {}
+
+  /** fromMonth and toMonth are inclusive, as YYYY-MM. */
+  async execute(fromMonth: string, toMonth: string): Promise<RevenueReportRow[]> {
+    const from = parseMonth(fromMonth);
+    const last = parseMonth(toMonth);
+    const months = (last.getUTCFullYear() - from.getUTCFullYear()) * 12 + last.getUTCMonth() - from.getUTCMonth() + 1;
+    if (months < 1) throw new Error('The report range must not end before it starts');
+    if (months > MAX_REPORT_MONTHS) throw new Error(`The report range is limited to ${MAX_REPORT_MONTHS} months`);
+    const to = new Date(Date.UTC(last.getUTCFullYear(), last.getUTCMonth() + 1, 1));
+
+    const rows = new Map<string, MutableRow>();
+    const rowFor = (customerId: string, month: string, currency: string): MutableRow => {
+      const key = `${customerId}|${month}|${currency}`;
+      let row = rows.get(key);
+      if (!row) {
+        row = { customerId, month, currency, ordersPlaced: 0, netCents: 0, taxCents: 0, paidCents: 0, outstandingCents: 0 };
+        rows.set(key, row);
+      }
+      return row;
+    };
+
+    for (const o of await this.orders.placedBetween(from, to)) rowFor(o.customerId, o.month, o.currency).ordersPlaced += o.count;
+    for (const inv of await this.invoices.issuedBetween(from, to)) {
+      const month = (inv.issuedOn() as Date).toISOString().slice(0, 7);
+      const row = rowFor(inv.customerId, month, inv.currency);
+      row.netCents += inv.net().cents;
+      row.taxCents += inv.tax().cents;
+      row.paidCents += inv.paid().cents;
+      row.outstandingCents += inv.outstanding().cents;
+    }
+    return [...rows.values()].sort(
+      (a, b) => a.customerId.localeCompare(b.customerId) || a.month.localeCompare(b.month) || a.currency.localeCompare(b.currency),
+    );
+  }
+}
+
+function parseMonth(value: string): Date {
+  const m = /^(\d{4})-(0[1-9]|1[0-2])$/.exec(value);
+  if (!m) throw new Error(`Invalid month "${value}", expected YYYY-MM`);
+  return new Date(Date.UTC(Number(m[1]), Number(m[2]) - 1, 1));
+}
