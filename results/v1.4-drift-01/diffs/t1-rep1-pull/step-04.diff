--- /dev/null
+++ b/src/ordering/application/RegisterCustomer.ts
@@ -0,0 +1,14 @@
+import { Customer } from '../domain/customer/Customer.js';
+import type { CustomerRepository } from '../domain/customer/CustomerRepository.js';
+import { CustomerId } from '../domain/customer/value-objects/CustomerId.js';
+
+/** Application service: registers a new customer, who must have a country. */
+export class RegisterCustomer {
+  constructor(private readonly customers: CustomerRepository) {}
+
+  async execute(customerId: string, name: string, country: string): Promise<void> {
+    const id = new CustomerId(customerId);
+    if ((await this.customers.byId(id)) !== null) throw new Error('Customer already exists');
+    await this.customers.save(new Customer(id, name, country));
+  }
+}
