diff --git a/src/ordering/infrastructure/InMemoryTaxRateRepository.ts b/src/ordering/infrastructure/InMemoryTaxRateRepository.ts
new file mode 100644
index 000000000..b6bde6c91
--- /dev/null
+++ b/src/ordering/infrastructure/InMemoryTaxRateRepository.ts
@@ -0,0 +1,14 @@
+import type { TaxRate } from '../domain/tax/TaxRate.js';
+import type { TaxRateRepository } from '../domain/tax/TaxRateRepository.js';
+
+export class InMemoryTaxRateRepository implements TaxRateRepository {
+  private readonly rows = new Map<string, TaxRate>();
+
+  async byCountry(country: string): Promise<TaxRate | null> {
+    return this.rows.get(country) ?? null;
+  }
+
+  async save(rate: TaxRate): Promise<void> {
+    this.rows.set(rate.country, rate);
+  }
+}
