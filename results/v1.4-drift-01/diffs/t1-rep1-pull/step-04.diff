diff --git a/src/ordering/domain/tax/TaxRate.ts b/src/ordering/domain/tax/TaxRate.ts
new file mode 100644
index 000000000..77200338d
--- /dev/null
+++ b/src/ordering/domain/tax/TaxRate.ts
@@ -0,0 +1,14 @@
+const DEFAULT_RATES: Readonly<Record<string, number>> = { GB: 0.2, DE: 0.19, ES: 0.21 };
+
+/** Aggregate root: finance's tax rate for one country, as a fraction (0.2 = 20%). */
+export class TaxRate {
+  constructor(readonly country: string, readonly rate: number) {
+    if (!/^[A-Z]{2}$/.test(country)) throw new Error(`Invalid country "${country}", expected a two-letter ISO code`);
+    if (!Number.isFinite(rate) || rate < 0) throw new Error('A tax rate cannot be negative');
+  }
+}
+
+/** The rate for a country: finance's setting if there is one, else the standard rate (0 for unlisted countries). */
+export function rateFor(country: string, set: TaxRate | null): number {
+  return set !== null ? set.rate : (DEFAULT_RATES[country] ?? 0);
+}
