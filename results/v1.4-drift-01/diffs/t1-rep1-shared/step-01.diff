@@ -13,4 +18,19 @@ export class Customer {
   deactivate(): void {
     this.active = false;
   }
+
+  /** Finance sets a limit for this customer; null returns to the default. */
+  setCreditLimit(limit: Money | null): void {
+    if (limit !== null && limit.cents < 0) throw new Error('A credit limit cannot be negative');
+    this.creditLimit = limit;
+  }
+
+  /** Refuses an order that would take unpaid invoices plus the new order over the limit. */
+  assertWithinCredit(unpaid: Money, orderTotal: Money): void {
+    const limit = this.creditLimit ?? Money.of(DEFAULT_CREDIT_LIMIT_CENTS, orderTotal.currency);
+    const exposure = unpaid.add(orderTotal);
+    if (exposure.isGreaterThan(limit)) {
+      throw new Error(`Credit limit exceeded by ${exposure.subtract(limit).format()} (limit ${limit.format()})`);
+    }
+  }
 }
