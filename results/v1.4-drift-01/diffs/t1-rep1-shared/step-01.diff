@@ -0,0 +1,12 @@
+import type { CustomerExposureQuery } from '../contracts/CustomerExposure.js';
+import type { InvoiceRepository } from '../domain/invoice/InvoiceRepository.js';
+
+/** Query service behind the published CustomerExposureQuery contract. */
+export class GetCustomerExposure implements CustomerExposureQuery {
+  constructor(private readonly invoices: InvoiceRepository) {}
+
+  async unpaidCents(customerId: string, currency: string): Promise<number> {
+    const invoices = await this.invoices.issuedFor(customerId);
+    return invoices.filter((i) => i.currency === currency).reduce((sum, i) => sum + i.outstanding().cents, 0);
+  }
+}
