diff --git a/src/billing/application/RecordPayment.ts b/src/billing/application/RecordPayment.ts
new file mode 100644
index 000000000..fb20ff15f
--- /dev/null
+++ b/src/billing/application/RecordPayment.ts
@@ -0,0 +1,17 @@
+import { Money } from '../../shared-kernel/value-objects/Money.js';
+import type { InvoiceRepository } from '../domain/invoice/InvoiceRepository.js';
+import { InvoiceId } from '../domain/invoice/value-objects/InvoiceId.js';
+import type { OrderPayments } from './ports/OrderSource.js';
+
+/** Application service: loads the invoice, records the payment, tells ordering when it is settled. */
+export class RecordPayment {
+  constructor(private readonly invoices: InvoiceRepository, private readonly orders: OrderPayments) {}
+
+  async execute(invoiceId: string, amountCents: number, date: Date): Promise<void> {
+    const invoice = await this.invoices.byId(new InvoiceId(invoiceId));
+    if (invoice === null) throw new Error('Unknown invoice');
+    invoice.recordPayment(Money.of(amountCents, invoice.currency), date);
+    await this.invoices.save(invoice);
+    if (invoice.isPaid()) await this.orders.markPaid(invoice.orderId);
+  }
+}
