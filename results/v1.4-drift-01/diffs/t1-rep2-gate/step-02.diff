+/** Raised when a request line breaks an order rule; the message names the offending line. */
+export class InvalidOrderLine extends Error {
+  constructor(readonly lineNo: number, reason: string) {
+    super(`Order line ${lineNo}: ${reason}`);
+    this.name = 'InvalidOrderLine';
+  }
+}
