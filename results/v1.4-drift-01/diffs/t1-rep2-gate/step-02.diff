+++ b/src/ordering/acl/BillingEvents.ts
@@ -0,0 +1,10 @@
+import type { InvoicePaid } from '../../billing/index.js';
+import type { EventBus } from '../../shared-kernel/EventBus.js';
+import type { OrderPaidCommand } from '../contracts/OrderSummary.js';
+
+/** Anti-corruption layer: ordering reacts to billing's published events and changes only its own aggregate. */
+export function subscribeToBilling(bus: EventBus, markOrderPaid: OrderPaidCommand): void {
+  bus.subscribe('billing.invoice-paid', async (e) => {
+    await markOrderPaid.markPaid((e as InvoicePaid).orderId);
+  });
+}
