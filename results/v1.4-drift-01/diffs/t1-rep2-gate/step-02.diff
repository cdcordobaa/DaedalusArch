diff --git a/src/shared-kernel/EventBus.ts b/src/shared-kernel/EventBus.ts
new file mode 100644
index 000000000..da8b741bf
--- /dev/null
+++ b/src/shared-kernel/EventBus.ts
@@ -0,0 +1,20 @@
+import type { DomainEvent } from './DomainEvent.js';
+
+export interface EventPublisher {
+  publish(events: readonly DomainEvent[]): Promise<void>;
+}
+
+type Handler = (event: DomainEvent) => Promise<void>;
+
+/** In-process bus: handlers run one after another, in subscription order, and failures reach the publisher. */
+export class EventBus implements EventPublisher {
+  private readonly handlers = new Map<string, Handler[]>();
+
+  subscribe(eventName: string, handler: Handler): void {
+    this.handlers.set(eventName, [...(this.handlers.get(eventName) ?? []), handler]);
+  }
+
+  async publish(events: readonly DomainEvent[]): Promise<void> {
+    for (const e of events) for (const h of this.handlers.get(e.name) ?? []) await h(e);
+  }
+}
