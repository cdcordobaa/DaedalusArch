@@ -0,0 +1,25 @@
+import type { OrderCountQuery, OrderCountRow } from '../contracts/OrderCount.js';
+import type { OrderRepository } from '../domain/order/OrderRepository.js';
+import { monthKey } from '../../shared-kernel/Month.js';
+
+type MutableRow = { -readonly [K in keyof OrderCountRow]: OrderCountRow[K] };
+
+/** Query service behind the published OrderCountQuery contract. Orders count in the month they were placed. */
+export class GetOrderCounts implements OrderCountQuery {
+  constructor(private readonly orders: OrderRepository) {}
+
+  async ordersPlaced(fromMonth: string, toMonth: string): Promise<OrderCountRow[]> {
+    const rows = new Map<string, MutableRow>();
+    for (const o of await this.orders.all()) {
+      const at = o.placedAt();
+      if (at === null) continue;
+      const month = monthKey(at);
+      if (month < fromMonth || month > toMonth) continue;
+      const key = JSON.stringify([o.customerId.value, month, o.currency]);
+      const row = rows.get(key);
+      if (row === undefined) rows.set(key, { customerId: o.customerId.value, month, currency: o.currency, orders: 1 });
+      else row.orders += 1;
+    }
+    return [...rows.values()];
+  }
+}
