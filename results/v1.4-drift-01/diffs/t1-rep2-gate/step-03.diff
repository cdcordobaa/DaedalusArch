diff --git a/src/reporting/MonthlyRevenueReport.ts b/src/reporting/MonthlyRevenueReport.ts
new file mode 100644
index 000000000..0feb14e72
--- /dev/null
+++ b/src/reporting/MonthlyRevenueReport.ts
@@ -0,0 +1,57 @@
+import type { OrderCountQuery } from '../ordering/index.js';
+import type { RevenueQuery } from '../billing/index.js';
+import { monthFromIndex, monthIndex } from '../shared-kernel/Month.js';
+
+export const MAX_REPORT_MONTHS = 24;
+
+export interface MonthlyRevenueLine {
+  readonly customerId: string;
+  readonly month: string;
+  readonly currency: string;
+  readonly ordersPlaced: number;
+  readonly netCents: number;
+  readonly taxCents: number;
+  readonly paidCents: number;
+  readonly outstandingCents: number;
+}
+
+type MutableLine = { -readonly [K in keyof MonthlyRevenueLine]: MonthlyRevenueLine[K] };
+
+export class InvalidReportRange extends Error {}
+
+/** Joins ordering's order counts with billing's invoiced/paid amounts through their published contracts. */
+export class MonthlyRevenueReport {
+  constructor(private readonly orders: OrderCountQuery, private readonly billing: RevenueQuery) {}
+
+  async execute(fromMonth: string, toMonth: string): Promise<MonthlyRevenueLine[]> {
+    const from = monthIndex(fromMonth);
+    const to = monthIndex(toMonth);
+    if (from === null || to === null) throw new InvalidReportRange('Months must be formatted YYYY-MM');
+    if (to < from) throw new InvalidReportRange('"to" must not be before "from"');
+    if (to - from + 1 > MAX_REPORT_MONTHS) throw new InvalidReportRange(`The range is limited to ${MAX_REPORT_MONTHS} months`);
+    const first = monthFromIndex(from);
+    const last = monthFromIndex(to);
+
+    const lines = new Map<string, MutableLine>();
+    const lineFor = (customerId: string, month: string, currency: string): MutableLine => {
+      const key = JSON.stringify([customerId, month, currency]);
+      let l = lines.get(key);
+      if (l === undefined) {
+        l = { customerId, month, currency, ordersPlaced: 0, netCents: 0, taxCents: 0, paidCents: 0, outstandingCents: 0 };
+        lines.set(key, l);
+      }
+      return l;
+    };
+    for (const r of await this.orders.ordersPlaced(first, last)) lineFor(r.customerId, r.month, r.currency).ordersPlaced += r.orders;
+    for (const r of await this.billing.revenue(first, last)) {
+      const l = lineFor(r.customerId, r.month, r.currency);
+      l.netCents += r.netCents;
+      l.taxCents += r.taxCents;
+      l.paidCents += r.paidCents;
+      l.outstandingCents += r.outstandingCents;
+    }
+    return [...lines.values()].sort(
+      (a, b) => a.customerId.localeCompare(b.customerId) || a.month.localeCompare(b.month) || a.currency.localeCompare(b.currency),
+    );
+  }
+}
diff --git a/src/reporting/ReportController.ts b/src/reporting/ReportController.ts
new file mode 100644
index 000000000..ef208e27c
--- /dev/null
+++ b/src/reporting/ReportController.ts
@@ -0,0 +1,16 @@
+import { InvalidReportRange } from './MonthlyRevenueReport.js';
+import type { MonthlyRevenueLine, MonthlyRevenueReport } from './MonthlyRevenueReport.js';
+
+/** Inbound adapter: GET /reports/monthly-revenue?from=YYYY-MM&to=YYYY-MM (at most 24 months, inclusive). */
+export class ReportController {
+  constructor(private readonly report: MonthlyRevenueReport) {}
+
+  async getMonthlyRevenue(query: { from: string; to: string }): Promise<{ status: number; body?: MonthlyRevenueLine[]; message?: string }> {
+    try {
+      return { status: 200, body: await this.report.execute(query.from, query.to) };
+    } catch (e) {
+      if (e instanceof InvalidReportRange) return { status: 400, message: e.message };
+      throw e;
+    }
+  }
+}
diff --git a/src/shared-kernel/Month.ts b/src/shared-kernel/Month.ts
new file mode 100644
index 000000000..54e846db3
--- /dev/null
+++ b/src/shared-kernel/Month.ts
@@ -0,0 +1,14 @@
+/** A calendar month in UTC, written "YYYY-MM". */
+export function monthKey(d: Date): string {
+  return `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}`;
+}
+
+/** Index of a "YYYY-MM" month on a continuous scale, or null when malformed. */
+export function monthIndex(key: string): number | null {
+  const m = /^(\d{4})-(0[1-9]|1[0-2])$/.exec(key);
+  return m === null ? null : Number(m[1]) * 12 + Number(m[2]) - 1;
+}
+
+export function monthFromIndex(i: number): string {
+  return `${String(Math.floor(i / 12)).padStart(4, '0')}-${String((i % 12) + 1).padStart(2, '0')}`;
+}
