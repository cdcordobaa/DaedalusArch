@@ -0,0 +1,31 @@
+import type { RevenueQuery, RevenueRow } from '../contracts/Revenue.js';
+import type { InvoiceRepository } from '../domain/invoice/InvoiceRepository.js';
+import { monthKey } from '../../shared-kernel/Month.js';
+
+type MutableRow = { -readonly [K in keyof RevenueRow]: RevenueRow[K] };
+
+/** Query service behind the published RevenueQuery contract. Invoices count in the month they were issued. */
+export class GetRevenue implements RevenueQuery {
+  constructor(private readonly invoices: InvoiceRepository) {}
+
+  async revenue(fromMonth: string, toMonth: string): Promise<RevenueRow[]> {
+    const rows = new Map<string, MutableRow>();
+    for (const i of await this.invoices.all()) {
+      const at = i.issuedAt();
+      if (!i.isIssued() || at === null) continue;
+      const month = monthKey(at);
+      if (month < fromMonth || month > toMonth) continue;
+      const key = JSON.stringify([i.customerId, month, i.currency]);
+      let row = rows.get(key);
+      if (row === undefined) {
+        row = { customerId: i.customerId, month, currency: i.currency, netCents: 0, taxCents: 0, paidCents: 0, outstandingCents: 0 };
+        rows.set(key, row);
+      }
+      row.netCents += i.net().cents;
+      row.taxCents += i.total().cents - i.net().cents;
+      row.paidCents += i.paid().cents;
+      row.outstandingCents += i.outstanding().cents;
+    }
+    return [...rows.values()];
+  }
+}
