diff --git a/src/shared-kernel/TaxRates.ts b/src/shared-kernel/TaxRates.ts
new file mode 100644
index 000000000..89e633e1a
--- /dev/null
+++ b/src/shared-kernel/TaxRates.ts
@@ -0,0 +1,13 @@
+/** Country-dependent tax rates (fractions, e.g. 0.2 = 20%). Finance may change a rate; unlisted countries are untaxed. */
+export class TaxRates {
+  private readonly rates = new Map<string, number>([['GB', 0.2], ['DE', 0.19], ['ES', 0.21]]);
+
+  rateFor(country: string): number {
+    return this.rates.get(country.toUpperCase()) ?? 0;
+  }
+
+  setRate(country: string, rate: number): void {
+    if (!Number.isFinite(rate) || rate < 0) throw new Error('Tax rate cannot be negative');
+    this.rates.set(country.toUpperCase(), rate);
+  }
+}
