+
+/** Finance changes a country's tax rate; it applies to orders placed afterwards. */
+export class SetTaxRate {
+  constructor(private readonly rates: TaxRates) {}
+
+  execute(country: string, rate: number): void {
+    this.rates.setRate(country, rate);
+  }
+}
