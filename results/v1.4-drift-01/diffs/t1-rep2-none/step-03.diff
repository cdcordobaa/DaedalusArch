+import type { OrdersPlacedQuery } from '../../ordering/index.js';
+import type { OrderCount, OrderCounts } from '../application/ports/OrderCounts.js';
+
+/** Anti-corruption layer: translates ordering's published order counts into billing's model. */
+export class OrderCountsAcl implements OrderCounts {
+  constructor(private readonly ordering: OrdersPlacedQuery) {}
+
+  async placedBetween(fromMonth: string, toMonth: string): Promise<OrderCount[]> {
+    const rows = await this.ordering.placedBetween(fromMonth, toMonth);
+    return rows.map((r) => ({ customerId: r.customerId, month: r.month, currency: r.currency, count: r.count }));
+  }
+}
