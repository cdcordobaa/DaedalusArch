index 000000000..94d226587
--- /dev/null
+++ b/src/ordering/application/GetOrdersPlaced.ts
@@ -0,0 +1,22 @@
+import type { OrdersPlacedCount, OrdersPlacedQuery } from '../contracts/OrdersPlaced.js';
+import type { OrderRepository } from '../domain/order/OrderRepository.js';
+
+/** Query service behind the published OrdersPlacedQuery contract. */
+export class GetOrdersPlaced implements OrdersPlacedQuery {
+  constructor(private readonly orders: OrderRepository) {}
+
+  async placedBetween(fromMonth: string, toMonth: string): Promise<OrdersPlacedCount[]> {
+    const counts = new Map<string, OrdersPlacedCount>();
+    for (const order of await this.orders.all()) {
+      const at = order.placedAt();
+      if (at === null) continue;
+      const month = at.toISOString().slice(0, 7);
+      if (month < fromMonth || month > toMonth) continue;
+      const customerId = order.customerId.value;
+      const key = `${customerId}|${month}|${order.currency}`;
+      const prev = counts.get(key);
+      counts.set(key, { customerId, month, currency: order.currency, count: (prev?.count ?? 0) + 1 });
+    }
+    return [...counts.values()];
+  }
+}
