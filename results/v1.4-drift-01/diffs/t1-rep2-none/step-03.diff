@@ -0,0 +1,15 @@
+import type { MonthlyRevenueReportQuery, MonthlyRevenueRow } from '../contracts/MonthlyRevenue.js';
+
+export class RevenueReportController {
+  constructor(private readonly query: MonthlyRevenueReportQuery) {}
+
+  /** GET /reports/monthly-revenue?from=YYYY-MM&to=YYYY-MM */
+  async get(params: { from?: string; to?: string }): Promise<{ status: number; body: MonthlyRevenueRow[] | { error: string } }> {
+    if (!params.from || !params.to) return { status: 400, body: { error: 'from and to (YYYY-MM) are required' } };
+    try {
+      return { status: 200, body: await this.query.report(params.from, params.to) };
+    } catch (e) {
+      return { status: 400, body: { error: e instanceof Error ? e.message : String(e) } };
+    }
+  }
+}
diff --git a/src/billing/application/GetMonthlyRevenueReport.ts b/src/billing/application/GetMonthlyRevenueReport.ts
new file mode 100644
index 000000000..f98917efa
--- /dev/null
+++ b/src/billing/application/GetMonthlyRevenueReport.ts
@@ -0,0 +1,53 @@
+import type { MonthlyRevenueReportQuery, MonthlyRevenueRow } from '../contracts/MonthlyRevenue.js';
+import type { InvoiceRepository } from '../domain/invoice/InvoiceRepository.js';
+import type { OrderCounts } from './ports/OrderCounts.js';
+
+const MAX_MONTHS = 24;
+const MONTH = /^(\d{4})-(0[1-9]|1[0-2])$/;
+
+function monthIndex(month: string): number {
+  const m = MONTH.exec(month);
+  if (m === null) throw new Error(`Invalid month "${month}", expected YYYY-MM`);
+  return Number(m[1]) * 12 + Number(m[2]) - 1;
+}
+
+type Acc = { -readonly [K in keyof MonthlyRevenueRow]: MonthlyRevenueRow[K] };
+
+/** Query service: monthly revenue per customer and currency. Orders count in the month placed; invoiced, paid and outstanding follow the month the invoice was issued. */
+export class GetMonthlyRevenueReport implements MonthlyRevenueReportQuery {
+  constructor(private readonly invoices: InvoiceRepository, private readonly orderCounts: OrderCounts) {}
+
+  async report(fromMonth: string, toMonth: string): Promise<MonthlyRevenueRow[]> {
+    const span = monthIndex(toMonth) - monthIndex(fromMonth) + 1;
+    if (span < 1) throw new Error('The report range must not end before it starts');
+    if (span > MAX_MONTHS) throw new Error(`The report range is limited to ${MAX_MONTHS} months`);
+
+    const rows = new Map<string, Acc>();
+    const rowFor = (customerId: string, month: string, currency: string): Acc => {
+      const key = `${month}|${customerId}|${currency}`;
+      let row = rows.get(key);
+      if (row === undefined) {
+        row = { customerId, month, currency, ordersPlaced: 0, netCents: 0, taxCents: 0, paidCents: 0, outstandingCents: 0 };
+        rows.set(key, row);
+      }
+      return row;
+    };
+
+    for (const c of await this.orderCounts.placedBetween(fromMonth, toMonth)) {
+      rowFor(c.customerId, c.month, c.currency).ordersPlaced += c.count;
+    }
+    for (const invoice of await this.invoices.all()) {
+      const at = invoice.issuedAt();
+      if (!invoice.isIssued() || at === null) continue;
+      const month = at.toISOString().slice(0, 7);
+      if (month < fromMonth || month > toMonth) continue;
+      const row = rowFor(invoice.customerId, month, invoice.currency);
+      row.netCents += invoice.net().cents;
+      row.taxCents += invoice.tax().cents;
+      row.paidCents += invoice.paid().cents;
+      row.outstandingCents += invoice.outstanding().cents;
+    }
+    return [...rows.values()].sort((a, b) =>
+      a.month.localeCompare(b.month) || a.customerId.localeCompare(b.customerId) || a.currency.localeCompare(b.currency));
+  }
+}
