+++ b/src/billing/contracts/MonthlyRevenue.ts
@@ -0,0 +1,21 @@
+/** One customer, one calendar month (UTC), one currency. Amounts are in minor units. */
+export interface MonthlyRevenueRow {
+  readonly customerId: string;
+  /** Calendar month as YYYY-MM. */
+  readonly month: string;
+  readonly currency: string;
+  /** Orders placed in the month. */
+  readonly ordersPlaced: number;
+  /** Invoices issued in the month. */
+  readonly netCents: number;
+  readonly taxCents: number;
+  /** Paid so far against the invoices issued in the month. */
+  readonly paidCents: number;
+  /** Still owed on the invoices issued in the month; invoiced (net + tax) = paid + outstanding. */
+  readonly outstandingCents: number;
+}
+
+export interface MonthlyRevenueReportQuery {
+  /** Both bounds are YYYY-MM and inclusive; at most 24 months. */
+  report(fromMonth: string, toMonth: string): Promise<MonthlyRevenueRow[]>;
+}
