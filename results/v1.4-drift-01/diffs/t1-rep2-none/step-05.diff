@@ -0,0 +1,26 @@
+import type { OrderRepository } from '../domain/order/OrderRepository.js';
+import { OrderId } from '../domain/order/value-objects/OrderId.js';
+import { LineDiscount } from '../domain/order/LineDiscount.js';
+
+export interface DiscountOrderLineCommand {
+  readonly orderId: string;
+  readonly lineNo: number;
+  readonly reason: string;
+  /** Exactly one of the two. */
+  readonly percent?: number;
+  readonly amountCents?: number;
+}
+
+/** Support gives a discount on a single order line. */
+export class DiscountOrderLine {
+  constructor(private readonly orders: OrderRepository) {}
+
+  async execute(cmd: DiscountOrderLineCommand): Promise<void> {
+    if ((cmd.percent === undefined) === (cmd.amountCents === undefined)) throw new Error('Give either a percentage or a fixed amount');
+    const discount = cmd.percent !== undefined ? LineDiscount.percent(cmd.percent, cmd.reason) : LineDiscount.amount(cmd.amountCents as number, cmd.reason);
+    const order = await this.orders.byId(new OrderId(cmd.orderId));
+    if (order === null) throw new Error('Unknown order');
+    order.discountLine(cmd.lineNo, discount);
+    await this.orders.save(order);
+  }
+}
