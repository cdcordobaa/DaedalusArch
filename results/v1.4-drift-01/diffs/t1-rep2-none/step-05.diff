--- /dev/null
+++ b/src/ordering/domain/order/LineDiscount.ts
@@ -0,0 +1,35 @@
+import { Money } from '../../../shared-kernel/value-objects/Money.js';
+
+export const MAX_DISCOUNT_PERCENT = 30;
+
+export type DiscountKind = { readonly type: 'percent'; readonly percent: number } | { readonly type: 'amount'; readonly cents: number };
+
+/** Value object: a reasoned reduction of one order line's subtotal. */
+export class LineDiscount {
+  private constructor(readonly kind: DiscountKind, readonly reason: string) {}
+
+  static percent(percent: number, reason: string): LineDiscount {
+    if (!Number.isFinite(percent) || percent <= 0 || percent > MAX_DISCOUNT_PERCENT) {
+      throw new Error(`A percentage discount must be above 0 and at most ${MAX_DISCOUNT_PERCENT}%`);
+    }
+    return new LineDiscount({ type: 'percent', percent }, LineDiscount.cleanReason(reason));
+  }
+
+  static amount(cents: number, reason: string): LineDiscount {
+    if (!Number.isInteger(cents) || cents <= 0) throw new Error('A fixed discount must be a positive whole amount');
+    return new LineDiscount({ type: 'amount', cents }, LineDiscount.cleanReason(reason));
+  }
+
+  private static cleanReason(reason: string): string {
+    const trimmed = typeof reason === 'string' ? reason.trim() : '';
+    if (trimmed === '') throw new Error('A discount needs a reason');
+    return trimmed;
+  }
+
+  /** The amount taken off the given subtotal. */
+  amountOff(subtotal: Money): Money {
+    const off = this.kind.type === 'percent' ? subtotal.times(this.kind.percent / 100) : Money.of(this.kind.cents, subtotal.currency);
+    if (off.isGreaterThan(subtotal)) throw new Error('A discount cannot take a line below zero');
+    return off;
+  }
+}
