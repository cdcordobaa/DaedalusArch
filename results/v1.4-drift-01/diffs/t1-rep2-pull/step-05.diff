index 000000000..6d2a5ea2e
--- /dev/null
+++ b/src/ordering/domain/order/value-objects/Discount.ts
@@ -0,0 +1,38 @@
+import { Money } from '../../../../shared-kernel/value-objects/Money.js';
+import { InvalidOrderLineError } from '../InvalidOrderLineError.js';
+
+export const MAX_DISCOUNT_PERCENT = 30;
+
+/** Value object: a percentage (up to 30) or a fixed amount off one order line, always with a reason. */
+export class Discount {
+  private constructor(
+    readonly kind: 'percent' | 'fixed',
+    readonly percent: number,
+    readonly fixed: Money | null,
+    readonly reason: string,
+  ) {}
+
+  static percentage(percent: number, reason: string): Discount {
+    if (!Number.isFinite(percent) || percent <= 0 || percent > MAX_DISCOUNT_PERCENT) {
+      throw new InvalidOrderLineError(`Discount percentage must be above 0 and at most ${MAX_DISCOUNT_PERCENT}`);
+    }
+    return new Discount('percent', percent, null, Discount.requireReason(reason));
+  }
+
+  static amount(amount: Money, reason: string): Discount {
+    if (amount.cents <= 0) throw new InvalidOrderLineError('Discount amount must be positive');
+    return new Discount('fixed', 0, amount, Discount.requireReason(reason));
+  }
+
+  private static requireReason(reason: string): string {
+    const trimmed = typeof reason === 'string' ? reason.trim() : '';
+    if (trimmed === '') throw new InvalidOrderLineError('A discount needs a reason');
+    return trimmed;
+  }
+
+  /** The amount taken off the given line subtotal. */
+  amountOff(subtotal: Money): Money {
+    if (this.fixed !== null) return this.fixed;
+    return subtotal.times(this.percent / 100);
+  }
+}
