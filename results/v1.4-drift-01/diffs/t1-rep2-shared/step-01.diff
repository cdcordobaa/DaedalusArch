   deactivate(): void {
     this.active = false;
   }
+
+  /** Finance sets a customer-specific limit, in minor units of the order currency. */
+  setCreditLimit(cents: number): void {
+    if (!Number.isInteger(cents) || cents < 0) throw new Error('Credit limit must be a non-negative whole number of minor units');
+    this.creditLimitCents = cents;
+  }
+
+  /** Refuses an order that would take unpaid invoices plus the new total over the limit. */
+  assertCanAfford(unpaid: Money, orderTotal: Money): void {
+    const limit = Money.of(this.creditLimitCents, orderTotal.currency);
+    const exposure = unpaid.add(orderTotal);
+    if (exposure.isGreaterThan(limit)) {
+      throw new Error(`Credit limit of ${limit.format()} exceeded by ${exposure.subtract(limit).format()}`);
+    }
+  }
 }
