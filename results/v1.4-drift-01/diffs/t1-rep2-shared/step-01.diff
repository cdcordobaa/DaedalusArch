+  /** Records a (possibly partial) payment; the invoice can never be paid beyond its total. */
+  recordPayment(amount: Money, paidOn: Date): void {
+    if (!this.issued) throw new Error('Only an issued invoice can be paid');
+    if (amount.currency !== this.currency) throw new Error('Currency mismatch');
+    if (amount.cents <= 0) throw new Error('A payment must be positive');
+    if (Number.isNaN(paidOn.getTime())) throw new Error('Invalid payment date');
+    if (amount.isGreaterThan(this.outstanding())) throw new Error('Payment exceeds the outstanding amount');
+    this.payments.push(new Payment(amount, paidOn));
+    if (this.isPaid()) this.events.push(new InvoicePaid(this.id.value, this.orderId));
+  }
+
+  isIssued(): boolean {
+    return this.issued;
+  }
+
+  paid(): Money {
+    return this.payments.reduce((s, p) => s.add(p.amount), Money.of(0, this.currency));
+  }
+
+  outstanding(): Money {
+    return this.total().subtract(this.paid());
+  }
+
+  isPaid(): boolean {
+    return this.issued && this.outstanding().cents === 0;
+  }
+
   pullEvents(): DomainEvent[] {
