@@ -0,0 +1,14 @@
+import type { OutstandingBalanceQuery } from '../contracts/OutstandingBalance.js';
+import type { InvoiceRepository } from '../domain/invoice/InvoiceRepository.js';
+
+/** Query service behind the published OutstandingBalanceQuery contract. Only invoices in the given currency count. */
+export class GetOutstandingBalance implements OutstandingBalanceQuery {
+  constructor(private readonly invoices: InvoiceRepository) {}
+
+  async outstandingCents(customerId: string, currency: string): Promise<number> {
+    const rows = await this.invoices.byCustomer(customerId);
+    return rows
+      .filter((i) => i.isIssued() && i.currency === currency)
+      .reduce((sum, i) => sum + i.outstanding().cents, 0);
+  }
+}
