@@ -0,0 +1,17 @@
+import { Money } from '../../shared-kernel/value-objects/Money.js';
+import type { InvoiceRepository } from '../domain/invoice/InvoiceRepository.js';
+import { InvoiceId } from '../domain/invoice/value-objects/InvoiceId.js';
+import type { OrderSource } from './ports/OrderSource.js';
+
+/** Application service: finance records a payment against an invoice. */
+export class RecordPayment {
+  constructor(private readonly invoices: InvoiceRepository, private readonly orders: OrderSource) {}
+
+  async execute(invoiceId: string, amountCents: number, paidOn: Date): Promise<void> {
+    const invoice = await this.invoices.byId(new InvoiceId(invoiceId));
+    if (invoice === null) throw new Error('Unknown invoice');
+    invoice.recordPayment(Money.of(amountCents, invoice.currency), paidOn);
+    await this.invoices.save(invoice);
+    if (invoice.isPaid()) await this.orders.markPaid(invoice.orderId);
+  }
+}
