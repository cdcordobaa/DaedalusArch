+import type { InvoicePaid } from '../../billing/index.js';
+import type { DomainEvent } from '../../shared-kernel/DomainEvent.js';
+import type { OrderPaidCommand } from '../contracts/OrderSummary.js';
+
+/** Reacts to billing's published InvoicePaid event by marking the order paid, in ordering's own transaction. */
+export class InvoicePaidSubscriber {
+  constructor(private readonly markOrderPaid: OrderPaidCommand) {}
+
+  async handle(event: DomainEvent): Promise<void> {
+    await this.markOrderPaid.markPaid((event as InvoicePaid).orderId);
+  }
+}
