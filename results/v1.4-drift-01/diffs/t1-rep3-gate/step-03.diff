+import { InvalidReportRangeError, type GetMonthlyRevenueReport } from '../application/GetMonthlyRevenueReport.js';
+import type { RevenueRow } from '../contracts/RevenueReport.js';
+
+/** Inbound adapter: GET /reports/monthly-revenue?from=YYYY-MM&to=YYYY-MM (inclusive, at most 24 months). */
+export class ReportController {
+  constructor(private readonly report: GetMonthlyRevenueReport) {}
+
+  async getMonthlyRevenue(query: { from: string; to: string }): Promise<{ status: number; rows?: RevenueRow[]; error?: string }> {
+    try {
+      return { status: 200, rows: await this.report.execute(query.from, query.to) };
+    } catch (e) {
+      if (e instanceof InvalidReportRangeError) return { status: 400, error: e.message };
+      throw e;
+    }
+  }
+}
diff --git a/src/billing/application/GetMonthlyRevenueReport.ts b/src/billing/application/GetMonthlyRevenueReport.ts
