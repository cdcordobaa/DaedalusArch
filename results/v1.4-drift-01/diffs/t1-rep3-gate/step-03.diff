@@ -0,0 +1,15 @@
+import type { OrderActivityQuery, PlacedOrder } from '../contracts/OrderActivity.js';
+import type { OrderRepository } from '../domain/order/OrderRepository.js';
+
+/** Query service behind the published OrderActivityQuery contract. */
+export class GetOrderActivity implements OrderActivityQuery {
+  constructor(private readonly orders: OrderRepository) {}
+
+  async placedBetween(from: Date, to: Date): Promise<PlacedOrder[]> {
+    const orders = await this.orders.placedBetween(from, to);
+    return orders.flatMap((o) => {
+      const placedAt = o.placedAt();
+      return placedAt === null ? [] : [{ orderId: o.id.value, customerId: o.customerId.value, currency: o.currency, placedAt }];
+    });
+  }
+}
