index 000000000..7b8729ca2
--- /dev/null
+++ b/src/billing/application/GetMonthlyRevenueReport.ts
@@ -0,0 +1,73 @@
+import type { RevenueRow } from '../contracts/RevenueReport.js';
+import type { InvoiceRepository } from '../domain/invoice/InvoiceRepository.js';
+import type { OrderActivitySource } from './ports/OrderActivitySource.js';
+
+export const MAX_REPORT_MONTHS = 24;
+
+/** Raised when the requested month range is malformed or too long. */
+export class InvalidReportRangeError extends Error {}
+
+type MutableRow = { -readonly [K in keyof RevenueRow]: RevenueRow[K] };
+
+function parseMonth(value: string): number {
+  const m = /^(\d{4})-(0[1-9]|1[0-2])$/.exec(value);
+  if (m === null) throw new InvalidReportRangeError(`Invalid month "${value}"; expected YYYY-MM`);
+  return Number(m[1]) * 12 + Number(m[2]) - 1;
+}
+
+function monthKey(d: Date): string {
+  return `${String(d.getUTCFullYear()).padStart(4, '0')}-${String(d.getUTCMonth() + 1).padStart(2, '0')}`;
+}
+
+function monthStart(index: number): Date {
+  const d = new Date(0);
+  d.setUTCFullYear(Math.floor(index / 12), index % 12, 1);
+  return d;
+}
+
+/**
+ * Monthly revenue per customer and currency. Orders are counted in the month they were placed.
+ * Invoices are attributed to their issue month; paid and outstanding are the invoice's current
+ * state, so they follow the invoice, not the payment date.
+ */
+export class GetMonthlyRevenueReport {
+  constructor(private readonly invoices: InvoiceRepository, private readonly orders: OrderActivitySource) {}
+
+  /** fromMonth and toMonth are inclusive, as YYYY-MM. */
+  async execute(fromMonth: string, toMonth: string): Promise<RevenueRow[]> {
+    const first = parseMonth(fromMonth);
+    const last = parseMonth(toMonth);
+    if (last < first) throw new InvalidReportRangeError('The end month is before the start month');
+    if (last - first + 1 > MAX_REPORT_MONTHS) throw new InvalidReportRangeError(`The range cannot exceed ${MAX_REPORT_MONTHS} months`);
+    const from = monthStart(first);
+    const to = monthStart(last + 1);
+
+    const rows = new Map<string, MutableRow>();
+    const rowFor = (customerId: string, month: string, currency: string): MutableRow => {
+      const key = JSON.stringify([customerId, month, currency]);
+      let row = rows.get(key);
+      if (row === undefined) {
+        row = { customerId, month, currency, ordersPlaced: 0, netCents: 0, taxCents: 0, paidCents: 0, outstandingCents: 0 };
+        rows.set(key, row);
+      }
+      return row;
+    };
+
+    for (const o of await this.orders.placedBetween(from, to)) {
+      rowFor(o.customerId, monthKey(o.placedAt), o.currency).ordersPlaced += 1;
+    }
+    for (const i of await this.invoices.issuedBetween(from, to)) {
+      const at = i.issuedAt();
+      if (at === null) continue;
+      const row = rowFor(i.customerId, monthKey(at), i.currency);
+      const net = i.net().cents;
+      row.netCents += net;
+      row.taxCents += i.total().cents - net;
+      row.paidCents += i.paid().cents;
+      row.outstandingCents += i.outstanding().cents;
+    }
+
+    return [...rows.values()].sort((a, b) =>
+      a.customerId.localeCompare(b.customerId) || a.month.localeCompare(b.month) || a.currency.localeCompare(b.currency));
+  }
+}
