--- /dev/null
+++ b/src/ordering/application/GetOrderPlacements.ts
@@ -0,0 +1,17 @@
+import type { OrderPlacement, OrderPlacementsQuery } from '../contracts/OrderSummary.js';
+import type { OrderRepository } from '../domain/order/OrderRepository.js';
+
+/** Query service behind the published OrderPlacementsQuery contract. */
+export class GetOrderPlacements implements OrderPlacementsQuery {
+  constructor(private readonly orders: OrderRepository) {}
+
+  async placedBetween(from: Date, to: Date): Promise<OrderPlacement[]> {
+    const result: OrderPlacement[] = [];
+    for (const order of await this.orders.all()) {
+      const placedAt = order.placedAt();
+      if (placedAt === null || placedAt < from || placedAt >= to) continue;
+      result.push({ orderId: order.id.value, customerId: order.customerId.value, currency: order.currency, placedAt });
+    }
+    return result;
+  }
+}
