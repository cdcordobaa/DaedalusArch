index 000000000..48dceb8f8
--- /dev/null
+++ b/src/billing/application/GetRevenueReport.ts
@@ -0,0 +1,76 @@
+import type { RevenueReportRow } from '../contracts/RevenueReport.js';
+import type { InvoiceRepository } from '../domain/invoice/InvoiceRepository.js';
+import type { OrderPlacementSource } from './ports/OrderPlacementSource.js';
+
+export const MAX_REPORT_MONTHS = 24;
+
+/** Parses "YYYY-MM" into a month index (year * 12 + month0). */
+function parseMonth(value: string): number {
+  const m = /^(\d{4})-(0[1-9]|1[0-2])$/.exec(value);
+  if (m === null) throw new Error(`Invalid month "${value}", expected YYYY-MM`);
+  return Number(m[1]) * 12 + (Number(m[2]) - 1);
+}
+
+function monthLabel(index: number): string {
+  const year = Math.floor(index / 12);
+  return `${String(year).padStart(4, '0')}-${String((index % 12) + 1).padStart(2, '0')}`;
+}
+
+function monthStart(index: number): Date {
+  const d = new Date(0);
+  d.setUTCFullYear(Math.floor(index / 12), index % 12, 1);
+  d.setUTCHours(0, 0, 0, 0);
+  return d;
+}
+
+function monthIndexOf(d: Date): number {
+  return d.getUTCFullYear() * 12 + d.getUTCMonth();
+}
+
+/**
+ * Monthly revenue per customer and currency, months in UTC.
+ * Orders are counted in the month they were placed. Invoiced, paid and outstanding
+ * are attributed to the month the invoice was issued: paid is everything paid so far
+ * against those invoices, outstanding is invoiced (net + tax) minus paid.
+ */
+export class GetRevenueReport {
+  constructor(private readonly invoices: InvoiceRepository, private readonly orders: OrderPlacementSource) {}
+
+  async execute(fromMonth: string, toMonth: string): Promise<RevenueReportRow[]> {
+    const first = parseMonth(fromMonth);
+    const last = parseMonth(toMonth);
+    if (last < first) throw new Error('Range end is before range start');
+    if (last - first + 1 > MAX_REPORT_MONTHS) throw new Error(`Range exceeds ${String(MAX_REPORT_MONTHS)} months`);
+    const from = monthStart(first);
+    const to = monthStart(last + 1);
+
+    const rows = new Map<string, RevenueReportRow>();
+    const rowFor = (customerId: string, month: number, currency: string): RevenueReportRow => {
+      const key = JSON.stringify([customerId, month, currency]);
+      let row = rows.get(key);
+      if (row === undefined) {
+        row = { customerId, month: monthLabel(month), currency, ordersPlaced: 0, netCents: 0, taxCents: 0, paidCents: 0, outstandingCents: 0 };
+        rows.set(key, row);
+      }
+      return row;
+    };
+
+    for (const o of await this.orders.placedBetween(from, to)) {
+      rowFor(o.customerId, monthIndexOf(o.placedAt), o.currency).ordersPlaced += 1;
+    }
+
+    for (const invoice of await this.invoices.all()) {
+      const issuedAt = invoice.issuedAt();
+      if (!invoice.isIssued() || issuedAt === null || issuedAt < from || issuedAt >= to) continue;
+      const row = rowFor(invoice.customerId, monthIndexOf(issuedAt), invoice.currency);
+      row.netCents += invoice.net().cents;
+      row.taxCents += invoice.tax().cents;
+      row.paidCents += invoice.paid().cents;
+      row.outstandingCents += invoice.outstanding().cents;
+    }
+
+    return [...rows.values()].sort(
+      (a, b) => a.customerId.localeCompare(b.customerId) || a.month.localeCompare(b.month) || a.currency.localeCompare(b.currency),
+    );
+  }
+}
