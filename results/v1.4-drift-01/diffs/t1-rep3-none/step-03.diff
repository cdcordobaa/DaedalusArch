+import type { OrderPlacementsQuery } from '../../ordering/index.js';
+import type { OrderPlacementSource, PlacedOrder } from '../application/ports/OrderPlacementSource.js';
+
+/** Anti-corruption layer: translates ordering's order placements into billing's model. */
+export class OrderPlacementAcl implements OrderPlacementSource {
+  constructor(private readonly ordering: OrderPlacementsQuery) {}
+
+  async placedBetween(from: Date, to: Date): Promise<PlacedOrder[]> {
+    const placements = await this.ordering.placedBetween(from, to);
+    return placements.map((p) => ({ customerId: p.customerId, currency: p.currency, placedAt: p.placedAt }));
+  }
+}
