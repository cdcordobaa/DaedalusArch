@@ -0,0 +1,18 @@
+import type { RevenueReportRow } from '../contracts/RevenueReport.js';
+import type { GetRevenueReport } from '../application/GetRevenueReport.js';
+
+/** Inbound adapter: GET /reports/revenue?from=YYYY-MM&to=YYYY-MM (at most 24 months). */
+export class RevenueReportController {
+  constructor(private readonly report: GetRevenueReport) {}
+
+  async get(query: { from?: string; to?: string }): Promise<{ status: number; body: RevenueReportRow[] | { error: string } }> {
+    if (query.from === undefined || query.to === undefined) {
+      return { status: 400, body: { error: 'from and to (YYYY-MM) are required' } };
+    }
+    try {
+      return { status: 200, body: await this.report.execute(query.from, query.to) };
+    } catch (e) {
+      return { status: 400, body: { error: e instanceof Error ? e.message : String(e) } };
+    }
+  }
+}
diff --git a/src/billing/application/GetRevenueReport.ts b/src/billing/application/GetRevenueReport.ts
