+import type { SetTaxRate } from '../application/SetTaxRate.js';
+
+/** Inbound adapter for finance: per-country tax rates (rate as a fraction, e.g. 0.2). */
+export class TaxRateController {
+  constructor(private readonly setTaxRate: SetTaxRate) {}
+
+  put(body: { country: string; rate: number }): { status: number } {
+    this.setTaxRate.execute(body.country, body.rate);
+    return { status: 204 };
+  }
+}
