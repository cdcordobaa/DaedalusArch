diff --git a/src/ordering/domain/tax/TaxRates.ts b/src/ordering/domain/tax/TaxRates.ts
new file mode 100644
index 000000000..39f4076bf
--- /dev/null
+++ b/src/ordering/domain/tax/TaxRates.ts
@@ -0,0 +1,23 @@
+export const DEFAULT_COUNTRY = 'GB';
+
+const INITIAL_RATES: Readonly<Record<string, number>> = { GB: 0.2, DE: 0.19, ES: 0.21 };
+
+export function normalizeCountry(country: string): string {
+  const code = country.trim().toUpperCase();
+  if (!/^[A-Z]{2}$/.test(code)) throw new Error('Country must be a two-letter ISO code');
+  return code;
+}
+
+/** Tax rate per country; 0 for any country without a rate. A change affects only later orders. */
+export class TaxRates {
+  private readonly rates = new Map<string, number>(Object.entries(INITIAL_RATES));
+
+  rateFor(country: string): number {
+    return this.rates.get(normalizeCountry(country)) ?? 0;
+  }
+
+  setRate(country: string, rate: number): void {
+    if (!Number.isFinite(rate) || rate < 0 || rate > 1) throw new Error('Tax rate must be between 0 and 1');
+    this.rates.set(normalizeCountry(country), rate);
+  }
+}
