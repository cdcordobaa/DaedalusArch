diff --git a/src/billing/domain/invoice/Invoice.ts b/src/billing/domain/invoice/Invoice.ts
index 8901f699e..3b7ad8de2 100644
--- a/src/billing/domain/invoice/Invoice.ts
+++ b/src/billing/domain/invoice/Invoice.ts
@@ -16,11 +16,13 @@ export class Invoice {
 
   charge(description: string, amount: Money): void {
     if (this.issued) throw new Error('An issued invoice cannot change');
+    if (amount.cents < 0) throw new Error('An invoice amount must not be negative');
     this.lines.push(new InvoiceLine(this.lines.length + 1, description, amount));
   }
 
   issue(taxRate: number): void {
     if (this.lines.length === 0) throw new Error('Nothing to invoice');
+    if (!(taxRate >= 0)) throw new Error('A tax rate must not be negative');
     const net = this.net();
     this.lines.push(new InvoiceLine(this.lines.length + 1, 'tax', net.times(taxRate)));
