index 000000000..a5bd1e50a
--- /dev/null
+++ b/src/billing/application/GetMonthlyRevenue.ts
@@ -0,0 +1,58 @@
+import type { MonthlyRevenueRow } from '../contracts/RevenueReport.js';
+import type { InvoiceRepository } from '../domain/invoice/InvoiceRepository.js';
+import type { OrderCountSource } from './ports/OrderCounts.js';
+
+const MAX_MONTHS = 24;
+
+type MutableRow = {
+  -readonly [K in keyof MonthlyRevenueRow]: MonthlyRevenueRow[K];
+};
+
+function parseMonth(value: string): number {
+  const m = /^(\d{4})-(0[1-9]|1[0-2])$/.exec(value);
+  if (m === null) throw new Error(`Invalid month "${value}", expected YYYY-MM`);
+  return Number(m[1]) * 12 + Number(m[2]) - 1;
+}
+
+/** Query service: invoiced and paid amounts by invoice issue month, order counts by placement month. */
+export class GetMonthlyRevenue {
+  constructor(private readonly invoices: InvoiceRepository, private readonly orders: OrderCountSource) {}
+
+  async execute(fromMonth: string, toMonth: string): Promise<MonthlyRevenueRow[]> {
+    const from = parseMonth(fromMonth);
+    const to = parseMonth(toMonth);
+    if (to < from) throw new Error('The end month must not be before the start month');
+    if (to - from + 1 > MAX_MONTHS) throw new Error(`A report covers at most ${MAX_MONTHS} months`);
+
+    const rows = new Map<string, MutableRow>();
+    const rowFor = (customerId: string, month: string, currency: string): MutableRow => {
+      const key = JSON.stringify([customerId, month, currency]);
+      let row = rows.get(key);
+      if (row === undefined) {
+        row = { customerId, month, currency, ordersPlaced: 0, netCents: 0, taxCents: 0, invoicedCents: 0, paidCents: 0, outstandingCents: 0 };
+        rows.set(key, row);
+      }
+      return row;
+    };
+
+    const start = new Date(Date.UTC(Math.floor(from / 12), from % 12, 1));
+    const end = new Date(Date.UTC(Math.floor(to / 12), (to % 12) + 1, 1));
+    for (const invoice of await this.invoices.issuedBetween(start, end)) {
+      const month = (invoice.issuedAt() as Date).toISOString().slice(0, 7);
+      const row = rowFor(invoice.customerId, month, invoice.currency);
+      const net = invoice.net().cents;
+      const total = invoice.total().cents;
+      row.netCents += net;
+      row.taxCents += total - net;
+      row.invoicedCents += total;
+      row.paidCents += invoice.paid().cents;
+      row.outstandingCents += invoice.outstanding().cents;
+    }
+    for (const c of await this.orders.ordersPlaced(fromMonth, toMonth)) {
+      rowFor(c.customerId, c.month, c.currency).ordersPlaced += c.orders;
+    }
+    return [...rows.values()].sort(
+      (a, b) => a.month.localeCompare(b.month) || a.customerId.localeCompare(b.customerId) || a.currency.localeCompare(b.currency),
+    );
+  }
+}
