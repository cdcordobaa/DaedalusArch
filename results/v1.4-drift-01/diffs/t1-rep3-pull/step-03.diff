+import type { GetMonthlyRevenue } from '../application/GetMonthlyRevenue.js';
+import type { MonthlyRevenueRow } from '../contracts/RevenueReport.js';
+
+/** Inbound adapter for finance: GET /reports/monthly-revenue?from=YYYY-MM&to=YYYY-MM */
+export class RevenueReportController {
+  constructor(private readonly report: GetMonthlyRevenue) {}
+
+  async get(query: { from: string; to: string }): Promise<{ status: number; body: MonthlyRevenueRow[] | { error: string } }> {
+    try {
+      return { status: 200, body: await this.report.execute(query.from, query.to) };
+    } catch (e) {
+      return { status: 400, body: { error: e instanceof Error ? e.message : String(e) } };
+    }
+  }
+}
diff --git a/src/billing/application/GetMonthlyRevenue.ts b/src/billing/application/GetMonthlyRevenue.ts
