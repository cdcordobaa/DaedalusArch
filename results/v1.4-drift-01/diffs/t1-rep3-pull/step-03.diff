diff --git a/src/ordering/application/GetOrderCounts.ts b/src/ordering/application/GetOrderCounts.ts
new file mode 100644
index 000000000..27eed79f8
--- /dev/null
+++ b/src/ordering/application/GetOrderCounts.ts
@@ -0,0 +1,21 @@
+import type { OrderCountQuery, OrderCountRow } from '../contracts/OrderSummary.js';
+import type { OrderRepository } from '../domain/order/OrderRepository.js';
+
+/** Query service behind the published OrderCountQuery contract. */
+export class GetOrderCounts implements OrderCountQuery {
+  constructor(private readonly orders: OrderRepository) {}
+
+  async ordersPlaced(fromMonth: string, toMonth: string): Promise<OrderCountRow[]> {
+    const [fy, fm] = fromMonth.split('-').map(Number);
+    const [ty, tm] = toMonth.split('-').map(Number);
+    const orders = await this.orders.placedBetween(new Date(Date.UTC(fy, fm - 1, 1)), new Date(Date.UTC(ty, tm, 1)));
+    const counts = new Map<string, OrderCountRow>();
+    for (const o of orders) {
+      const month = (o.placedAt() as Date).toISOString().slice(0, 7);
+      const key = JSON.stringify([o.customerId.value, month, o.currency]);
+      const row = counts.get(key);
+      counts.set(key, { customerId: o.customerId.value, month, currency: o.currency, orders: (row?.orders ?? 0) + 1 });
+    }
+    return [...counts.values()];
+  }
+}
