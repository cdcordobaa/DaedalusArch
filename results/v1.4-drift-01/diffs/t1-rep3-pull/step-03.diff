+import type { OrderCountQuery } from '../../ordering/index.js';
+import type { OrderCountEntry, OrderCountSource } from '../application/ports/OrderCounts.js';
+
+/** Anti-corruption layer: translates ordering's published order counts into billing's model. */
+export class OrderCountAcl implements OrderCountSource {
+  constructor(private readonly ordering: OrderCountQuery) {}
+
+  async ordersPlaced(fromMonth: string, toMonth: string): Promise<OrderCountEntry[]> {
+    const rows = await this.ordering.ordersPlaced(fromMonth, toMonth);
+    return rows.map((r) => ({ customerId: r.customerId, month: r.month, currency: r.currency, orders: r.orders }));
+  }
+}
