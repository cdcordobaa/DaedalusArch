--- /dev/null
+++ b/src/ordering/application/SetTaxRate.ts
@@ -0,0 +1,12 @@
+import type { TaxRatesRepository } from '../domain/tax/TaxRatesRepository.js';
+
+/** Finance changes a country's tax rate; it applies to orders placed afterwards. */
+export class SetTaxRate {
+  constructor(private readonly rates: TaxRatesRepository) {}
+
+  async execute(country: string, rate: number): Promise<void> {
+    const rates = await this.rates.get();
+    rates.setRate(country, rate);
+    await this.rates.save(rates);
+  }
+}
