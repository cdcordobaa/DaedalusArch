+
+export class InMemoryTaxRatesRepository implements TaxRatesRepository {
+  private rates = new TaxRates();
+
+  async get(): Promise<TaxRates> {
+    return this.rates;
+  }
+
+  async save(rates: TaxRates): Promise<void> {
