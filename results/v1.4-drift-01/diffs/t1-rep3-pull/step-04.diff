diff --git a/src/ordering/domain/tax/TaxRates.ts b/src/ordering/domain/tax/TaxRates.ts
new file mode 100644
index 000000000..eb6b18922
--- /dev/null
+++ b/src/ordering/domain/tax/TaxRates.ts
@@ -0,0 +1,17 @@
+/** Aggregate root: the tax rate per country, maintained by finance. */
+export const DEFAULT_TAX_RATES: Readonly<Record<string, number>> = { GB: 0.2, DE: 0.19, ES: 0.21 };
+
+export class TaxRates {
+  private readonly rates = new Map<string, number>(Object.entries(DEFAULT_TAX_RATES));
+
+  rateFor(country: string): number {
+    return this.rates.get(country) ?? 0;
+  }
+
+  /** A change applies to orders placed after it. */
+  setRate(country: string, rate: number): void {
+    if (!/^[A-Z]{2}$/.test(country)) throw new Error('A country is a two-letter upper-case code');
+    if (!Number.isFinite(rate) || rate < 0) throw new Error('A tax rate must not be negative');
+    this.rates.set(country, rate);
+  }
+}
