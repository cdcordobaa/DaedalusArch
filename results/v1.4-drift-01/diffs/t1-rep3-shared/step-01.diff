+
+/** Finance sets a per-customer credit limit (minor units, applied in each order's currency). */
+export class SetCreditLimit {
+  constructor(private readonly customers: CustomerRepository) {}
+
+  async execute(customerId: string, limitCents: number): Promise<void> {
