+import { Money } from '../../../shared-kernel/value-objects/Money.js';
 import { CustomerId } from './value-objects/CustomerId.js';
 
+export const DEFAULT_CREDIT_LIMIT_CENTS = 500000;
+
 /** Aggregate root with no inner entity. */
 export class Customer {
   private active = true;
+  private creditLimitCents: number = DEFAULT_CREDIT_LIMIT_CENTS;
 
   constructor(readonly id: CustomerId, readonly name: string) {}
 
@@ -13,4 +17,30 @@ export class Customer {
   deactivate(): void {
     this.active = false;
   }
+
+  /** Finance override; the limit applies in the currency of each order. */
+  setCreditLimit(cents: number): void {
+    if (!Number.isInteger(cents) || cents < 0) throw new Error('Credit limit must be a non-negative whole number of minor units');
+    this.creditLimitCents = cents;
+  }
+
+  creditLimit(currency: string): Money {
+    return Money.of(this.creditLimitCents, currency);
+  }
+
+  /** Refuses an order that would take unpaid invoiced amounts above the credit limit. */
+  assertWithinCredit(unpaid: Money, orderTotal: Money): void {
+    const limit = this.creditLimit(orderTotal.currency);
+    const exposure = unpaid.add(orderTotal);
+    if (exposure.isGreaterThan(limit)) {
+      const over = exposure.subtract(limit);
+      throw new Error(`Credit limit exceeded by ${formatMoney(over)}`);
+    }
+  }
+}
+
+function formatMoney(m: Money): string {
+  const abs = Math.abs(m.cents);
+  const frac = String(abs % 100).padStart(2, '0');
+  return `${String(Math.floor(abs / 100))}.${frac} ${m.currency}`;
 }
