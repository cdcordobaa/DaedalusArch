@@ -0,0 +1,14 @@
+import type { OutstandingQuery } from '../contracts/InvoiceView.js';
+import type { InvoiceRepository } from '../domain/invoice/InvoiceRepository.js';
+
+/** Query service behind the published OutstandingQuery contract. */
+export class GetOutstanding implements OutstandingQuery {
+  constructor(private readonly invoices: InvoiceRepository) {}
+
+  async unpaidInvoiceCents(customerId: string, currency: string): Promise<number> {
+    const invoices = await this.invoices.byCustomer(customerId);
+    return invoices
+      .filter((i) => i.isIssued() && i.currency === currency)
+      .reduce((sum, i) => sum + i.outstanding().cents, 0);
+  }
+}
