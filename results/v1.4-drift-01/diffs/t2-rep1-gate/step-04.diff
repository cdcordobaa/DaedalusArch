@@ -0,0 +1,22 @@
+export interface RoomRevenue {
+  roomId: string;
+  revenueCents: number;
+}
+
+export interface NightReport {
+  /** UTC calendar date of the night, YYYY-MM-DD. */
+  date: string;
+  occupiedRooms: number;
+  /** Occupied rooms divided by all rooms, 0..1. */
+  occupancyRate: number;
+  totalRevenueCents: number;
+  /** Only rooms with a booking that night. */
+  rooms: RoomRevenue[];
+}
+
+export interface OccupancyReport {
+  /** Nights from `from` (inclusive) to `to` (inclusive); at most 90. */
+  report(from: string, to: string): Promise<NightReport[]>;
+}
+
+export const MAX_REPORT_NIGHTS = 90;
diff --git a/src/application/services/OccupancyReportService.ts b/src/application/services/OccupancyReportService.ts
new file mode 100644
index 000000000..8623acd53
--- /dev/null
+++ b/src/application/services/OccupancyReportService.ts
@@ -0,0 +1,67 @@
+import { BookingError } from '../../domain/errors/BookingError';
+import { OccupancyReport, MAX_REPORT_NIGHTS, NightReport } from '../ports/in/OccupancyReport';
+import { BookingRepository } from '../ports/out/BookingRepository';
+import { RoomRepository } from '../ports/out/RoomRepository';
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const DATE_ONLY = /^\d{4}-\d{2}-\d{2}$/;
+
+function parseDay(value: string): number {
+  const time = DATE_ONLY.test(value) ? Date.parse(value) : Number.NaN;
+  if (Number.isNaN(time)) throw new BookingError('invalid', `Invalid date: ${value}`);
+  return Math.floor(time / DAY_MS);
+}
+
+export class OccupancyReportService implements OccupancyReport {
+  constructor(
+    private readonly rooms: RoomRepository,
+    private readonly bookings: BookingRepository,
+  ) {}
+
+  async report(from: string, to: string): Promise<NightReport[]> {
+    const firstDay = parseDay(from);
+    const lastDay = parseDay(to);
+    if (lastDay < firstDay) throw new BookingError('invalid', 'from must not be after to');
+    const nightCount = lastDay - firstDay + 1;
+    if (nightCount > MAX_REPORT_NIGHTS) {
+      throw new BookingError('invalid', `Range must not exceed ${MAX_REPORT_NIGHTS} nights`);
+    }
+
+    const [allRooms, active] = await Promise.all([this.rooms.findAll(), this.bookings.findActive()]);
+
+    // One pass over the bookings; each only touches the nights it shares with the range.
+    const perNight: Map<string, number>[] = Array.from({ length: nightCount }, () => new Map());
+    for (const booking of active) {
+      const nights = booking.stay.nights();
+      const startDay = Math.floor(booking.stay.checkIn.getTime() / DAY_MS);
+      const total = booking.total.cents;
+      const base = Math.floor(total / nights);
+      const remainder = total - base * nights;
+      const lo = Math.max(startDay, firstDay);
+      const hi = Math.min(startDay + nights - 1, lastDay);
+      for (let day = lo; day <= hi; day++) {
+        // Spread evenly in whole cents; the first `remainder` nights carry one extra cent.
+        const share = base + (day - startDay < remainder ? 1 : 0);
+        const night = perNight[day - firstDay]!;
+        night.set(booking.roomId, (night.get(booking.roomId) ?? 0) + share);
+      }
+    }
+
+    const roomCount = allRooms.length;
+    return perNight.map((revenueByRoom, i) => {
+      let totalRevenueCents = 0;
+      const rooms = [];
+      for (const [roomId, revenueCents] of revenueByRoom) {
+        totalRevenueCents += revenueCents;
+        rooms.push({ roomId, revenueCents });
+      }
+      return {
+        date: new Date((firstDay + i) * DAY_MS).toISOString().slice(0, 10),
+        occupiedRooms: revenueByRoom.size,
+        occupancyRate: roomCount === 0 ? 0 : revenueByRoom.size / roomCount,
+        totalRevenueCents,
+        rooms,
+      };
+    });
+  }
+}
