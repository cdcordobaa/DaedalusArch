+import { OccupancyReportQuery } from '../../../application/ports/in/OccupancyReport';
+import { BookingError } from '../../../domain/errors/BookingError';
+import { HttpRequest, HttpResponse } from './HttpTypes';
+
+export class ReportController {
+  constructor(private readonly occupancy: OccupancyReportQuery) {}
+
+  /** GET /reports/occupancy?from=YYYY-MM-DD&to=YYYY-MM-DD (to is exclusive, max 90 nights). */
+  async occupancyReport(request: HttpRequest): Promise<HttpResponse> {
+    try {
+      return { status: 200, body: await this.occupancy.report(String(request.query['from']), String(request.query['to'])) };
+    } catch (error) {
+      if (error instanceof BookingError) return { status: 400, body: { error: error.message } };
+      return { status: 500, body: { error: 'Internal error' } };
+    }
+  }
+}
