new file mode 100644
index 000000000..fa290925c
--- /dev/null
+++ b/src/adapters/outbound/persistence/PgDatabase.ts
@@ -0,0 +1,94 @@
+import { AsyncLocalStorage } from 'node:async_hooks';
+import { Pool, Queryable, Transaction } from 'sqlwell';
+
+const SCHEMA = [
+  `CREATE TABLE IF NOT EXISTS rooms (
+    id text PRIMARY KEY,
+    number text NOT NULL,
+    nightly_rate_cents bigint NOT NULL,
+    capacity integer NOT NULL
+  )`,
+  `CREATE TABLE IF NOT EXISTS guests (
+    id text PRIMARY KEY,
+    name text NOT NULL,
+    email text NOT NULL
+  )`,
+  `CREATE TABLE IF NOT EXISTS bookings (
+    id text PRIMARY KEY,
+    room_id text NOT NULL REFERENCES rooms (id),
+    guest_id text NOT NULL REFERENCES guests (id),
+    check_in timestamptz NOT NULL,
+    check_out timestamptz NOT NULL,
+    total_cents bigint NOT NULL,
+    payment_ref text NOT NULL,
+    status text NOT NULL,
+    refund_pending boolean NOT NULL DEFAULT false
+  )`,
+  `CREATE INDEX IF NOT EXISTS bookings_room_idx ON bookings (room_id)`,
+  `CREATE TABLE IF NOT EXISTS audit_records (
+    id text PRIMARY KEY,
+    staff_id text NOT NULL,
+    action text NOT NULL,
+    booking_id text NOT NULL REFERENCES bookings (id),
+    at timestamptz NOT NULL,
+    before jsonb,
+    after jsonb
+  )`,
+  `CREATE INDEX IF NOT EXISTS audit_booking_idx ON audit_records (booking_id)`,
+  `CREATE INDEX IF NOT EXISTS audit_staff_idx ON audit_records (staff_id, at)`,
+  `INSERT INTO rooms (id, number, nightly_rate_cents, capacity) VALUES
+    ('r-101', '101', 9000, 2),
+    ('r-102', '102', 12000, 3),
+    ('r-201', '201', 20000, 4)
+   ON CONFLICT (id) DO NOTHING`,
+  `INSERT INTO guests (id, name, email) VALUES ('g-1', 'Alistair', 'alistair@example.org')
+   ON CONFLICT (id) DO NOTHING`,
+];
+
+/**
+ * Shared sqlwell access for the PostgreSQL repositories. Work started with `inTransaction` runs on one
+ * transaction: repository calls made inside it (through `db`) use that transaction automatically.
+ */
+export class PgDatabase {
+  private readonly pool: Pool;
+  private readonly current = new AsyncLocalStorage<Transaction>();
+  private ready: Promise<void> | undefined;
+
+  constructor(connectionString: string) {
+    this.pool = new Pool({ connectionString });
+  }
+
+  /** The transaction of the surrounding `inTransaction`, or the pool when there is none. */
+  async db(): Promise<Queryable> {
+    await this.ensureSchema();
+    return this.current.getStore() ?? this.pool;
+  }
+
+  async inTransaction<T>(work: () => Promise<T>): Promise<T> {
+    await this.ensureSchema();
+    const existing = this.current.getStore();
+    if (existing !== undefined) return work();
+    return this.pool.transaction((tx) => this.current.run(tx, work));
+  }
+
+  close(): Promise<void> {
+    return this.pool.end();
+  }
+
+  private ensureSchema(): Promise<void> {
+    if (this.ready === undefined) {
+      const attempt = this.pool
+        .transaction(async (tx) => {
+          // Serialises schema setup when several servers start together.
+          await tx.query('SELECT pg_advisory_xact_lock(727001)');
+          for (const statement of SCHEMA) await tx.query(statement);
+        })
+        .then(() => undefined);
+      this.ready = attempt;
+      attempt.catch(() => {
+        if (this.ready === attempt) this.ready = undefined;
+      });
+    }
+    return this.ready;
+  }
+}
