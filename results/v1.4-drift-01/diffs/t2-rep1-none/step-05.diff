diff --git a/src/adapters/outbound/persistence/PgBookingRepository.ts b/src/adapters/outbound/persistence/PgBookingRepository.ts
new file mode 100644
index 000000000..39589c0f6
--- /dev/null
+++ b/src/adapters/outbound/persistence/PgBookingRepository.ts
@@ -0,0 +1,177 @@
+import { randomUUID } from 'node:crypto';
+import { BookingView } from '../../../application/ports/in/BookingView';
+import { AuditAction, AuditLog, AuditRecord } from '../../../application/ports/out/AuditLog';
+import { BookingRepository } from '../../../application/ports/out/BookingRepository';
+import { Booking, BookingStatus } from '../../../domain/model/Booking';
+import { DateRange } from '../../../domain/model/DateRange';
+import { Money } from '../../../domain/model/Money';
+import { PgDatabase } from './PgDatabase';
+
+interface BookingRow {
+  id: string;
+  room_id: string;
+  guest_id: string;
+  check_in_ms: string | number;
+  check_out_ms: string | number;
+  total_cents: string | number;
+  payment_ref: string;
+  status: string;
+  refund_pending: boolean;
+}
+
+interface AuditRow {
+  id: string;
+  staff_id: string;
+  action: string;
+  booking_id: string;
+  at_ms: string | number;
+  before: unknown;
+  after: unknown;
+}
+
+const BOOKING_COLUMNS = `id, room_id, guest_id,
+  (extract(epoch FROM check_in) * 1000)::bigint AS check_in_ms,
+  (extract(epoch FROM check_out) * 1000)::bigint AS check_out_ms,
+  total_cents, payment_ref, status, refund_pending`;
+
+const AUDIT_COLUMNS = `id, staff_id, action, booking_id,
+  (extract(epoch FROM at) * 1000)::bigint AS at_ms, before, after`;
+
+function toBooking(row: BookingRow): Booking {
+  return Booking.restore(
+    row.id,
+    row.room_id,
+    row.guest_id,
+    new DateRange(new Date(Number(row.check_in_ms)), new Date(Number(row.check_out_ms))),
+    Money.ofCents(Number(row.total_cents)),
+    row.payment_ref,
+    row.status as BookingStatus,
+    row.refund_pending,
+  );
+}
+
+function parseView(value: unknown): BookingView | null {
+  if (value === null || value === undefined) return null;
+  return (typeof value === 'string' ? JSON.parse(value) : value) as BookingView;
+}
+
+function toAuditRecord(row: AuditRow): AuditRecord {
+  return {
+    id: row.id,
+    staffId: row.staff_id,
+    action: row.action as AuditAction,
+    bookingId: row.booking_id,
+    at: new Date(Number(row.at_ms)).toISOString(),
+    before: parseView(row.before),
+    after: parseView(row.after),
+  };
+}
+
+export class PgBookingRepository implements BookingRepository, AuditLog {
+  constructor(private readonly database: PgDatabase) {}
+
+  async findById(id: string): Promise<Booking | undefined> {
+    const db = await this.database.db();
+    const result = await db.query<BookingRow>(`SELECT ${BOOKING_COLUMNS} FROM bookings WHERE id = $1`, [id]);
+    const row = result.rows[0];
+    return row === undefined ? undefined : toBooking(row);
+  }
+
+  async findByRoom(roomId: string): Promise<Booking[]> {
+    const db = await this.database.db();
+    const result = await db.query<BookingRow>(`SELECT ${BOOKING_COLUMNS} FROM bookings WHERE room_id = $1 ORDER BY id`, [roomId]);
+    return result.rows.map(toBooking);
+  }
+
+  async findActive(): Promise<Booking[]> {
+    const db = await this.database.db();
+    const result = await db.query<BookingRow>(`SELECT ${BOOKING_COLUMNS} FROM bookings WHERE status = 'confirmed' ORDER BY id`);
+    return result.rows.map(toBooking);
+  }
+
+  async findPendingRefunds(): Promise<Booking[]> {
+    const db = await this.database.db();
+    const result = await db.query<BookingRow>(`SELECT ${BOOKING_COLUMNS} FROM bookings WHERE refund_pending ORDER BY id`);
+    return result.rows.map(toBooking);
+  }
+
+  async save(booking: Booking): Promise<void> {
+    const db = await this.database.db();
+    await db.query(
+      `INSERT INTO bookings (id, room_id, guest_id, check_in, check_out, total_cents, payment_ref, status, refund_pending)
+       VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9)
+       ON CONFLICT (id) DO UPDATE SET status = EXCLUDED.status, refund_pending = EXCLUDED.refund_pending`,
+      [
+        booking.id,
+        booking.roomId,
+        booking.guestId,
+        booking.stay.checkIn.toISOString(),
+        booking.stay.checkOut.toISOString(),
+        booking.total.cents,
+        booking.paymentRef,
+        booking.status,
+        booking.refundPending,
+      ],
+    );
+  }
+
+  async saveWithAudit(booking: Booking, records: AuditRecord[]): Promise<void> {
+    await this.database.inTransaction(async () => {
+      await this.save(booking);
+      const db = await this.database.db();
+      for (const r of records) {
+        await db.query(
+          `INSERT INTO audit_records (id, staff_id, action, booking_id, at, before, after)
+           VALUES ($1, $2, $3, $4, $5, $6::jsonb, $7::jsonb)`,
+          [
+            r.id,
+            r.staffId,
+            r.action,
+            r.bookingId,
+            r.at,
+            r.before === null ? null : JSON.stringify(r.before),
+            r.after === null ? null : JSON.stringify(r.after),
+          ],
+        );
+      }
+    });
+  }
+
+  /**
+   * One transaction per booking attempt: the room row is locked first, so bookings of the same room are
+   * serialised across all servers sharing the database, and the check, charge record and save commit together.
+   */
+  async withRoomLock<T>(roomId: string, work: () => Promise<T>): Promise<T> {
+    return this.database.inTransaction(async () => {
+      const db = await this.database.db();
+      await db.query('SELECT id FROM rooms WHERE id = $1 FOR UPDATE', [roomId]);
+      return work();
+    });
+  }
+
+  async findByBooking(bookingId: string): Promise<AuditRecord[]> {
+    const db = await this.database.db();
+    const result = await db.query<AuditRow>(
+      `SELECT ${AUDIT_COLUMNS} FROM audit_records WHERE booking_id = $1 ORDER BY at, id`,
+      [bookingId],
+    );
+    return result.rows.map(toAuditRecord);
+  }
+
+  async findByStaff(staffId: string, from: Date, to: Date): Promise<AuditRecord[]> {
+    const db = await this.database.db();
+    const result = await db.query<AuditRow>(
+      `SELECT ${AUDIT_COLUMNS} FROM audit_records WHERE staff_id = $1 AND at >= $2 AND at < $3 ORDER BY at, id`,
+      [staffId, from.toISOString(), to.toISOString()],
+    );
+    return result.rows.map(toAuditRecord);
+  }
+
+  nextAuditId(): string {
+    return `au-${randomUUID()}`;
+  }
+
+  nextId(): string {
+    return `bk-${randomUUID()}`;
+  }
+}
