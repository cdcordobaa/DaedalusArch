+interface GuestRow {
+  id: string;
+  name: string;
+  email: string;
+}
+
+export class PgGuestRepository implements GuestRepository {
+  constructor(private readonly database: PgDatabase) {}
+
+  async findById(id: string): Promise<Guest | undefined> {
+    const db = await this.database.db();
+    const result = await db.query<GuestRow>('SELECT id, name, email FROM guests WHERE id = $1', [id]);
