diff --git a/src/domain/model/AuditRecord.ts b/src/domain/model/AuditRecord.ts
new file mode 100644
index 000000000..5f61dd3b4
--- /dev/null
+++ b/src/domain/model/AuditRecord.ts
@@ -0,0 +1,36 @@
+import { Booking } from './Booking';
+
+export type AuditAction = 'booking' | 'cancellation' | 'charge' | 'refund';
+
+/** The auditable values of a booking at one moment. */
+export interface BookingSnapshot {
+  readonly status: string;
+  readonly refundPending: boolean;
+  readonly totalCents: number;
+  readonly checkIn: string;
+  readonly checkOut: string;
+  readonly paymentRef: string;
+}
+
+export function snapshotOf(booking: Booking): BookingSnapshot {
+  return {
+    status: booking.status,
+    refundPending: booking.refundPending,
+    totalCents: booking.total.cents,
+    checkIn: booking.stay.checkIn.toISOString(),
+    checkOut: booking.stay.checkOut.toISOString(),
+    paymentRef: booking.paymentRef,
+  };
+}
+
+/** Who did what to a booking, when, and the values before and after. */
+export class AuditRecord {
+  constructor(
+    readonly bookingId: string,
+    readonly staffId: string,
+    readonly action: AuditAction,
+    readonly at: Date,
+    readonly before: BookingSnapshot | null,
+    readonly after: BookingSnapshot,
+  ) {}
+}
