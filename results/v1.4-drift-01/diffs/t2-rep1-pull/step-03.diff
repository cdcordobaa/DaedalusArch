@@ -0,0 +1,21 @@
+import { BookingError } from '../../domain/errors/BookingError';
+import { AuditRecord } from '../../domain/model/AuditRecord';
+import { AuditQuery } from '../ports/in/AuditQuery';
+import { AuditTrail } from '../ports/out/AuditTrail';
+
+export class AuditQueryService implements AuditQuery {
+  constructor(private readonly trail: AuditTrail) {}
+
+  listForBooking(bookingId: string): Promise<AuditRecord[]> {
+    return this.trail.findByBooking(bookingId);
+  }
+
+  listForStaff(staffId: string, from: string, to: string): Promise<AuditRecord[]> {
+    const start = new Date(from);
+    const end = new Date(to);
+    if (Number.isNaN(start.getTime()) || Number.isNaN(end.getTime()) || start > end) {
+      throw new BookingError('invalid', 'Invalid date range');
+    }
+    return this.trail.findByStaff(staffId, start, end);
+  }
+}
