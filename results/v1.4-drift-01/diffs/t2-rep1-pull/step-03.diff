+import { AuditQuery } from '../../../application/ports/in/AuditQuery';
+import { BookingError } from '../../../domain/errors/BookingError';
+import { AuditRecord } from '../../../domain/model/AuditRecord';
+import { HttpRequest, HttpResponse } from './HttpTypes';
+
+const STATUS = { 'not-found': 404, unavailable: 409, invalid: 400, 'payment-declined': 402 } as const;
+
+function toBody(record: AuditRecord) {
+  return {
+    bookingId: record.bookingId,
+    staffId: record.staffId,
+    action: record.action,
+    at: record.at.toISOString(),
+    before: record.before,
+    after: record.after,
+  };
+}
+
+/** Driving adapter: read access to the audit trail for staff. */
+export class AuditController {
+  constructor(private readonly audit: AuditQuery) {}
+
+  async forBooking(request: HttpRequest): Promise<HttpResponse> {
+    try {
+      const records = await this.audit.listForBooking(String(request.params['id']));
+      return { status: 200, body: records.map(toBody) };
+    } catch (error) {
+      return this.toResponse(error);
+    }
+  }
+
+  /** Query: from and to (ISO dates), both inclusive. */
+  async forStaff(request: HttpRequest): Promise<HttpResponse> {
+    try {
+      const records = await this.audit.listForStaff(
+        String(request.params['staffId']),
+        String(request.query['from']),
+        String(request.query['to']),
+      );
+      return { status: 200, body: records.map(toBody) };
+    } catch (error) {
+      return this.toResponse(error);
+    }
+  }
+
+  private toResponse(error: unknown): HttpResponse {
+    if (error instanceof BookingError) return { status: STATUS[error.reason], body: { error: error.message } };
+    return { status: 500, body: { error: 'Internal error' } };
+  }
+}
