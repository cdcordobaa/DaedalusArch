+interface GuestRow {
+  id: string;
+  name: string;
+  email: string;
+}
+
+export class PostgresGuestRepository implements GuestRepository {
+  constructor(private readonly db: PostgresDatabase) {}
+
+  async findById(id: string): Promise<Guest | undefined> {
+    await this.db.ready();
