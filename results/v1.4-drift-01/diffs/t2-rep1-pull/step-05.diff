+  /** Rebuilds a stored booking, including its lifecycle state. */
+  static restore(
+    id: string,
+    roomId: string,
+    guestId: string,
+    stay: DateRange,
+    total: Money,
+    paymentRef: string,
+    status: BookingStatus,
