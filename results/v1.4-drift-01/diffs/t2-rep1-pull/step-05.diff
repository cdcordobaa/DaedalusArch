diff --git a/src/adapters/outbound/persistence/PostgresBookingRepository.ts b/src/adapters/outbound/persistence/PostgresBookingRepository.ts
new file mode 100644
index 000000000..4c18ca980
--- /dev/null
+++ b/src/adapters/outbound/persistence/PostgresBookingRepository.ts
@@ -0,0 +1,159 @@
+import { randomUUID } from 'node:crypto';
+import { AuditTrail } from '../../../application/ports/out/AuditTrail';
+import { BookingRepository } from '../../../application/ports/out/BookingRepository';
+import { BookingError } from '../../../domain/errors/BookingError';
+import { AuditAction, AuditRecord, BookingSnapshot } from '../../../domain/model/AuditRecord';
+import { Booking, BookingStatus } from '../../../domain/model/Booking';
+import { DateRange } from '../../../domain/model/DateRange';
+import { Money } from '../../../domain/model/Money';
+import { PostgresDatabase } from './PostgresDatabase';
+
+interface BookingRow {
+  id: string;
+  room_id: string;
+  guest_id: string;
+  check_in: Date | string;
+  check_out: Date | string;
+  total_cents: string | number;
+  payment_ref: string;
+  status: BookingStatus;
+  refund_pending: boolean;
+}
+
+interface AuditRow {
+  booking_id: string;
+  staff_id: string;
+  action: AuditAction;
+  at: Date | string;
+  before_state: BookingSnapshot | string | null;
+  after_state: BookingSnapshot | string;
+}
+
+const EXCLUSION_VIOLATION = '23P01';
+
+function toBooking(row: BookingRow): Booking {
+  return Booking.restore(
+    row.id,
+    row.room_id,
+    row.guest_id,
+    new DateRange(new Date(row.check_in), new Date(row.check_out)),
+    Money.ofCents(Number(row.total_cents)),
+    row.payment_ref,
+    row.status,
+    row.refund_pending,
+  );
+}
+
+function snapshot<T extends BookingSnapshot | null>(value: T | string): T {
+  return typeof value === 'string' ? (JSON.parse(value) as T) : value;
+}
+
+function toAudit(row: AuditRow): AuditRecord {
+  return new AuditRecord(
+    row.booking_id,
+    row.staff_id,
+    row.action,
+    new Date(row.at),
+    snapshot<BookingSnapshot | null>(row.before_state),
+    snapshot<BookingSnapshot>(row.after_state),
+  );
+}
+
+export class PostgresBookingRepository implements BookingRepository, AuditTrail {
+  constructor(private readonly db: PostgresDatabase) {}
+
+  async findById(id: string): Promise<Booking | undefined> {
+    await this.db.ready();
+    const result = await this.db.pool.query<BookingRow>('SELECT * FROM bookings WHERE id = $1', [id]);
+    const row = result.rows[0];
+    return row === undefined ? undefined : toBooking(row);
+  }
+
+  async findByRoom(roomId: string): Promise<Booking[]> {
+    await this.db.ready();
+    const result = await this.db.pool.query<BookingRow>('SELECT * FROM bookings WHERE room_id = $1', [roomId]);
+    return result.rows.map(toBooking);
+  }
+
+  async findActive(): Promise<Booking[]> {
+    await this.db.ready();
+    const result = await this.db.pool.query<BookingRow>("SELECT * FROM bookings WHERE status = 'confirmed'");
+    return result.rows.map(toBooking);
+  }
+
+  async findPendingRefunds(): Promise<Booking[]> {
+    await this.db.ready();
+    const result = await this.db.pool.query<BookingRow>('SELECT * FROM bookings WHERE refund_pending');
+    return result.rows.map(toBooking);
+  }
+
+  /**
+   * The booking and its audit records (the charge among them) are written in one transaction.
+   * The bookings_no_overlap exclusion constraint makes the no-overlap rule hold across servers.
+   */
+  async save(booking: Booking, audit: readonly AuditRecord[]): Promise<void> {
+    await this.db.ready();
+    try {
+      await this.db.pool.transaction(async (tx) => {
+        await tx.query(
+          `INSERT INTO bookings
+             (id, room_id, guest_id, check_in, check_out, total_cents, payment_ref, status, refund_pending)
+           VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9)
+           ON CONFLICT (id) DO UPDATE SET status = EXCLUDED.status, refund_pending = EXCLUDED.refund_pending`,
+          [
+            booking.id,
+            booking.roomId,
+            booking.guestId,
+            booking.stay.checkIn,
+            booking.stay.checkOut,
+            booking.total.cents,
+            booking.paymentRef,
+            booking.status,
+            booking.refundPending,
+          ],
+        );
+        for (const record of audit) {
+          await tx.query(
+            `INSERT INTO audit_records (booking_id, staff_id, action, at, before_state, after_state)
+             VALUES ($1, $2, $3, $4, $5::jsonb, $6::jsonb)`,
+            [
+              record.bookingId,
+              record.staffId,
+              record.action,
+              record.at,
+              record.before === null ? null : JSON.stringify(record.before),
+              JSON.stringify(record.after),
+            ],
+          );
+        }
+      });
+    } catch (error) {
+      if ((error as { code?: string }).code === EXCLUSION_VIOLATION) {
+        throw new BookingError('unavailable', `Room ${booking.roomId} is taken for these dates`);
+      }
+      throw error;
+    }
+  }
+
+  async findByBooking(bookingId: string): Promise<AuditRecord[]> {
+    await this.db.ready();
+    const result = await this.db.pool.query<AuditRow>(
+      'SELECT * FROM audit_records WHERE booking_id = $1 ORDER BY seq',
+      [bookingId],
+    );
+    return result.rows.map(toAudit);
+  }
+
+  async findByStaff(staffId: string, from: Date, to: Date): Promise<AuditRecord[]> {
+    await this.db.ready();
+    const result = await this.db.pool.query<AuditRow>(
+      'SELECT * FROM audit_records WHERE staff_id = $1 AND at >= $2 AND at <= $3 ORDER BY seq',
+      [staffId, from, to],
+    );
+    return result.rows.map(toAudit);
+  }
+
+  nextId(): string {
+    return `bk-${randomUUID()}`;
+  }
+}
diff --git a/src/adapters/outbound/persistence/PostgresDatabase.ts b/src/adapters/outbound/persistence/PostgresDatabase.ts
new file mode 100644
index 000000000..d588668e7
--- /dev/null
+++ b/src/adapters/outbound/persistence/PostgresDatabase.ts
@@ -0,0 +1,75 @@
+import { Pool } from 'sqlwell';
+
+const SCHEMA = [
+  'CREATE EXTENSION IF NOT EXISTS btree_gist',
+  `CREATE TABLE IF NOT EXISTS rooms (
+    id text PRIMARY KEY,
+    number text NOT NULL,
+    nightly_rate_cents bigint NOT NULL,
+    capacity integer NOT NULL
+  )`,
+  `CREATE TABLE IF NOT EXISTS guests (
+    id text PRIMARY KEY,
+    name text NOT NULL,
+    email text NOT NULL
+  )`,
+  `CREATE TABLE IF NOT EXISTS bookings (
+    id text PRIMARY KEY,
+    room_id text NOT NULL REFERENCES rooms (id),
+    guest_id text NOT NULL REFERENCES guests (id),
+    check_in timestamptz NOT NULL,
+    check_out timestamptz NOT NULL,
+    total_cents bigint NOT NULL,
+    payment_ref text NOT NULL,
+    status text NOT NULL,
+    refund_pending boolean NOT NULL DEFAULT false,
+    CONSTRAINT bookings_no_overlap EXCLUDE USING gist (
+      room_id WITH =,
+      tstzrange(check_in, check_out) WITH &&
+    ) WHERE (status = 'confirmed')
+  )`,
+  `CREATE TABLE IF NOT EXISTS audit_records (
+    seq bigserial PRIMARY KEY,
+    booking_id text NOT NULL REFERENCES bookings (id),
+    staff_id text NOT NULL,
+    action text NOT NULL,
+    at timestamptz NOT NULL,
+    before_state jsonb,
+    after_state jsonb NOT NULL
+  )`,
+  'CREATE INDEX IF NOT EXISTS audit_records_booking_idx ON audit_records (booking_id)',
+  'CREATE INDEX IF NOT EXISTS audit_records_staff_idx ON audit_records (staff_id, at)',
+  `INSERT INTO rooms (id, number, nightly_rate_cents, capacity) VALUES
+    ('r-101', '101', 9000, 2),
+    ('r-102', '102', 12000, 3),
+    ('r-201', '201', 20000, 4)
+   ON CONFLICT (id) DO NOTHING`,
+  `INSERT INTO guests (id, name, email) VALUES ('g-1', 'Alistair', 'alistair@example.org')
+   ON CONFLICT (id) DO NOTHING`,
+];
+
+/** Shared sqlwell pool; creates the schema (and the initial rooms and guest) once, on first use. */
+export class PostgresDatabase {
+  readonly pool: Pool;
+  private initialised: Promise<void> | undefined;
+
+  constructor(connectionString: string) {
+    this.pool = new Pool({ connectionString });
+  }
+
+  ready(): Promise<void> {
+    if (this.initialised === undefined) {
+      this.initialised = this.pool
+        .transaction(async (tx) => {
+          // Serialises schema setup between servers starting at the same time.
+          await tx.query('SELECT pg_advisory_xact_lock(727001)');
+          for (const statement of SCHEMA) await tx.query(statement);
+        })
+        .catch((error: unknown) => {
+          this.initialised = undefined;
+          throw error;
+        });
+    }
+    return this.initialised;
+  }
+}
