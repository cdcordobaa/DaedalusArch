+import { BookingError } from '../../domain/errors/BookingError';
+import { AuditRecord } from '../../domain/model/AuditRecord';
+import { ViewAuditTrail } from '../ports/in/ViewAuditTrail';
+import { AuditLog } from '../ports/out/AuditLog';
+
+const DATE_ONLY = /^\d{4}-\d{2}-\d{2}$/;
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+function parseInstant(text: string, label: string, endOfDay: boolean): number {
+  const base = Date.parse(text);
+  if (Number.isNaN(base)) throw new BookingError('invalid', `Invalid ${label} date: ${text}`);
+  return endOfDay && DATE_ONLY.test(text) ? base + DAY_MS - 1 : base;
+}
+
+export class AuditTrailService implements ViewAuditTrail {
+  constructor(private readonly audit: AuditLog) {}
+
+  forBooking(bookingId: string): Promise<AuditRecord[]> {
+    return this.audit.findByBooking(bookingId);
+  }
+
+  async forStaff(staffId: string, from: string, to: string): Promise<AuditRecord[]> {
+    const start = parseInstant(from, 'from', false);
+    const end = parseInstant(to, 'to', true);
+    if (start > end) throw new BookingError('invalid', 'from must not be after to');
+    return this.audit.findByStaff(staffId, start, end);
+  }
+}
