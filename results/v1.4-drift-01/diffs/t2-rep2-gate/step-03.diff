@@ -0,0 +1,28 @@
+import { AuditLog } from '../../../application/ports/out/AuditLog';
+import { AuditEntry, AuditRecord } from '../../../domain/model/AuditRecord';
+
+export class InMemoryAuditLog implements AuditLog {
+  private readonly rows: AuditRecord[] = [];
+  private sequence = 0;
+
+  /** Synchronous so a repository can store a change and its records with no gap between them. */
+  appendNow(entries: readonly AuditEntry[]): void {
+    for (const entry of entries) {
+      this.sequence += 1;
+      this.rows.push(
+        Object.freeze({ ...entry, id: `au-${this.sequence}`, before: structuredClone(entry.before), after: structuredClone(entry.after) }),
+      );
+    }
+  }
+
+  async findByBooking(bookingId: string): Promise<AuditRecord[]> {
+    return this.rows.filter((r) => r.bookingId === bookingId);
+  }
+
+  async findByStaff(staffId: string, from: number, to: number): Promise<AuditRecord[]> {
+    return this.rows.filter((r) => {
+      const at = Date.parse(r.at);
+      return r.staffId === staffId && at >= from && at <= to;
+    });
+  }
+}
