@@ -0,0 +1,18 @@
+export type AuditAction = 'booking' | 'cancellation' | 'charge' | 'refund';
+
+/** What a booking records about a change; the audit log gives it an id when the booking is saved. */
+export interface AuditEntry {
+  readonly bookingId: string;
+  readonly staffId: string;
+  readonly action: AuditAction;
+  readonly at: string;
+  readonly before: unknown;
+  readonly after: unknown;
+}
+
+/** One immutable line of the audit trail: who changed what, when, and the values before and after. */
+export interface AuditRecord extends AuditEntry {
+  readonly id: string;
+}
+
+export const DEFAULT_STAFF_ID = 'guest';
