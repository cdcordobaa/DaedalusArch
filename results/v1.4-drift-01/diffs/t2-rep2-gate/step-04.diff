@@ -0,0 +1,20 @@
+export interface RoomRevenue {
+  roomId: string;
+  revenueCents: number;
+}
+
+export interface NightReport {
+  /** The night starting on this date, `YYYY-MM-DD`. */
+  date: string;
+  roomsOccupied: number;
+  /** Occupied rooms divided by all rooms, 0..1. */
+  occupancyRate: number;
+  totalRevenueCents: number;
+  /** Only rooms with revenue that night. */
+  perRoom: RoomRevenue[];
+}
+
+export interface ViewOccupancyReport {
+  /** Nights from `from` (inclusive) to `to` (exclusive), both `YYYY-MM-DD`; at most 90 nights. */
+  report(from: string, to: string): Promise<NightReport[]>;
+}
diff --git a/src/application/services/OccupancyReportService.ts b/src/application/services/OccupancyReportService.ts
new file mode 100644
index 000000000..c9763c0d7
--- /dev/null
+++ b/src/application/services/OccupancyReportService.ts
@@ -0,0 +1,74 @@
+import { BookingError } from '../../domain/errors/BookingError';
+import { NightReport, RoomRevenue, ViewOccupancyReport } from '../ports/in/ViewOccupancyReport';
+import { BookingRepository } from '../ports/out/BookingRepository';
+import { RoomRepository } from '../ports/out/RoomRepository';
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const MAX_NIGHTS = 90;
+const DATE_ONLY = /^\d{4}-\d{2}-\d{2}$/;
+
+function parseDay(value: string, name: string): number {
+  const time = DATE_ONLY.test(value) ? Date.parse(`${value}T00:00:00Z`) : NaN;
+  if (Number.isNaN(time)) throw new BookingError('invalid', `${name} must be a date as YYYY-MM-DD`);
+  return time / DAY_MS;
+}
+
+export class OccupancyReportService implements ViewOccupancyReport {
+  constructor(
+    private readonly rooms: RoomRepository,
+    private readonly bookings: BookingRepository,
+  ) {}
+
+  async report(from: string, to: string): Promise<NightReport[]> {
+    const first = parseDay(from, 'from');
+    const nights = parseDay(to, 'to') - first;
+    if (nights < 1) throw new BookingError('invalid', 'to must be after from');
+    if (nights > MAX_NIGHTS) throw new BookingError('invalid', `At most ${MAX_NIGHTS} nights can be reported`);
+
+    const roomCount = (await this.rooms.findAll()).length;
+    const active = await this.bookings.findActive();
+
+    // Per room, per night: bookings staying and their revenue. One pass over the bookings,
+    // touching only the nights that fall inside the range.
+    const perRoom = new Map<string, { stays: Int32Array; revenue: Float64Array }>();
+    for (const booking of active) {
+      const stayNights = booking.stay.nights();
+      const start = Math.floor(booking.stay.checkIn.getTime() / DAY_MS);
+      const lo = Math.max(start, first);
+      const hi = Math.min(start + stayNights, first + nights);
+      if (lo >= hi) continue;
+      let row = perRoom.get(booking.roomId);
+      if (row === undefined) {
+        row = { stays: new Int32Array(nights), revenue: new Float64Array(nights) };
+        perRoom.set(booking.roomId, row);
+      }
+      const share = booking.total.cents / stayNights;
+      for (let day = lo; day < hi; day++) {
+        row.stays[day - first] += 1;
+        row.revenue[day - first] += share;
+      }
+    }
+
+    const result: NightReport[] = [];
+    for (let i = 0; i < nights; i++) {
+      let occupied = 0;
+      let total = 0;
+      const revenues: RoomRevenue[] = [];
+      for (const [roomId, row] of perRoom) {
+        if (row.stays[i] === 0) continue;
+        occupied += 1;
+        const revenueCents = Math.round(row.revenue[i]);
+        total += revenueCents;
+        revenues.push({ roomId, revenueCents });
+      }
+      result.push({
+        date: new Date((first + i) * DAY_MS).toISOString().slice(0, 10),
+        roomsOccupied: occupied,
+        occupancyRate: roomCount === 0 ? 0 : occupied / roomCount,
+        totalRevenueCents: total,
+        perRoom: revenues,
+      });
+    }
+    return result;
+  }
+}
