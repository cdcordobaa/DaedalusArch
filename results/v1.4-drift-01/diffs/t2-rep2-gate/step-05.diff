+import { FailedRefundRepository } from '../../../application/ports/out/FailedRefundRepository';
+import { PostgresDatabase } from './PostgresDatabase';
+
+export class PostgresFailedRefundRepository implements FailedRefundRepository {
+  constructor(private readonly db: PostgresDatabase) {}
+
+  async add(bookingId: string): Promise<void> {
+    await this.db.query('INSERT INTO failed_refunds (booking_id) VALUES ($1) ON CONFLICT (booking_id) DO NOTHING', [bookingId]);
+  }
+
+  async remove(bookingId: string): Promise<void> {
+    await this.db.query('DELETE FROM failed_refunds WHERE booking_id = $1', [bookingId]);
+  }
+
+  async list(): Promise<string[]> {
+    const rows = await this.db.query<{ booking_id: string }>('SELECT booking_id FROM failed_refunds ORDER BY seq');
+    return rows.map((r) => r.booking_id);
+  }
+}
