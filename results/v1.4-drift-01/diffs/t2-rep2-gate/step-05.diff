+  private readonly roomLocks = new Map<string, Promise<unknown>>();
+
+  async withRoomLock<T>(roomId: string, work: (bookings: BookingRepository) => Promise<T>): Promise<T> {
+    const previous = this.roomLocks.get(roomId) ?? Promise.resolve();
+    const run = previous.then(() => work(this), () => work(this));
+    const tail = run.catch(() => undefined);
+    this.roomLocks.set(roomId, tail);
+    try {
+      return await run;
+    } finally {
+      if (this.roomLocks.get(roomId) === tail) this.roomLocks.delete(roomId);
+    }
+  }
 }
diff --git a/src/adapters/outbound/persistence/PostgresAuditLog.ts b/src/adapters/outbound/persistence/PostgresAuditLog.ts
