@@ -0,0 +1,44 @@
+import { AuditLog } from '../../../application/ports/out/AuditLog';
+import { AuditAction, AuditRecord } from '../../../domain/model/AuditRecord';
+import { PostgresDatabase, toDate } from './PostgresDatabase';
+
+interface AuditRow {
+  seq: string | number;
+  booking_id: string;
+  staff_id: string;
+  action: AuditAction;
+  at: Date | string;
+  before: unknown;
+  after: unknown;
+}
+
+const COLUMNS = 'seq, booking_id, staff_id, action, at, before, after';
+
+function toRecord(row: AuditRow): AuditRecord {
+  return Object.freeze({
+    id: `au-${row.seq}`,
+    bookingId: row.booking_id,
+    staffId: row.staff_id,
+    action: row.action,
+    at: toDate(row.at).toISOString(),
+    before: row.before,
+    after: row.after,
+  });
+}
+
+export class PostgresAuditLog implements AuditLog {
+  constructor(private readonly db: PostgresDatabase) {}
+
+  async findByBooking(bookingId: string): Promise<AuditRecord[]> {
+    const rows = await this.db.query<AuditRow>(`SELECT ${COLUMNS} FROM audit_records WHERE booking_id = $1 ORDER BY seq`, [bookingId]);
+    return rows.map(toRecord);
+  }
+
+  async findByStaff(staffId: string, from: number, to: number): Promise<AuditRecord[]> {
+    const rows = await this.db.query<AuditRow>(
+      `SELECT ${COLUMNS} FROM audit_records WHERE staff_id = $1 AND at >= $2 AND at <= $3 ORDER BY seq`,
+      [staffId, new Date(from).toISOString(), new Date(to).toISOString()],
+    );
+    return rows.map(toRecord);
+  }
+}
diff --git a/src/adapters/outbound/persistence/PostgresBookingRepository.ts b/src/adapters/outbound/persistence/PostgresBookingRepository.ts
new file mode 100644
index 000000000..c912a52a3
--- /dev/null
+++ b/src/adapters/outbound/persistence/PostgresBookingRepository.ts
@@ -0,0 +1,109 @@
+import { randomUUID } from 'node:crypto';
+import { Queryable } from 'sqlwell';
+import { BookingRepository } from '../../../application/ports/out/BookingRepository';
+import { AuditEntry } from '../../../domain/model/AuditRecord';
+import { Booking, BookingStatus } from '../../../domain/model/Booking';
+import { DateRange } from '../../../domain/model/DateRange';
+import { Money } from '../../../domain/model/Money';
+import { PostgresDatabase, toDate } from './PostgresDatabase';
+
+interface BookingRow {
+  id: string;
+  room_id: string;
+  guest_id: string;
+  check_in: Date | string;
+  check_out: Date | string;
+  total_cents: string | number;
+  payment_ref: string;
+  status: BookingStatus;
+}
+
+const COLUMNS = 'id, room_id, guest_id, check_in, check_out, total_cents, payment_ref, status';
+
+function toBooking(row: BookingRow): Booking {
+  return new Booking(
+    row.id,
+    row.room_id,
+    row.guest_id,
+    new DateRange(toDate(row.check_in), toDate(row.check_out)),
+    Money.ofCents(Number(row.total_cents)),
+    row.payment_ref,
+    row.status,
+  );
+}
+
+/** Reads and writes through `db`, which is the pool or, inside withRoomLock, one open transaction. */
+export class PostgresBookingRepository implements BookingRepository {
+  constructor(
+    private readonly database: PostgresDatabase,
+    private readonly db: Queryable = database.pool,
+  ) {}
+
+  async findById(id: string): Promise<Booking | undefined> {
+    const rows = await this.database.query<BookingRow>(`SELECT ${COLUMNS} FROM bookings WHERE id = $1`, [id], this.db);
+    return rows[0] === undefined ? undefined : toBooking(rows[0]);
+  }
+
+  async findByRoom(roomId: string): Promise<Booking[]> {
+    const rows = await this.database.query<BookingRow>(`SELECT ${COLUMNS} FROM bookings WHERE room_id = $1 ORDER BY id`, [roomId], this.db);
+    return rows.map(toBooking);
+  }
+
+  async findActive(): Promise<Booking[]> {
+    const rows = await this.database.query<BookingRow>(`SELECT ${COLUMNS} FROM bookings WHERE status = 'confirmed' ORDER BY id`, [], this.db);
+    return rows.map(toBooking);
+  }
+
+  async save(booking: Booking): Promise<void> {
+    const entries = booking.unsavedAudit;
+    if (this.db === this.database.pool) {
+      // Not inside a caller's transaction: the booking and its audit rows still go in together.
+      await this.database.ready();
+      await this.database.pool.transaction((tx) => this.write(tx, booking, entries));
+    } else {
+      await this.write(this.db, booking, entries);
+    }
+    booking.clearUnsavedAudit();
+  }
+
+  nextId(): string {
+    return `bk-${randomUUID()}`;
+  }
+
+  async withRoomLock<T>(roomId: string, work: (bookings: BookingRepository) => Promise<T>): Promise<T> {
+    await this.database.ready();
+    return this.database.pool.transaction(async (tx) => {
+      // The room row is the lock every server queues on, so the overlap check and the insert cannot interleave.
+      await tx.query('SELECT id FROM rooms WHERE id = $1 FOR UPDATE', [roomId]);
+      return work(new PostgresBookingRepository(this.database, tx));
+    });
+  }
+
+  private async write(
+    db: Queryable,
+    booking: Booking,
+    entries: readonly AuditEntry[],
+  ): Promise<void> {
+    await db.query(
+      `INSERT INTO bookings (${COLUMNS}) VALUES ($1, $2, $3, $4, $5, $6, $7, $8)
+       ON CONFLICT (id) DO UPDATE SET status = EXCLUDED.status`,
+      [
+        booking.id,
+        booking.roomId,
+        booking.guestId,
+        booking.stay.checkIn.toISOString(),
+        booking.stay.checkOut.toISOString(),
+        booking.total.cents,
+        booking.paymentRef,
+        booking.status,
+      ],
+    );
+    for (const e of entries) {
+      await db.query(
+        `INSERT INTO audit_records (booking_id, staff_id, action, at, before, after)
+         VALUES ($1, $2, $3, $4, $5::jsonb, $6::jsonb)`,
+        [e.bookingId, e.staffId, e.action, e.at, JSON.stringify(e.before ?? null), JSON.stringify(e.after ?? null)],
+      );
+    }
+  }
+}
diff --git a/src/adapters/outbound/persistence/PostgresDatabase.ts b/src/adapters/outbound/persistence/PostgresDatabase.ts
new file mode 100644
index 000000000..2c6097961
--- /dev/null
+++ b/src/adapters/outbound/persistence/PostgresDatabase.ts
@@ -0,0 +1,87 @@
+import { Pool, Queryable } from 'sqlwell';
+
+const SCHEMA = [
+  `CREATE TABLE IF NOT EXISTS rooms (
+    id text PRIMARY KEY,
+    number text NOT NULL,
+    nightly_rate_cents bigint NOT NULL,
+    capacity integer NOT NULL
+  )`,
+  `CREATE TABLE IF NOT EXISTS guests (
+    id text PRIMARY KEY,
+    name text NOT NULL,
+    email text NOT NULL
+  )`,
+  `CREATE TABLE IF NOT EXISTS bookings (
+    id text PRIMARY KEY,
+    room_id text NOT NULL REFERENCES rooms (id),
+    guest_id text NOT NULL REFERENCES guests (id),
+    check_in timestamptz NOT NULL,
+    check_out timestamptz NOT NULL,
+    total_cents bigint NOT NULL,
+    payment_ref text NOT NULL,
+    status text NOT NULL
+  )`,
+  `CREATE INDEX IF NOT EXISTS bookings_room_idx ON bookings (room_id)`,
+  `CREATE TABLE IF NOT EXISTS audit_records (
+    seq bigserial PRIMARY KEY,
+    booking_id text NOT NULL,
+    staff_id text NOT NULL,
+    action text NOT NULL,
+    at timestamptz NOT NULL,
+    before jsonb,
+    after jsonb
+  )`,
+  `CREATE INDEX IF NOT EXISTS audit_records_booking_idx ON audit_records (booking_id)`,
+  `CREATE TABLE IF NOT EXISTS failed_refunds (
+    booking_id text PRIMARY KEY,
+    seq bigserial
+  )`,
+  `INSERT INTO rooms (id, number, nightly_rate_cents, capacity) VALUES
+    ('r-101', '101', 9000, 2),
+    ('r-102', '102', 12000, 3),
+    ('r-201', '201', 20000, 4)
+   ON CONFLICT (id) DO NOTHING`,
+  `INSERT INTO guests (id, name, email) VALUES ('g-1', 'Alistair', 'alistair@example.org') ON CONFLICT (id) DO NOTHING`,
+];
+
+/** Shared sqlwell pool; creates the tables on first use. */
+export class PostgresDatabase {
+  readonly pool: Pool;
+  private schema: Promise<void> | undefined;
+
+  constructor(connectionString: string) {
+    this.pool = new Pool({ connectionString });
+  }
+
+  /** Resolves once the tables exist. Safe to call from every query and from several servers at once. */
+  ready(): Promise<void> {
+    if (this.schema === undefined) {
+      const attempt = this.pool
+        .transaction(async (tx) => {
+          // Serialises schema set-up between servers that start together.
+          await tx.query('SELECT pg_advisory_xact_lock(727001)');
+          for (const statement of SCHEMA) await tx.query(statement);
+        })
+        .catch((error: unknown) => {
+          this.schema = undefined;
+          throw error;
+        });
+      this.schema = attempt;
+    }
+    return this.schema;
+  }
+
+  async query<Row>(text: string, values?: readonly unknown[], db: Queryable = this.pool): Promise<Row[]> {
+    await this.ready();
+    return (await db.query<Row>(text, values)).rows;
+  }
+
+  end(): Promise<void> {
+    return this.pool.end();
+  }
+}
+
+export function toDate(value: unknown): Date {
+  return value instanceof Date ? value : new Date(String(value));
+}
