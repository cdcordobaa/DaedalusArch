+import { ViewAuditTrail } from '../../../application/ports/in/ViewAuditTrail';
+import { BookingError } from '../../../domain/errors/BookingError';
+import { AuditRecord } from '../../../domain/model/AuditRecord';
+import { HttpRequest, HttpResponse } from './HttpTypes';
+
+const STATUS = { 'not-found': 404, unavailable: 409, invalid: 400, 'payment-declined': 402 } as const;
+
+function toBody(record: AuditRecord): unknown {
+  return { ...record, at: record.at.toISOString() };
+}
+
+/** Auditor-facing reads: GET /bookings/:id/audit and GET /audit?staffId=&from=&to=. */
+export class AuditController {
+  constructor(private readonly trail: ViewAuditTrail) {}
+
+  async forBooking(request: HttpRequest): Promise<HttpResponse> {
+    const records = await this.trail.forBooking(String(request.params['id']));
+    return { status: 200, body: records.map(toBody) };
+  }
+
+  async forStaff(request: HttpRequest): Promise<HttpResponse> {
+    try {
+      const { staffId, from, to } = request.query;
+      if (!staffId || !from || !to) throw new BookingError('invalid', 'staffId, from and to are required');
+      const records = await this.trail.forStaff(String(staffId), String(from), String(to));
+      return { status: 200, body: records.map(toBody) };
+    } catch (error) {
+      if (error instanceof BookingError) return { status: STATUS[error.reason], body: { error: error.message } };
+      return { status: 500, body: { error: 'Internal error' } };
+    }
+  }
+}
