@@ -0,0 +1,32 @@
+import { Booking } from './Booking';
+
+export type AuditAction = 'booking' | 'cancellation' | 'charge' | 'refund';
+
+export const DEFAULT_STAFF_ID = 'guest';
+
+/** What is written for a change; the store assigns the id. */
+export interface NewAuditRecord {
+  bookingId: string;
+  staffId: string;
+  action: AuditAction;
+  at: Date;
+  before: Record<string, unknown> | null;
+  after: Record<string, unknown> | null;
+}
+
+export interface AuditRecord extends NewAuditRecord {
+  id: string;
+}
+
+export function bookingSnapshot(booking: Booking): Record<string, unknown> {
+  return {
+    id: booking.id,
+    roomId: booking.roomId,
+    guestId: booking.guestId,
+    checkIn: booking.stay.checkIn.toISOString(),
+    checkOut: booking.stay.checkOut.toISOString(),
+    totalCents: booking.total.cents,
+    paymentRef: booking.paymentRef,
+    status: booking.status,
+  };
+}
