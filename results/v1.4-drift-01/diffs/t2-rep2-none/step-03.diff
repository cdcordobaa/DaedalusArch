@@ -0,0 +1,26 @@
+import { BookingError } from '../../domain/errors/BookingError';
+import { AuditRecord } from '../../domain/model/AuditRecord';
+import { ViewAuditTrail } from '../ports/in/ViewAuditTrail';
+import { AuditLog } from '../ports/out/AuditLog';
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const DATE_ONLY = /^\d{4}-\d{2}-\d{2}$/;
+
+export class AuditTrailService implements ViewAuditTrail {
+  constructor(private readonly log: AuditLog) {}
+
+  forBooking(bookingId: string): Promise<AuditRecord[]> {
+    return this.log.findByBooking(bookingId);
+  }
+
+  forStaff(staffId: string, from: string, to: string): Promise<AuditRecord[]> {
+    const start = new Date(from);
+    let end = new Date(to);
+    if (Number.isNaN(start.getTime()) || Number.isNaN(end.getTime())) {
+      throw new BookingError('invalid', 'from and to must be valid dates');
+    }
+    if (DATE_ONLY.test(to)) end = new Date(end.getTime() + DAY_MS);
+    if (end.getTime() <= start.getTime()) throw new BookingError('invalid', 'to must be after from');
+    return this.log.findByStaff(staffId, start, end);
+  }
+}
