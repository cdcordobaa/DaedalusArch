@@ -0,0 +1,48 @@
+import { AuditLog } from '../../../application/ports/out/AuditLog';
+import { Change, ChangeRecorder } from '../../../application/ports/out/ChangeRecorder';
+import { AuditRecord, NewAuditRecord } from '../../../domain/model/AuditRecord';
+import { InMemoryBookingRepository } from './InMemoryBookingRepository';
+import { InMemoryFailedRefundRepository } from './InMemoryFailedRefundRepository';
+
+/**
+ * Holds the audit records and applies a change plus its records in one synchronous step,
+ * after validating everything, so either all of it is stored or none of it.
+ */
+export class InMemoryAuditStore implements AuditLog, ChangeRecorder {
+  private readonly records: AuditRecord[] = [];
+  private sequence = 0;
+
+  constructor(
+    private readonly bookings: InMemoryBookingRepository,
+    private readonly failedRefunds: InMemoryFailedRefundRepository,
+  ) {}
+
+  async commit(change: Change, records: readonly NewAuditRecord[]): Promise<void> {
+    for (const record of records) {
+      if (record.staffId.trim() === '') throw new Error('Audit record needs a staff id');
+      if (Number.isNaN(record.at.getTime())) throw new Error('Audit record needs a valid time');
+    }
+    if (change.booking !== undefined) this.bookings.put(change.booking);
+    if (change.failedRefund !== undefined) {
+      if (change.failedRefund.pending) this.failedRefunds.put(change.failedRefund.bookingId);
+      else this.failedRefunds.drop(change.failedRefund.bookingId);
+    }
+    for (const record of records) {
+      this.sequence += 1;
+      this.records.push({
+        ...record,
+        id: `au-${this.sequence}`,
+        before: record.before === null ? null : structuredClone(record.before),
+        after: record.after === null ? null : structuredClone(record.after),
+      });
+    }
+  }
+
+  async findByBooking(bookingId: string): Promise<AuditRecord[]> {
+    return this.records.filter((r) => r.bookingId === bookingId);
+  }
+
+  async findByStaff(staffId: string, from: Date, to: Date): Promise<AuditRecord[]> {
+    return this.records.filter((r) => r.staffId === staffId && r.at.getTime() >= from.getTime() && r.at.getTime() < to.getTime());
+  }
+}
