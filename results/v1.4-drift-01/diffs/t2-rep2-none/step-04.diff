+import { OccupancyReport } from '../../../application/ports/in/OccupancyReport';
+import { BookingError } from '../../../domain/errors/BookingError';
+import { HttpRequest, HttpResponse } from './HttpTypes';
+
+const STATUS = { 'not-found': 404, unavailable: 409, invalid: 400, 'payment-declined': 402 } as const;
+
+/** Revenue-manager read: GET /reports/occupancy?from=&to= (nights from inclusive, to exclusive; max 90). */
+export class OccupancyController {
+  constructor(private readonly occupancy: OccupancyReport) {}
+
+  async report(request: HttpRequest): Promise<HttpResponse> {
+    try {
+      const { from, to } = request.query;
+      if (!from || !to) throw new BookingError('invalid', 'from and to are required');
+      return { status: 200, body: await this.occupancy.report(String(from), String(to)) };
+    } catch (error) {
+      if (error instanceof BookingError) return { status: STATUS[error.reason], body: { error: error.message } };
+      return { status: 500, body: { error: 'Internal error' } };
+    }
+  }
+}
