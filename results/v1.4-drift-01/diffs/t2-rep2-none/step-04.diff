@@ -0,0 +1,66 @@
+import { BookingError } from '../../domain/errors/BookingError';
+import { OccupancyReport, NightReport, RoomRevenue } from '../ports/in/OccupancyReport';
+import { BookingRepository } from '../ports/out/BookingRepository';
+import { RoomRepository } from '../ports/out/RoomRepository';
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const MAX_NIGHTS = 90;
+
+function utcDay(date: Date): number {
+  return Math.floor(date.getTime() / DAY_MS);
+}
+
+export class OccupancyReportService implements OccupancyReport {
+  constructor(
+    private readonly rooms: RoomRepository,
+    private readonly bookings: BookingRepository,
+  ) {}
+
+  async report(from: string, to: string): Promise<NightReport[]> {
+    const start = utcDay(new Date(from));
+    const end = utcDay(new Date(to));
+    if (Number.isNaN(start) || Number.isNaN(end)) throw new BookingError('invalid', 'from and to must be valid dates');
+    const count = end - start;
+    if (count < 1) throw new BookingError('invalid', 'to must be after from');
+    if (count > MAX_NIGHTS) throw new BookingError('invalid', `Range is limited to ${MAX_NIGHTS} nights`);
+
+    const [roomCount, active] = await Promise.all([
+      this.rooms.findAll().then((r) => r.length),
+      this.bookings.findActive(),
+    ]);
+
+    // One pass over the bookings; each only touches the nights it overlaps with the range.
+    const perNight: Map<string, number>[] = Array.from({ length: count }, () => new Map<string, number>());
+    for (const booking of active) {
+      const first = utcDay(booking.stay.checkIn);
+      const nights = booking.stay.nights();
+      const lo = Math.max(first, start);
+      const hi = Math.min(first + nights, end);
+      if (lo >= hi) continue;
+      // Spread the total evenly in whole cents: the first `extra` nights carry one cent more.
+      const base = Math.floor(booking.total.cents / nights);
+      const extra = booking.total.cents % nights;
+      for (let day = lo; day < hi; day++) {
+        const share = base + (day - first < extra ? 1 : 0);
+        const night = perNight[day - start]!;
+        night.set(booking.roomId, (night.get(booking.roomId) ?? 0) + share);
+      }
+    }
+
+    return perNight.map((night, i) => {
+      let revenueCents = 0;
+      const rooms: RoomRevenue[] = [];
+      for (const [roomId, cents] of night) {
+        revenueCents += cents;
+        rooms.push({ roomId, revenueCents: cents });
+      }
+      return {
+        date: new Date((start + i) * DAY_MS).toISOString().slice(0, 10),
+        roomsOccupied: night.size,
+        occupancyRate: roomCount === 0 ? 0 : night.size / roomCount,
+        revenueCents,
+        rooms,
+      };
+    });
+  }
+}
