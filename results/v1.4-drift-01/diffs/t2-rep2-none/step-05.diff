+import { Booking } from '../../../domain/model/Booking';
+import { Change } from './ChangeRecorder';
+import { NewAuditRecord } from '../../../domain/model/AuditRecord';
+
+export interface RoomBookingScope {
+  /** All bookings of the room, read while the room is exclusively held. */
+  existing: Booking[];
+  /** Stores the change and its audit records as part of the same unit of work. */
+  commit(change: Change, records: readonly NewAuditRecord[]): Promise<void>;
+}
+
+/**
+ * Driven port: runs work with exclusive access to one room's bookings, so checking
+ * availability, charging and saving cannot interleave with another booking of that room,
+ * even from another server process.
+ */
+export interface BookingUnitOfWork {
+  withRoom<T>(roomId: string, work: (scope: RoomBookingScope) => Promise<T>): Promise<T>;
+}
