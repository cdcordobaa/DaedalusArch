+import { randomUUID } from 'node:crypto';
+import { Pool, Queryable } from 'sqlwell';
+import { AuditLog } from '../../../application/ports/out/AuditLog';
+import { BookingRepository } from '../../../application/ports/out/BookingRepository';
+import { BookingUnitOfWork, RoomBookingScope } from '../../../application/ports/out/BookingUnitOfWork';
+import { Change, ChangeRecorder } from '../../../application/ports/out/ChangeRecorder';
+import { FailedRefundRepository } from '../../../application/ports/out/FailedRefundRepository';
+import { GuestRepository } from '../../../application/ports/out/GuestRepository';
+import { RoomRepository } from '../../../application/ports/out/RoomRepository';
+import { BookingError } from '../../../domain/errors/BookingError';
+import { AuditAction, AuditRecord, NewAuditRecord } from '../../../domain/model/AuditRecord';
+import { Booking } from '../../../domain/model/Booking';
+import { DateRange } from '../../../domain/model/DateRange';
+import { Guest } from '../../../domain/model/Guest';
+import { Money } from '../../../domain/model/Money';
+import { Room } from '../../../domain/model/Room';
+
+const SCHEMA = [
+  `CREATE TABLE IF NOT EXISTS rooms (
+    id text PRIMARY KEY,
+    number text NOT NULL,
+    nightly_rate_cents bigint NOT NULL,
+    capacity integer NOT NULL
+  )`,
+  `CREATE TABLE IF NOT EXISTS guests (
+    id text PRIMARY KEY,
+    name text NOT NULL,
+    email text NOT NULL
+  )`,
+  `CREATE TABLE IF NOT EXISTS bookings (
+    id text PRIMARY KEY,
+    room_id text NOT NULL REFERENCES rooms (id),
+    guest_id text NOT NULL REFERENCES guests (id),
+    check_in timestamptz NOT NULL,
+    check_out timestamptz NOT NULL,
+    total_cents bigint NOT NULL,
+    payment_ref text NOT NULL,
+    status text NOT NULL
+  )`,
+  `CREATE INDEX IF NOT EXISTS bookings_room_idx ON bookings (room_id)`,
+  `CREATE TABLE IF NOT EXISTS failed_refunds (booking_id text PRIMARY KEY)`,
+  `CREATE TABLE IF NOT EXISTS audit_records (
+    seq bigserial PRIMARY KEY,
+    booking_id text NOT NULL,
+    staff_id text NOT NULL,
+    action text NOT NULL,
+    at timestamptz NOT NULL,
+    before jsonb,
+    after jsonb
+  )`,
+  `CREATE INDEX IF NOT EXISTS audit_records_booking_idx ON audit_records (booking_id)`,
+  `CREATE INDEX IF NOT EXISTS audit_records_staff_idx ON audit_records (staff_id, at)`,
+];
+
+const SEED = [
+  `INSERT INTO rooms (id, number, nightly_rate_cents, capacity) VALUES
+    ('r-101', '101', 9000, 2), ('r-102', '102', 12000, 3), ('r-201', '201', 20000, 4)
+   ON CONFLICT (id) DO NOTHING`,
+  `INSERT INTO guests (id, name, email) VALUES ('g-1', 'Alistair', 'alistair@example.org')
+   ON CONFLICT (id) DO NOTHING`,
+];
+
+/** Pool plus one-time schema setup, shared by all Postgres adapters. */
+export class PostgresDatabase {
+  readonly pool: Pool;
+  private setup: Promise<void> | undefined;
+
+  constructor(connectionString: string) {
+    this.pool = new Pool({ connectionString });
+  }
+
+  /** Resolves once the tables exist; a failed attempt is retried by the next call. */
+  ready(): Promise<void> {
+    if (this.setup === undefined) {
+      const attempt = this.migrate();
+      this.setup = attempt;
+      attempt.catch(() => {
+        if (this.setup === attempt) this.setup = undefined;
+      });
+    }
+    return this.setup;
+  }
+
+  private async migrate(): Promise<void> {
+    await this.pool.transaction(async (tx) => {
+      // Serialise concurrent start-ups of several servers.
+      await tx.query('SELECT pg_advisory_xact_lock(727001)');
+      for (const statement of [...SCHEMA, ...SEED]) await tx.query(statement);
+    });
+  }
+}
+
+type Instant = Date | string;
+
+interface BookingRow {
+  id: string;
+  room_id: string;
+  guest_id: string;
+  check_in: Instant;
+  check_out: Instant;
+  total_cents: number | string;
+  payment_ref: string;
+  status: string;
+}
+
+const BOOKING_COLUMNS = 'id, room_id, guest_id, check_in, check_out, total_cents, payment_ref, status';
+
+function toBooking(row: BookingRow): Booking {
+  const booking = new Booking(
+    row.id,
+    row.room_id,
+    row.guest_id,
+    new DateRange(new Date(row.check_in), new Date(row.check_out)),
+    Money.ofCents(Number(row.total_cents)),
+    row.payment_ref,
+  );
+  if (row.status === 'cancelled') booking.cancel();
+  return booking;
+}
+
+async function writeChange(db: Queryable, change: Change, records: readonly NewAuditRecord[]): Promise<void> {
+  for (const record of records) {
+    if (record.staffId.trim() === '') throw new Error('Audit record needs a staff id');
+    if (Number.isNaN(record.at.getTime())) throw new Error('Audit record needs a valid time');
+  }
+  const { booking, failedRefund } = change;
+  if (booking !== undefined) {
+    // The status only moves from confirmed to cancelled, so a concurrent second cancel is rejected.
+    const result = await db.query(
+      `INSERT INTO bookings (${BOOKING_COLUMNS}) VALUES ($1, $2, $3, $4, $5, $6, $7, $8)
+       ON CONFLICT (id) DO UPDATE SET status = EXCLUDED.status
+       WHERE bookings.status <> EXCLUDED.status AND bookings.status = 'confirmed'`,
+      [
+        booking.id,
+        booking.roomId,
+        booking.guestId,
+        booking.stay.checkIn,
+        booking.stay.checkOut,
+        booking.total.cents,
+        booking.paymentRef,
+        booking.status,
+      ],
+    );
+    if (result.rowCount === 0) throw new BookingError('invalid', `Booking ${booking.id} is already cancelled`);
+  }
+  if (failedRefund !== undefined) {
+    if (failedRefund.pending) {
+      await db.query('INSERT INTO failed_refunds (booking_id) VALUES ($1) ON CONFLICT DO NOTHING', [failedRefund.bookingId]);
+    } else {
+      await db.query('DELETE FROM failed_refunds WHERE booking_id = $1', [failedRefund.bookingId]);
+    }
+  }
+  for (const record of records) {
+    await db.query(
+      'INSERT INTO audit_records (booking_id, staff_id, action, at, before, after) VALUES ($1, $2, $3, $4, $5::jsonb, $6::jsonb)',
+      [
+        record.bookingId,
+        record.staffId,
+        record.action,
+        record.at,
+        record.before === null ? null : JSON.stringify(record.before),
+        record.after === null ? null : JSON.stringify(record.after),
+      ],
+    );
+  }
+}
+
+export class PostgresRoomRepository implements RoomRepository {
+  constructor(private readonly db: PostgresDatabase) {}
+
+  async findById(id: string): Promise<Room | undefined> {
+    await this.db.ready();
+    const result = await this.db.pool.query<RoomRow>('SELECT id, number, nightly_rate_cents, capacity FROM rooms WHERE id = $1', [id]);
+    const row = result.rows[0];
+    return row === undefined ? undefined : toRoom(row);
+  }
+
+  async findAll(): Promise<Room[]> {
+    await this.db.ready();
+    const result = await this.db.pool.query<RoomRow>('SELECT id, number, nightly_rate_cents, capacity FROM rooms ORDER BY id');
+    return result.rows.map(toRoom);
+  }
+}
+
+interface RoomRow {
+  id: string;
+  number: string;
+  nightly_rate_cents: number | string;
+  capacity: number | string;
+}
+
+function toRoom(row: RoomRow): Room {
+  return new Room(row.id, row.number, Money.ofCents(Number(row.nightly_rate_cents)), Number(row.capacity));
+}
+
+export class PostgresGuestRepository implements GuestRepository {
+  constructor(private readonly db: PostgresDatabase) {}
+
+  async findById(id: string): Promise<Guest | undefined> {
+    await this.db.ready();
+    const result = await this.db.pool.query<{ id: string; name: string; email: string }>(
+      'SELECT id, name, email FROM guests WHERE id = $1',
+      [id],
+    );
+    const row = result.rows[0];
+    return row === undefined ? undefined : new Guest(row.id, row.name, row.email);
+  }
+}
+
+export class PostgresBookingRepository implements BookingRepository {
+  constructor(private readonly db: PostgresDatabase) {}
+
+  async findById(id: string): Promise<Booking | undefined> {
+    await this.db.ready();
+    const result = await this.db.pool.query<BookingRow>(`SELECT ${BOOKING_COLUMNS} FROM bookings WHERE id = $1`, [id]);
+    const row = result.rows[0];
+    return row === undefined ? undefined : toBooking(row);
+  }
+
+  async findByRoom(roomId: string): Promise<Booking[]> {
+    await this.db.ready();
+    const result = await this.db.pool.query<BookingRow>(`SELECT ${BOOKING_COLUMNS} FROM bookings WHERE room_id = $1 ORDER BY id`, [roomId]);
+    return result.rows.map(toBooking);
+  }
+
+  async findActive(): Promise<Booking[]> {
+    await this.db.ready();
+    const result = await this.db.pool.query<BookingRow>(`SELECT ${BOOKING_COLUMNS} FROM bookings WHERE status = 'confirmed' ORDER BY id`);
+    return result.rows.map(toBooking);
+  }
+
+  async save(booking: Booking): Promise<void> {
+    await this.db.ready();
+    await writeChange(this.db.pool, { booking }, []);
+  }
+
+  /** Ids must be unique across servers, so they are random rather than a counter. */
+  nextId(): string {
+    return `bk-${randomUUID()}`;
+  }
+}
+
+export class PostgresFailedRefundRepository implements FailedRefundRepository {
+  constructor(private readonly db: PostgresDatabase) {}
+
+  async add(bookingId: string): Promise<void> {
+    await this.db.ready();
+    await writeChange(this.db.pool, { failedRefund: { bookingId, pending: true } }, []);
+  }
+
+  async remove(bookingId: string): Promise<void> {
+    await this.db.ready();
+    await writeChange(this.db.pool, { failedRefund: { bookingId, pending: false } }, []);
+  }
+
+  async list(): Promise<string[]> {
+    await this.db.ready();
+    const result = await this.db.pool.query<{ booking_id: string }>('SELECT booking_id FROM failed_refunds ORDER BY booking_id');
+    return result.rows.map((r) => r.booking_id);
+  }
+}
+
+interface AuditRow {
+  seq: number | string;
+  booking_id: string;
+  staff_id: string;
+  action: string;
+  at: Instant;
+  before: Record<string, unknown> | string | null;
+  after: Record<string, unknown> | string | null;
+}
+
+function json(value: Record<string, unknown> | string | null): Record<string, unknown> | null {
+  return typeof value === 'string' ? (JSON.parse(value) as Record<string, unknown>) : value;
+}
+
+function toAuditRecord(row: AuditRow): AuditRecord {
+  return {
+    id: `au-${row.seq}`,
+    bookingId: row.booking_id,
+    staffId: row.staff_id,
+    action: row.action as AuditAction,
+    at: new Date(row.at),
+    before: json(row.before),
+    after: json(row.after),
+  };
+}
+
+const AUDIT_COLUMNS = 'seq, booking_id, staff_id, action, at, before, after';
+
+export class PostgresAuditStore implements AuditLog, ChangeRecorder {
+  constructor(private readonly db: PostgresDatabase) {}
+
+  async commit(change: Change, records: readonly NewAuditRecord[]): Promise<void> {
+    await this.db.ready();
+    await this.db.pool.transaction((tx) => writeChange(tx, change, records));
+  }
+
+  async findByBooking(bookingId: string): Promise<AuditRecord[]> {
+    await this.db.ready();
+    const result = await this.db.pool.query<AuditRow>(`SELECT ${AUDIT_COLUMNS} FROM audit_records WHERE booking_id = $1 ORDER BY seq`, [bookingId]);
+    return result.rows.map(toAuditRecord);
+  }
+
+  async findByStaff(staffId: string, from: Date, to: Date): Promise<AuditRecord[]> {
+    await this.db.ready();
+    const result = await this.db.pool.query<AuditRow>(
+      `SELECT ${AUDIT_COLUMNS} FROM audit_records WHERE staff_id = $1 AND at >= $2 AND at < $3 ORDER BY seq`,
+      [staffId, from, to],
+    );
+    return result.rows.map(toAuditRecord);
+  }
+}
+
+/** Locks the room row so bookings of one room are serialised across all servers. */
+export class PostgresBookingUnitOfWork implements BookingUnitOfWork {
+  constructor(private readonly db: PostgresDatabase) {}
+
+  async withRoom<T>(roomId: string, work: (scope: RoomBookingScope) => Promise<T>): Promise<T> {
+    await this.db.ready();
+    return this.db.pool.transaction(async (tx) => {
+      await tx.query('SELECT id FROM rooms WHERE id = $1 FOR UPDATE', [roomId]);
+      const result = await tx.query<BookingRow>(`SELECT ${BOOKING_COLUMNS} FROM bookings WHERE room_id = $1`, [roomId]);
+      return work({
+        existing: result.rows.map(toBooking),
+        commit: (change, records) => writeChange(tx, change, records),
+      });
+    });
+  }
+}
