+import { BookingUnitOfWork, RoomBookingScope } from '../../../application/ports/out/BookingUnitOfWork';
+import { BookingRepository } from '../../../application/ports/out/BookingRepository';
+import { ChangeRecorder } from '../../../application/ports/out/ChangeRecorder';
+
+/** Single-process unit of work: serialises work per room with a promise chain. */
+export class InMemoryBookingUnitOfWork implements BookingUnitOfWork {
+  /** Tail of the pending chain per room. */
+  private readonly roomLocks = new Map<string, Promise<void>>();
+
+  constructor(
+    private readonly bookings: BookingRepository,
+    private readonly recorder: ChangeRecorder,
+  ) {}
+
+  async withRoom<T>(roomId: string, work: (scope: RoomBookingScope) => Promise<T>): Promise<T> {
+    const previous = this.roomLocks.get(roomId) ?? Promise.resolve();
+    let release!: () => void;
+    const current = new Promise<void>((resolve) => {
+      release = resolve;
+    });
+    const tail = previous.then(() => current);
+    this.roomLocks.set(roomId, tail);
+    await previous;
+    try {
+      return await work({
+        existing: await this.bookings.findByRoom(roomId),
+        commit: (change, records) => this.recorder.commit(change, records),
+      });
+    } finally {
+      release();
+      if (this.roomLocks.get(roomId) === tail) this.roomLocks.delete(roomId);
+    }
+  }
+}
