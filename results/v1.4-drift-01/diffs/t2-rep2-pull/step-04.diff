@@ -0,0 +1,19 @@
+export interface OccupancyRoomRevenue {
+  roomId: string;
+  revenueCents: number;
+}
+
+export interface OccupancyNight {
+  /** The night, as an ISO date (the night starting that day). */
+  date: string;
+  roomsOccupied: number;
+  /** Rooms occupied divided by all rooms, 0..1. */
+  occupancyRate: number;
+  revenueCents: number;
+  revenueByRoom: OccupancyRoomRevenue[];
+}
+
+export interface OccupancyReport {
+  /** `from` inclusive, `to` exclusive; at most 90 nights. */
+  report(from: string, to: string): Promise<OccupancyNight[]>;
+}
diff --git a/src/application/services/OccupancyReportService.ts b/src/application/services/OccupancyReportService.ts
new file mode 100644
index 000000000..a5b2471a1
--- /dev/null
+++ b/src/application/services/OccupancyReportService.ts
@@ -0,0 +1,71 @@
+import { BookingError } from '../../domain/errors/BookingError';
+import { DateRange } from '../../domain/model/DateRange';
+import { OccupancyNight, OccupancyReport } from '../ports/in/OccupancyReport';
+import { BookingRepository } from '../ports/out/BookingRepository';
+import { RoomRepository } from '../ports/out/RoomRepository';
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const MAX_NIGHTS = 90;
+
+export class OccupancyReportService implements OccupancyReport {
+  constructor(
+    private readonly rooms: RoomRepository,
+    private readonly bookings: BookingRepository,
+  ) {}
+
+  async report(from: string, to: string): Promise<OccupancyNight[]> {
+    const range = DateRange.parse(from, to);
+    if (Number.isNaN(range.checkIn.getTime()) || Number.isNaN(range.checkOut.getTime())) {
+      throw new BookingError('invalid', 'Invalid date');
+    }
+    const nights = range.nights();
+    if (nights < 1 || nights > MAX_NIGHTS) {
+      throw new BookingError('invalid', `Range must be 1 to ${MAX_NIGHTS} nights`);
+    }
+    const start = range.checkIn.getTime();
+
+    const [rooms, active] = await Promise.all([this.rooms.findAll(), this.bookings.findActive()]);
+
+    // One pass over the bookings; each only touches the nights it shares with the range.
+    const occupied = new Array<number>(nights).fill(0);
+    const revenue = new Map<string, number[]>();
+    for (const booking of active) {
+      const stayNights = booking.stay.nights();
+      const first = Math.round((booking.stay.checkIn.getTime() - start) / DAY_MS);
+      const lo = Math.max(first, 0);
+      const hi = Math.min(first + stayNights, nights);
+      if (lo >= hi) continue;
+      let perRoom = revenue.get(booking.roomId);
+      if (perRoom === undefined) {
+        perRoom = new Array<number>(nights).fill(0);
+        revenue.set(booking.roomId, perRoom);
+      }
+      const share = booking.total.cents / stayNights;
+      for (let i = lo; i < hi; i++) {
+        occupied[i] += 1;
+        perRoom[i] += share;
+      }
+    }
+
+    const roomCount = rooms.length;
+    const result: OccupancyNight[] = [];
+    for (let i = 0; i < nights; i++) {
+      const revenueByRoom: { roomId: string; revenueCents: number }[] = [];
+      let total = 0;
+      for (const [roomId, perRoom] of revenue) {
+        const cents = Math.round(perRoom[i]);
+        if (cents === 0 && perRoom[i] === 0) continue;
+        revenueByRoom.push({ roomId, revenueCents: cents });
+        total += cents;
+      }
+      result.push({
+        date: new Date(start + i * DAY_MS).toISOString().slice(0, 10),
+        roomsOccupied: occupied[i],
+        occupancyRate: roomCount === 0 ? 0 : occupied[i] / roomCount,
+        revenueCents: total,
+        revenueByRoom,
+      });
+    }
+    return result;
+  }
+}
