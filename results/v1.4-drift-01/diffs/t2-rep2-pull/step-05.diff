diff --git a/src/adapters/outbound/persistence/PostgresBookingRepository.ts b/src/adapters/outbound/persistence/PostgresBookingRepository.ts
new file mode 100644
index 000000000..d8a780bb4
--- /dev/null
+++ b/src/adapters/outbound/persistence/PostgresBookingRepository.ts
@@ -0,0 +1,141 @@
+import { randomUUID } from 'node:crypto';
+import type { Queryable } from 'sqlwell';
+import { BookingRepository } from '../../../application/ports/out/BookingRepository';
+import { BookingError } from '../../../domain/errors/BookingError';
+import { AuditAction, AuditRecord, AuditValues } from '../../../domain/model/AuditRecord';
+import { Booking, BookingStatus } from '../../../domain/model/Booking';
+import { DateRange } from '../../../domain/model/DateRange';
+import { Money } from '../../../domain/model/Money';
+import { PostgresDatabase } from './PostgresDatabase';
+
+interface BookingRow {
+  id: string;
+  room_id: string;
+  guest_id: string;
+  check_in: Date | string;
+  check_out: Date | string;
+  total_cents: string | number;
+  payment_ref: string;
+  status: BookingStatus;
+}
+
+interface AuditRow {
+  booking_id: string;
+  staff_id: string;
+  action: AuditAction;
+  at: Date | string;
+  before: AuditValues;
+  after: AuditValues;
+}
+
+const EXCLUSION_VIOLATION = '23P01';
+
+const toBooking = (row: BookingRow): Booking =>
+  Booking.restore(
+    row.id,
+    row.room_id,
+    row.guest_id,
+    new DateRange(new Date(row.check_in), new Date(row.check_out)),
+    Money.ofCents(Number(row.total_cents)),
+    row.payment_ref,
+    row.status,
+  );
+
+const toAudit = (row: AuditRow): AuditRecord => ({
+  staffId: row.staff_id,
+  action: row.action,
+  bookingId: row.booking_id,
+  at: new Date(row.at),
+  before: row.before,
+  after: row.after,
+});
+
+/** Stores bookings in PostgreSQL; `executor` is the open transaction when used inside withExclusiveRoom. */
+export class PostgresBookingRepository implements BookingRepository {
+  constructor(
+    private readonly db: PostgresDatabase,
+    private readonly executor?: Queryable,
+  ) {}
+
+  private async run(): Promise<Queryable> {
+    await this.db.ready();
+    return this.executor ?? this.db.pool;
+  }
+
+  async findById(id: string): Promise<Booking | undefined> {
+    const result = await (await this.run()).query<BookingRow>('SELECT * FROM bookings WHERE id = $1', [id]);
+    return result.rows[0] === undefined ? undefined : toBooking(result.rows[0]);
+  }
+
+  async findByRoom(roomId: string): Promise<Booking[]> {
+    const result = await (await this.run()).query<BookingRow>('SELECT * FROM bookings WHERE room_id = $1 ORDER BY check_in', [roomId]);
+    return result.rows.map(toBooking);
+  }
+
+  async findActive(): Promise<Booking[]> {
+    const result = await (await this.run()).query<BookingRow>("SELECT * FROM bookings WHERE status = 'confirmed' ORDER BY check_in");
+    return result.rows.map(toBooking);
+  }
+
+  async save(booking: Booking, audit: readonly AuditRecord[]): Promise<void> {
+    if (this.executor === undefined) {
+      await this.db.ready();
+      return this.db.pool.transaction((tx) => new PostgresBookingRepository(this.db, tx).save(booking, audit));
+    }
+    try {
+      await this.executor.query(
+        `INSERT INTO bookings (id, room_id, guest_id, check_in, check_out, total_cents, payment_ref, status)
+         VALUES ($1, $2, $3, $4, $5, $6, $7, $8)
+         ON CONFLICT (id) DO UPDATE SET status = EXCLUDED.status`,
+        [
+          booking.id,
+          booking.roomId,
+          booking.guestId,
+          booking.stay.checkIn,
+          booking.stay.checkOut,
+          booking.total.cents,
+          booking.paymentRef,
+          booking.status,
+        ],
+      );
+    } catch (error) {
+      if ((error as { code?: string }).code === EXCLUSION_VIOLATION) {
+        throw new BookingError('unavailable', `Room ${booking.roomId} is taken for these dates`);
+      }
+      throw error;
+    }
+    for (const record of audit) {
+      await this.executor.query(
+        'INSERT INTO booking_audit (booking_id, staff_id, action, at, before, after) VALUES ($1, $2, $3, $4, $5, $6)',
+        [record.bookingId, record.staffId, record.action, record.at, JSON.stringify(record.before), JSON.stringify(record.after)],
+      );
+    }
+  }
+
+  async auditByBooking(bookingId: string): Promise<AuditRecord[]> {
+    const result = await (await this.run()).query<AuditRow>('SELECT * FROM booking_audit WHERE booking_id = $1 ORDER BY seq', [bookingId]);
+    return result.rows.map(toAudit);
+  }
+
+  async auditByStaff(staffId: string, from: Date, to: Date): Promise<AuditRecord[]> {
+    const result = await (await this.run()).query<AuditRow>(
+      'SELECT * FROM booking_audit WHERE staff_id = $1 AND at >= $2 AND at < $3 ORDER BY seq',
+      [staffId, from, to],
+    );
+    return result.rows.map(toAudit);
+  }
+
+  nextId(): string {
+    return `bk-${randomUUID()}`;
+  }
+
+  /** Locks the room's row for the length of a transaction, so servers book one room at a time. */
+  async withExclusiveRoom<T>(roomId: string, work: (bookings: BookingRepository) => Promise<T>): Promise<T> {
+    await this.db.ready();
+    if (this.executor !== undefined) return work(this);
+    return this.db.pool.transaction(async (tx) => {
+      await tx.query('SELECT id FROM rooms WHERE id = $1 FOR UPDATE', [roomId]);
+      return work(new PostgresBookingRepository(this.db, tx));
+    });
+  }
+}
diff --git a/src/adapters/outbound/persistence/PostgresDatabase.ts b/src/adapters/outbound/persistence/PostgresDatabase.ts
new file mode 100644
index 000000000..47ef5bb55
--- /dev/null
+++ b/src/adapters/outbound/persistence/PostgresDatabase.ts
@@ -0,0 +1,74 @@
+import { Pool } from 'sqlwell';
+
+const SCHEMA = [
+  'CREATE EXTENSION IF NOT EXISTS btree_gist',
+  `CREATE TABLE IF NOT EXISTS rooms (
+    id text PRIMARY KEY,
+    number text NOT NULL,
+    nightly_rate_cents bigint NOT NULL,
+    capacity integer NOT NULL
+  )`,
+  `CREATE TABLE IF NOT EXISTS guests (
+    id text PRIMARY KEY,
+    name text NOT NULL,
+    email text NOT NULL
+  )`,
+  `CREATE TABLE IF NOT EXISTS bookings (
+    id text PRIMARY KEY,
+    room_id text NOT NULL REFERENCES rooms (id),
+    guest_id text NOT NULL REFERENCES guests (id),
+    check_in timestamptz NOT NULL,
+    check_out timestamptz NOT NULL,
+    total_cents bigint NOT NULL,
+    payment_ref text NOT NULL,
+    status text NOT NULL,
+    CHECK (check_out > check_in),
+    CONSTRAINT bookings_no_overlap EXCLUDE USING gist (
+      room_id WITH =,
+      tstzrange(check_in, check_out) WITH &&
+    ) WHERE (status = 'confirmed')
+  )`,
+  'CREATE INDEX IF NOT EXISTS bookings_room_idx ON bookings (room_id)',
+  `CREATE TABLE IF NOT EXISTS booking_audit (
+    seq bigserial PRIMARY KEY,
+    booking_id text NOT NULL,
+    staff_id text NOT NULL,
+    action text NOT NULL,
+    at timestamptz NOT NULL,
+    before jsonb,
+    after jsonb
+  )`,
+  'CREATE INDEX IF NOT EXISTS booking_audit_booking_idx ON booking_audit (booking_id)',
+  'CREATE INDEX IF NOT EXISTS booking_audit_staff_idx ON booking_audit (staff_id, at)',
+  `INSERT INTO rooms (id, number, nightly_rate_cents, capacity) VALUES
+    ('r-101', '101', 9000, 2), ('r-102', '102', 12000, 3), ('r-201', '201', 20000, 4)
+    ON CONFLICT (id) DO NOTHING`,
+  `INSERT INTO guests (id, name, email) VALUES ('g-1', 'Alistair', 'alistair@example.org')
+    ON CONFLICT (id) DO NOTHING`,
+];
+
+/** The hotel's PostgreSQL database: one pool, and the schema created on first use. */
+export class PostgresDatabase {
+  readonly pool: Pool;
+  private schema: Promise<void> | undefined;
+
+  constructor(connectionString: string) {
+    this.pool = new Pool({ connectionString });
+  }
+
+  /** Resolves once the schema exists; safe to call from several servers starting together. */
+  ready(): Promise<void> {
+    if (this.schema === undefined) {
+      this.schema = this.pool
+        .transaction(async (tx) => {
+          await tx.query('SELECT pg_advisory_xact_lock(727001)');
+          for (const statement of SCHEMA) await tx.query(statement);
+        })
+        .catch((error: unknown) => {
+          this.schema = undefined;
+          throw error;
+        });
+    }
+    return this.schema;
+  }
+}
