@@ -0,0 +1,17 @@
+import { FailedRefundRepository } from '../../../application/ports/out/FailedRefundRepository';
+
+export class InMemoryFailedRefundRepository implements FailedRefundRepository {
+  private readonly bookingIds = new Set<string>();
+
+  async add(bookingId: string): Promise<void> {
+    this.bookingIds.add(bookingId);
+  }
+
+  async remove(bookingId: string): Promise<void> {
+    this.bookingIds.delete(bookingId);
+  }
+
+  async list(): Promise<string[]> {
+    return [...this.bookingIds];
+  }
+}
