@@ -0,0 +1,28 @@
+import { BookingError } from '../../domain/errors/BookingError';
+import { AuditRecord } from '../../domain/model/AuditRecord';
+import { AuditTrail } from '../ports/in/AuditTrail';
+import { AuditLog } from '../ports/out/AuditLog';
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+export class AuditTrailService implements AuditTrail {
+  constructor(private readonly log: AuditLog) {}
+
+  forBooking(bookingId: string): Promise<AuditRecord[]> {
+    return this.log.findByBooking(bookingId);
+  }
+
+  async byStaff(staffId: string, from: string, to: string): Promise<AuditRecord[]> {
+    const start = this.parse(from, 'from');
+    const last = this.parse(to, 'to');
+    const end = new Date(last.getTime() + (/^\d{4}-\d{2}-\d{2}$/.test(to) ? DAY_MS : 1));
+    if (end <= start) throw new BookingError('invalid', '"to" must not be before "from"');
+    return this.log.findByStaff(staffId, start, end);
+  }
+
+  private parse(value: string, name: string): Date {
+    const date = new Date(value);
+    if (Number.isNaN(date.getTime())) throw new BookingError('invalid', `Invalid ${name} date: ${value}`);
+    return date;
+  }
+}
