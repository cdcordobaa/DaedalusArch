+export type AuditAction = 'booking' | 'cancellation' | 'charge' | 'refund';
+
+/** Plain-data copy of a booking's state, so later mutation of the booking never alters a record. */
+export interface BookingSnapshot {
+  id: string;
+  roomId: string;
+  guestId: string;
+  checkIn: string;
+  checkOut: string;
+  totalCents: number;
+  paymentRef: string;
+  status: string;
+  refundPending: boolean;
+}
+
+export interface AuditRecord {
+  readonly id: string;
+  readonly staffId: string;
+  readonly action: AuditAction;
+  readonly bookingId: string;
+  readonly at: Date;
+  /** Null when the booking did not exist before the change. */
+  readonly before: BookingSnapshot | null;
+  readonly after: BookingSnapshot;
+}
+
+/** What a booking records about a change; the repository assigns the id when persisting it as an AuditRecord. */
+export type AuditEvent = Omit<AuditRecord, 'id'>;
+
+export const DEFAULT_STAFF_ID = 'guest';
