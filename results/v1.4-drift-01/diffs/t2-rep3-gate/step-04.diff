@@ -0,0 +1,20 @@
+import { OccupancyReport } from '../../../application/ports/in/OccupancyReport';
+import { BookingError } from '../../../domain/errors/BookingError';
+import { HttpRequest, HttpResponse } from './HttpTypes';
+
+/** Driving adapter for the revenue manager's reports. */
+export class ReportController {
+  constructor(private readonly occupancyReport: OccupancyReport) {}
+
+  /** Occupancy and revenue per night (query: from, to; `to` exclusive, max 90 nights). */
+  async occupancy(request: HttpRequest): Promise<HttpResponse> {
+    try {
+      const { from, to } = request.query;
+      if (from === undefined || to === undefined) throw new BookingError('invalid', 'from and to are required');
+      return { status: 200, body: await this.occupancyReport.report(from, to) };
+    } catch (error) {
+      if (error instanceof BookingError && error.reason === 'invalid') return { status: 400, body: { error: error.message } };
+      return { status: 500, body: { error: 'Internal error' } };
+    }
+  }
+}
