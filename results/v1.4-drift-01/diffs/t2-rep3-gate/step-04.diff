--- /dev/null
+++ b/src/application/services/OccupancyReportService.ts
@@ -0,0 +1,62 @@
+import { BookingError } from '../../domain/errors/BookingError';
+import { OccupancyReport, NightReport } from '../ports/in/OccupancyReport';
+import { BookingRepository } from '../ports/out/BookingRepository';
+import { RoomRepository } from '../ports/out/RoomRepository';
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const MAX_NIGHTS = 90;
+
+export class OccupancyReportService implements OccupancyReport {
+  constructor(
+    private readonly rooms: RoomRepository,
+    private readonly bookings: BookingRepository,
+  ) {}
+
+  async report(from: string, to: string): Promise<NightReport[]> {
+    const first = this.parseDay(from, 'from');
+    const end = this.parseDay(to, 'to');
+    const count = end - first;
+    if (count < 1) throw new BookingError('invalid', '"to" must be after "from"');
+    if (count > MAX_NIGHTS) throw new BookingError('invalid', `Range is limited to ${MAX_NIGHTS} nights`);
+
+    const [rooms, active] = await Promise.all([this.rooms.findAll(), this.bookings.findActive()]);
+    const nights: NightReport[] = Array.from({ length: count }, (_, i) => ({
+      date: new Date((first + i) * DAY_MS).toISOString().slice(0, 10),
+      roomsOccupied: 0,
+      occupancyRate: 0,
+      revenueCents: 0,
+      rooms: [],
+    }));
+
+    // One pass over the bookings, touching only the nights each overlaps with the range.
+    for (const booking of active) {
+      const checkIn = Math.floor(booking.stay.checkIn.getTime() / DAY_MS);
+      const stayNights = Math.max(1, Math.floor(booking.stay.checkOut.getTime() / DAY_MS) - checkIn);
+      const lo = Math.max(checkIn, first);
+      const hi = Math.min(checkIn + stayNights, end);
+      if (lo >= hi) continue;
+      // Even split in whole cents; the remainder goes to the earliest nights so the parts sum to the total.
+      const base = Math.floor(booking.total.cents / stayNights);
+      const extra = booking.total.cents - base * stayNights;
+      for (let day = lo; day < hi; day += 1) {
+        const night = nights[day - first]!;
+        const cents = base + (day - checkIn < extra ? 1 : 0);
+        night.roomsOccupied += 1;
+        night.revenueCents += cents;
+        night.rooms.push({ roomId: booking.roomId, occupied: true, revenueCents: cents });
+      }
+    }
+
+    for (const night of nights) {
+      night.occupancyRate = rooms.length === 0 ? 0 : night.roomsOccupied / rooms.length;
+    }
+    return nights;
+  }
+
+  /** Day number since the epoch (UTC) of an ISO date or timestamp. */
+  private parseDay(value: string, name: string): number {
+    const time = new Date(value).getTime();
+    if (Number.isNaN(time)) throw new BookingError('invalid', `Invalid ${name} date: ${value}`);
+    return Math.floor(time / DAY_MS);
+  }
+}
