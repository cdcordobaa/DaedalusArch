diff --git a/src/adapters/outbound/persistence/PostgresBookingRepository.ts b/src/adapters/outbound/persistence/PostgresBookingRepository.ts
new file mode 100644
index 000000000..648f6c3b1
--- /dev/null
+++ b/src/adapters/outbound/persistence/PostgresBookingRepository.ts
@@ -0,0 +1,149 @@
+import { randomUUID } from 'node:crypto';
+import { Queryable } from 'sqlwell';
+import { AuditLog } from '../../../application/ports/out/AuditLog';
+import { BookingRepository } from '../../../application/ports/out/BookingRepository';
+import { AuditRecord, BookingSnapshot } from '../../../domain/model/AuditRecord';
+import { Booking, BookingStatus } from '../../../domain/model/Booking';
+import { DateRange } from '../../../domain/model/DateRange';
+import { Money } from '../../../domain/model/Money';
+import { PostgresDatabase, parseJson, toDate } from './PostgresDatabase';
+
+interface BookingRow {
+  id: string;
+  room_id: string;
+  guest_id: string;
+  check_in: Date | string;
+  check_out: Date | string;
+  total_cents: string | number;
+  payment_ref: string;
+  status: string;
+  refund_pending: boolean;
+}
+
+interface AuditRow {
+  seq: string | number;
+  booking_id: string;
+  staff_id: string;
+  action: AuditRecord['action'];
+  at: Date | string;
+  before_state: unknown;
+  after_state: unknown;
+}
+
+function toBooking(row: BookingRow): Booking {
+  return Booking.restore(
+    {
+      id: row.id,
+      roomId: row.room_id,
+      guestId: row.guest_id,
+      stay: new DateRange(toDate(row.check_in), toDate(row.check_out)),
+      total: Money.ofCents(Number(row.total_cents)),
+      paymentRef: row.payment_ref,
+    },
+    row.status as BookingStatus,
+    row.refund_pending,
+  );
+}
+
+function toAuditRecord(row: AuditRow): AuditRecord {
+  return {
+    id: `au-${row.seq}`,
+    staffId: row.staff_id,
+    action: row.action,
+    bookingId: row.booking_id,
+    at: toDate(row.at),
+    before: row.before_state === null ? null : parseJson<BookingSnapshot>(row.before_state),
+    after: parseJson<BookingSnapshot>(row.after_state),
+  };
+}
+
+/** Writes the booking row and its pending audit events through `db`, which must be a transaction. */
+async function writeBooking(db: Queryable, booking: Booking): Promise<void> {
+  const s = booking.snapshot();
+  await db.query(
+    `INSERT INTO bookings (id, room_id, guest_id, check_in, check_out, total_cents, payment_ref, status, refund_pending)
+     VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9)
+     ON CONFLICT (id) DO UPDATE SET status = EXCLUDED.status, refund_pending = EXCLUDED.refund_pending`,
+    [s.id, s.roomId, s.guestId, s.checkIn, s.checkOut, s.totalCents, s.paymentRef, s.status, s.refundPending],
+  );
+  for (const event of booking.pullAuditEvents()) {
+    await db.query(
+      `INSERT INTO audit_records (booking_id, staff_id, action, at, before_state, after_state)
+       VALUES ($1, $2, $3, $4, $5::jsonb, $6::jsonb)`,
+      [
+        event.bookingId,
+        event.staffId,
+        event.action,
+        event.at.toISOString(),
+        event.before === null ? null : JSON.stringify(event.before),
+        JSON.stringify(event.after),
+      ],
+    );
+  }
+}
+
+export class PostgresBookingRepository implements BookingRepository, AuditLog {
+  constructor(private readonly db: PostgresDatabase) {}
+
+  async findById(id: string): Promise<Booking | undefined> {
+    const pool = await this.db.ready();
+    const result = await pool.query<BookingRow>('SELECT * FROM bookings WHERE id = $1', [id]);
+    const row = result.rows[0];
+    return row === undefined ? undefined : toBooking(row);
+  }
+
+  async findByRoom(roomId: string): Promise<Booking[]> {
+    const pool = await this.db.ready();
+    const result = await pool.query<BookingRow>('SELECT * FROM bookings WHERE room_id = $1 ORDER BY check_in', [roomId]);
+    return result.rows.map(toBooking);
+  }
+
+  async findActive(): Promise<Booking[]> {
+    const pool = await this.db.ready();
+    const result = await pool.query<BookingRow>(`SELECT * FROM bookings WHERE status = 'confirmed' ORDER BY id`);
+    return result.rows.map(toBooking);
+  }
+
+  async findRefundPending(): Promise<Booking[]> {
+    const pool = await this.db.ready();
+    const result = await pool.query<BookingRow>('SELECT * FROM bookings WHERE refund_pending ORDER BY id');
+    return result.rows.map(toBooking);
+  }
+
+  async save(booking: Booking): Promise<void> {
+    const pool = await this.db.ready();
+    await pool.transaction((tx) => writeBooking(tx, booking));
+  }
+
+  async createExclusive(roomId: string, create: (existing: Booking[]) => Promise<Booking>): Promise<Booking> {
+    const pool = await this.db.ready();
+    return pool.transaction(async (tx) => {
+      // The row lock serialises creations for this room across all servers sharing the database;
+      // it is released when the transaction ends, so the check and the insert cannot interleave.
+      await tx.query('SELECT id FROM rooms WHERE id = $1 FOR UPDATE', [roomId]);
+      const existing = await tx.query<BookingRow>('SELECT * FROM bookings WHERE room_id = $1', [roomId]);
+      const booking = await create(existing.rows.map(toBooking));
+      await writeBooking(tx, booking);
+      return booking;
+    });
+  }
+
+  async findByBooking(bookingId: string): Promise<AuditRecord[]> {
+    const pool = await this.db.ready();
+    const result = await pool.query<AuditRow>('SELECT * FROM audit_records WHERE booking_id = $1 ORDER BY seq', [bookingId]);
+    return result.rows.map(toAuditRecord);
+  }
+
+  async findByStaff(staffId: string, from: Date, to: Date): Promise<AuditRecord[]> {
+    const pool = await this.db.ready();
+    const result = await pool.query<AuditRow>(
+      'SELECT * FROM audit_records WHERE staff_id = $1 AND at >= $2 AND at < $3 ORDER BY seq',
+      [staffId, from.toISOString(), to.toISOString()],
+    );
+    return result.rows.map(toAuditRecord);
+  }
+
+  nextId(): string {
+    return `bk-${randomUUID()}`;
+  }
+}
diff --git a/src/adapters/outbound/persistence/PostgresDatabase.ts b/src/adapters/outbound/persistence/PostgresDatabase.ts
new file mode 100644
index 000000000..6dd563278
--- /dev/null
+++ b/src/adapters/outbound/persistence/PostgresDatabase.ts
@@ -0,0 +1,84 @@
+import { Pool } from 'sqlwell';
+
+const SCHEMA = [
+  `CREATE TABLE IF NOT EXISTS rooms (
+    id text PRIMARY KEY,
+    number text NOT NULL,
+    nightly_rate_cents bigint NOT NULL,
+    capacity integer NOT NULL
+  )`,
+  `CREATE TABLE IF NOT EXISTS guests (
+    id text PRIMARY KEY,
+    name text NOT NULL,
+    email text NOT NULL
+  )`,
+  `CREATE TABLE IF NOT EXISTS bookings (
+    id text PRIMARY KEY,
+    room_id text NOT NULL REFERENCES rooms (id),
+    guest_id text NOT NULL REFERENCES guests (id),
+    check_in timestamptz NOT NULL,
+    check_out timestamptz NOT NULL,
+    total_cents bigint NOT NULL,
+    payment_ref text NOT NULL,
+    status text NOT NULL,
+    refund_pending boolean NOT NULL
+  )`,
+  `CREATE INDEX IF NOT EXISTS bookings_room_idx ON bookings (room_id)`,
+  `CREATE TABLE IF NOT EXISTS audit_records (
+    seq bigserial PRIMARY KEY,
+    booking_id text NOT NULL,
+    staff_id text NOT NULL,
+    action text NOT NULL,
+    at timestamptz NOT NULL,
+    before_state jsonb,
+    after_state jsonb NOT NULL
+  )`,
+  `CREATE INDEX IF NOT EXISTS audit_records_booking_idx ON audit_records (booking_id)`,
+  `CREATE INDEX IF NOT EXISTS audit_records_staff_idx ON audit_records (staff_id, at)`,
+  `INSERT INTO rooms (id, number, nightly_rate_cents, capacity) VALUES
+    ('r-101', '101', 9000, 2),
+    ('r-102', '102', 12000, 3),
+    ('r-201', '201', 20000, 4)
+   ON CONFLICT (id) DO NOTHING`,
+  `INSERT INTO guests (id, name, email) VALUES ('g-1', 'Alistair', 'alistair@example.org')
+   ON CONFLICT (id) DO NOTHING`,
+];
+
+/** Shared sqlwell pool; creates the schema (and seed rows) once, safely when several servers start together. */
+export class PostgresDatabase {
+  readonly pool: Pool;
+  private initialised: Promise<void> | undefined;
+
+  constructor(connectionString: string) {
+    this.pool = new Pool({ connectionString });
+  }
+
+  static fromEnv(env: NodeJS.ProcessEnv = process.env): PostgresDatabase | undefined {
+    const url = env['DATABASE_URL'];
+    return url ? new PostgresDatabase(url) : undefined;
+  }
+
+  /** Resolves when the schema exists; a failed attempt is retried by the next caller. */
+  ready(): Promise<Pool> {
+    if (this.initialised === undefined) {
+      this.initialised = this.pool
+        .transaction(async (tx) => {
+          await tx.query('SELECT pg_advisory_xact_lock(7301001)');
+          for (const statement of SCHEMA) await tx.query(statement);
+        })
+        .catch((error: unknown) => {
+          this.initialised = undefined;
+          throw error;
+        });
+    }
+    return this.initialised.then(() => this.pool);
+  }
+}
+
+export function toDate(value: unknown): Date {
+  return value instanceof Date ? value : new Date(String(value));
+}
+
+export function parseJson<T>(value: unknown): T {
+  return (typeof value === 'string' ? JSON.parse(value) : value) as T;
+}
