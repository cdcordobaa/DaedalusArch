diff --git a/src/application/services/ListAuditService.ts b/src/application/services/ListAuditService.ts
new file mode 100644
index 000000000..fd2243098
--- /dev/null
+++ b/src/application/services/ListAuditService.ts
@@ -0,0 +1,41 @@
+import { BookingError } from '../../domain/errors/BookingError';
+import { AuditRecord } from '../../domain/model/AuditRecord';
+import { AuditRecordView, ListAudit } from '../ports/in/ListAudit';
+import { AuditLog } from '../ports/out/AuditLog';
+
+const DATE_ONLY = /^\d{4}-\d{2}-\d{2}$/;
+
+function parseInstant(text: string, label: string): Date {
+  const date = new Date(text);
+  if (Number.isNaN(date.getTime())) throw new BookingError('invalid', `${label} is not a valid date: ${text}`);
+  return date;
+}
+
+function toView(record: AuditRecord): AuditRecordView {
+  return {
+    id: record.id,
+    bookingId: record.bookingId,
+    staffId: record.staffId,
+    action: record.action,
+    at: record.at.toISOString(),
+    before: record.before === null ? null : { ...record.before },
+    after: record.after === null ? null : { ...record.after },
+  };
+}
+
+export class ListAuditService implements ListAudit {
+  constructor(private readonly audit: AuditLog) {}
+
+  async forBooking(bookingId: string): Promise<AuditRecordView[]> {
+    return (await this.audit.findByBooking(bookingId)).map(toView);
+  }
+
+  async forStaff(staffId: string, from: string, to: string): Promise<AuditRecordView[]> {
+    const start = parseInstant(from, 'from');
+    const end = parseInstant(to, 'to');
+    if (DATE_ONLY.test(to)) end.setUTCDate(end.getUTCDate() + 1);
+    else end.setTime(end.getTime() + 1);
+    if (end <= start) throw new BookingError('invalid', 'to must not be before from');
+    return (await this.audit.findByStaff(staffId, start, end)).map(toView);
+  }
+}
