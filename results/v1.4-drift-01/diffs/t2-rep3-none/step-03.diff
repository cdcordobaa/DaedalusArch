+/** Staff user from the X-Staff-Id header, or 'guest' when it is absent or blank. */
+export function staffIdOf(request: HttpRequest): string {
+  const headers = request.headers ?? {};
+  const key = Object.keys(headers).find((k) => k.toLowerCase() === 'x-staff-id');
