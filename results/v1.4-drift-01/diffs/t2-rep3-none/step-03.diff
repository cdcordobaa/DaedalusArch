@@ -0,0 +1,28 @@
+import { AuditLog } from '../../../application/ports/out/AuditLog';
+import { AuditRecord, NewAuditRecord } from '../../../domain/model/AuditRecord';
+
+export class InMemoryAuditLog implements AuditLog {
+  private readonly records: AuditRecord[] = [];
+
+  /** Appends all records or none; used by the booking repository inside its atomic save. */
+  appendAll(entries: readonly NewAuditRecord[]): void {
+    const stamped = entries.map((entry, i) =>
+      Object.freeze({
+        ...entry,
+        id: `au-${this.records.length + i + 1}`,
+        at: new Date(entry.at.getTime()),
+        before: entry.before === null ? null : Object.freeze({ ...entry.before }),
+        after: entry.after === null ? null : Object.freeze({ ...entry.after }),
+      }),
+    );
+    this.records.push(...stamped);
+  }
+
+  async findByBooking(bookingId: string): Promise<AuditRecord[]> {
+    return this.records.filter((r) => r.bookingId === bookingId);
+  }
+
+  async findByStaff(staffId: string, from: Date, to: Date): Promise<AuditRecord[]> {
+    return this.records.filter((r) => r.staffId === staffId && r.at >= from && r.at < to);
+  }
+}
