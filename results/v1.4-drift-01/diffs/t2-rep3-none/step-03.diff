+export type AuditAction = 'book' | 'charge' | 'cancel' | 'refund';
+
+export type AuditSnapshot = Readonly<Record<string, string | number | boolean>>;
+
+/** Immutable entry saying who did what to which booking, when, and how the values changed. */
+export interface AuditRecord {
+  readonly id: string;
+  readonly bookingId: string;
+  readonly staffId: string;
+  readonly action: AuditAction;
+  readonly at: Date;
+  readonly before: AuditSnapshot | null;
+  readonly after: AuditSnapshot | null;
+}
+
+export type NewAuditRecord = Omit<AuditRecord, 'id'>;
+
+export const DEFAULT_STAFF_ID = 'guest';
