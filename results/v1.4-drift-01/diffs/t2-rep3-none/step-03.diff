+    totalCents: booking.total.cents,
+    checkIn: booking.stay.checkIn.toISOString(),
+    checkOut: booking.stay.checkOut.toISOString(),
+  };
+}
+
+export function paymentSnapshot(booking: Booking): AuditSnapshot {
+  return { paymentRef: booking.paymentRef, amountCents: booking.total.cents, refundPending: booking.isRefundPending };
+}
