+import { ListAudit } from '../../../application/ports/in/ListAudit';
+import { BookingError } from '../../../domain/errors/BookingError';
+import { HttpRequest, HttpResponse } from './HttpTypes';
+
+/** Staff-facing queries over the audit trail. */
+export class AuditController {
+  constructor(private readonly listAudit: ListAudit) {}
+
+  /** GET /bookings/:id/audit */
+  async forBooking(request: HttpRequest): Promise<HttpResponse> {
+    return this.respond(() => this.listAudit.forBooking(String(request.params['id'])));
+  }
+
+  /** GET /staff/:id/audit?from=&to= */
+  async forStaff(request: HttpRequest): Promise<HttpResponse> {
+    const { from, to } = request.query;
+    if (!from || !to) return { status: 400, body: { error: 'from and to are required' } };
+    return this.respond(() => this.listAudit.forStaff(String(request.params['id']), from, to));
+  }
+
+  private async respond(query: () => Promise<unknown>): Promise<HttpResponse> {
+    try {
+      return { status: 200, body: await query() };
+    } catch (error) {
+      if (error instanceof BookingError) return { status: 400, body: { error: error.message } };
+      return { status: 500, body: { error: 'Internal error' } };
+    }
+  }
+}
