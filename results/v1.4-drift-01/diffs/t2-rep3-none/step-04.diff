index 000000000..7b2e87cc1
--- /dev/null
+++ b/src/application/services/OccupancyReportService.ts
@@ -0,0 +1,83 @@
+import { BookingError } from '../../domain/errors/BookingError';
+import { OccupancyNightView, OccupancyReport, OccupancyReportView, RoomNightFigures } from '../ports/in/OccupancyReport';
+import { BookingRepository } from '../ports/out/BookingRepository';
+import { RoomRepository } from '../ports/out/RoomRepository';
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const MAX_NIGHTS = 90;
+const DATE_ONLY = /^\d{4}-\d{2}-\d{2}$/;
+
+function parseDay(text: string, label: string): number {
+  const time = DATE_ONLY.test(text) ? new Date(text).getTime() : NaN;
+  if (Number.isNaN(time)) throw new BookingError('invalid', `${label} must be a date as YYYY-MM-DD: ${text}`);
+  return time;
+}
+
+function utcDayStart(date: Date): number {
+  return Math.floor(date.getTime() / DAY_MS) * DAY_MS;
+}
+
+export class OccupancyReportService implements OccupancyReport {
+  constructor(
+    private readonly rooms: RoomRepository,
+    private readonly bookings: BookingRepository,
+  ) {}
+
+  async report(from: string, to: string): Promise<OccupancyReportView> {
+    const start = parseDay(from, 'from');
+    const end = parseDay(to, 'to');
+    const nights = Math.round((end - start) / DAY_MS);
+    if (nights < 1) throw new BookingError('invalid', 'to must be after from');
+    if (nights > MAX_NIGHTS) throw new BookingError('invalid', `The range may span at most ${MAX_NIGHTS} nights`);
+
+    const rooms = await this.rooms.findAll();
+    const index = new Map<string, number>();
+    rooms.forEach((room, i) => index.set(room.id, i));
+
+    // Both indexed [room * nights + night]; occupied marks nights covered by an active booking.
+    const revenue = new Float64Array(rooms.length * nights);
+    const occupied = new Uint8Array(rooms.length * nights);
+
+    // One pass over the active bookings, touching only the nights that fall inside the range.
+    for (const booking of await this.bookings.findActive()) {
+      const room = index.get(booking.roomId);
+      if (room === undefined) continue;
+      const stayNights = booking.stay.nights();
+      const first = utcDayStart(booking.stay.checkIn);
+      const offset = Math.round((first - start) / DAY_MS);
+      const lo = Math.max(0, -offset);
+      const hi = Math.min(stayNights, nights - offset);
+      if (lo >= hi) continue;
+      // Spread the total in whole cents: the first (total % nights) nights carry one extra cent.
+      const base = Math.floor(booking.total.cents / stayNights);
+      const extra = booking.total.cents % stayNights;
+      for (let k = lo; k < hi; k++) {
+        const cell = room * nights + offset + k;
+        occupied[cell] = 1;
+        revenue[cell] += base + (k < extra ? 1 : 0);
+      }
+    }
+
+    const result: OccupancyNightView[] = [];
+    for (let n = 0; n < nights; n++) {
+      const perRoom: Record<string, RoomNightFigures> = {};
+      let roomsOccupied = 0;
+      let revenueCents = 0;
+      rooms.forEach((room, r) => {
+        const cell = r * nights + n;
+        const isOccupied = occupied[cell] === 1;
+        if (isOccupied) roomsOccupied += 1;
+        revenueCents += revenue[cell] ?? 0;
+        perRoom[room.id] = { occupied: isOccupied, revenueCents: revenue[cell] ?? 0 };
+      });
+      result.push({
+        date: new Date(start + n * DAY_MS).toISOString().slice(0, 10),
+        roomsOccupied,
+        occupancyRate: rooms.length === 0 ? 0 : roomsOccupied / rooms.length,
+        revenueCents,
+        rooms: perRoom,
+      });
+    }
+    return { from, to, totalRooms: rooms.length, nights: result };
+  }
+}
