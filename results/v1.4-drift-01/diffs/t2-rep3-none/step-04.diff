@@ -0,0 +1,27 @@
+export interface RoomNightFigures {
+  occupied: boolean;
+  revenueCents: number;
+}
+
+export interface OccupancyNightView {
+  /** The night's date (UTC), YYYY-MM-DD. */
+  date: string;
+  roomsOccupied: number;
+  /** Occupied rooms divided by all rooms, 0..1. */
+  occupancyRate: number;
+  revenueCents: number;
+  rooms: Record<string, RoomNightFigures>;
+}
+
+export interface OccupancyReportView {
+  from: string;
+  to: string;
+  totalRooms: number;
+  nights: OccupancyNightView[];
+}
+
+/** Driving port: occupancy and revenue per night over a range of up to 90 nights. */
+export interface OccupancyReport {
+  /** `from` is the first night, `to` the day after the last night (like check-in / check-out). */
+  report(from: string, to: string): Promise<OccupancyReportView>;
+}
diff --git a/src/application/services/OccupancyReportService.ts b/src/application/services/OccupancyReportService.ts
