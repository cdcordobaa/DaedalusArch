+import { GuestRepository } from '../../../application/ports/out/GuestRepository';
+import { RoomRepository } from '../../../application/ports/out/RoomRepository';
+import { Guest } from '../../../domain/model/Guest';
+import { Money } from '../../../domain/model/Money';
+import { Room } from '../../../domain/model/Room';
+import { PostgresDatabase } from './PostgresDatabase';
+
+interface RoomRow {
+  id: string;
+  number: string;
+  nightly_rate_cents: string | number;
+  capacity: number;
+}
+
+interface GuestRow {
+  id: string;
+  name: string;
+  email: string;
+}
+
+export function toRoom(row: RoomRow): Room {
+  return new Room(row.id, row.number, Money.ofCents(Number(row.nightly_rate_cents)), Number(row.capacity));
+}
+
+export class PostgresRoomRepository implements RoomRepository {
+  constructor(private readonly db: PostgresDatabase) {}
+
+  async findById(id: string): Promise<Room | undefined> {
+    await this.db.ready();
+    const result = await this.db.pool.query<RoomRow>('SELECT * FROM rooms WHERE id = $1', [id]);
+    const row = result.rows[0];
+    return row === undefined ? undefined : toRoom(row);
+  }
+
+  async findAll(): Promise<Room[]> {
+    await this.db.ready();
+    const result = await this.db.pool.query<RoomRow>('SELECT * FROM rooms ORDER BY number');
+    return result.rows.map(toRoom);
+  }
+}
+
+export class PostgresGuestRepository implements GuestRepository {
+  constructor(private readonly db: PostgresDatabase) {}
+
+  async findById(id: string): Promise<Guest | undefined> {
+    await this.db.ready();
+    const result = await this.db.pool.query<GuestRow>('SELECT * FROM guests WHERE id = $1', [id]);
+    const row = result.rows[0];
+    return row === undefined ? undefined : new Guest(row.id, row.name, row.email);
+  }
+}
