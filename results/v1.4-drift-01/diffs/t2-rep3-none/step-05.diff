diff --git a/src/adapters/outbound/persistence/PostgresBookingRepository.ts b/src/adapters/outbound/persistence/PostgresBookingRepository.ts
new file mode 100644
index 000000000..4f1c0a334
--- /dev/null
+++ b/src/adapters/outbound/persistence/PostgresBookingRepository.ts
@@ -0,0 +1,173 @@
+import { randomUUID } from 'node:crypto';
+import { Queryable } from 'sqlwell';
+import { AuditLog } from '../../../application/ports/out/AuditLog';
+import { BookingRepository } from '../../../application/ports/out/BookingRepository';
+import { AuditAction, AuditRecord, AuditSnapshot, NewAuditRecord } from '../../../domain/model/AuditRecord';
+import { Booking, BookingStatus } from '../../../domain/model/Booking';
+import { DateRange } from '../../../domain/model/DateRange';
+import { Money } from '../../../domain/model/Money';
+import { PostgresDatabase } from './PostgresDatabase';
+
+interface BookingRow {
+  id: string;
+  room_id: string;
+  guest_id: string;
+  check_in: Date | string;
+  check_out: Date | string;
+  total_cents: string | number;
+  payment_ref: string;
+  status: BookingStatus;
+  refund_pending: boolean;
+}
+
+interface AuditRow {
+  id: string | number;
+  booking_id: string;
+  staff_id: string;
+  action: AuditAction;
+  at: Date | string;
+  before: AuditSnapshot | null;
+  after: AuditSnapshot | null;
+}
+
+function toBooking(row: BookingRow): Booking {
+  return Booking.restore(
+    row.id,
+    row.room_id,
+    row.guest_id,
+    new DateRange(new Date(row.check_in), new Date(row.check_out)),
+    Money.ofCents(Number(row.total_cents)),
+    row.payment_ref,
+    row.status,
+    row.refund_pending,
+  );
+}
+
+function toAuditRecord(row: AuditRow): AuditRecord {
+  return Object.freeze({
+    id: `au-${row.id}`,
+    bookingId: row.booking_id,
+    staffId: row.staff_id,
+    action: row.action,
+    at: new Date(row.at),
+    before: row.before === null ? null : Object.freeze({ ...row.before }),
+    after: row.after === null ? null : Object.freeze({ ...row.after }),
+  });
+}
+
+async function upsertBooking(db: Queryable, booking: Booking): Promise<void> {
+  await db.query(
+    `INSERT INTO bookings (id, room_id, guest_id, check_in, check_out, total_cents, payment_ref, status, refund_pending)
+     VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9)
+     ON CONFLICT (id) DO UPDATE SET status = EXCLUDED.status, refund_pending = EXCLUDED.refund_pending`,
+    [
+      booking.id,
+      booking.roomId,
+      booking.guestId,
+      booking.stay.checkIn,
+      booking.stay.checkOut,
+      booking.total.cents,
+      booking.paymentRef,
+      booking.status,
+      booking.isRefundPending,
+    ],
+  );
+}
+
+async function insertAudit(db: Queryable, records: readonly NewAuditRecord[]): Promise<void> {
+  for (const record of records) {
+    await db.query(
+      `INSERT INTO audit_records (booking_id, staff_id, action, at, before, after)
+       VALUES ($1, $2, $3, $4, $5::jsonb, $6::jsonb)`,
+      [
+        record.bookingId,
+        record.staffId,
+        record.action,
+        record.at,
+        record.before === null ? null : JSON.stringify(record.before),
+        record.after === null ? null : JSON.stringify(record.after),
+      ],
+    );
+  }
+}
+
+export class PostgresBookingRepository implements BookingRepository {
+  constructor(private readonly db: PostgresDatabase) {}
+
+  async findById(id: string): Promise<Booking | undefined> {
+    return (await this.select('WHERE id = $1', [id]))[0];
+  }
+
+  findByRoom(roomId: string): Promise<Booking[]> {
+    return this.select('WHERE room_id = $1', [roomId]);
+  }
+
+  findActive(): Promise<Booking[]> {
+    return this.select("WHERE status = 'confirmed'", []);
+  }
+
+  findRefundPending(): Promise<Booking[]> {
+    return this.select('WHERE refund_pending', []);
+  }
+
+  async save(booking: Booking): Promise<void> {
+    await this.db.ready();
+    await upsertBooking(this.db.pool, booking);
+  }
+
+  async saveAudited(booking: Booking, records: readonly NewAuditRecord[]): Promise<void> {
+    await this.db.ready();
+    await this.db.pool.transaction(async (tx) => {
+      await upsertBooking(tx, booking);
+      await insertAudit(tx, records);
+    });
+  }
+
+  async createExclusive(
+    roomId: string,
+    build: (existing: Booking[]) => Promise<{ booking: Booking; records: readonly NewAuditRecord[] }>,
+  ): Promise<Booking> {
+    await this.db.ready();
+    return this.db.pool.transaction(async (tx) => {
+      // The room row is the lock: other servers wait here until this transaction commits or rolls back,
+      // and then see this booking when they load the room's bookings.
+      await tx.query('SELECT id FROM rooms WHERE id = $1 FOR UPDATE', [roomId]);
+      const existing = await tx.query<BookingRow>('SELECT * FROM bookings WHERE room_id = $1', [roomId]);
+      const { booking, records } = await build(existing.rows.map(toBooking));
+      await upsertBooking(tx, booking);
+      await insertAudit(tx, records);
+      return booking;
+    });
+  }
+
+  nextId(): string {
+    return `bk-${randomUUID()}`;
+  }
+
+  private async select(where: string, values: readonly unknown[]): Promise<Booking[]> {
+    await this.db.ready();
+    const result = await this.db.pool.query<BookingRow>(`SELECT * FROM bookings ${where} ORDER BY check_in, id`, values);
+    return result.rows.map(toBooking);
+  }
+}
+
+export class PostgresAuditLog implements AuditLog {
+  constructor(private readonly db: PostgresDatabase) {}
+
+  async findByBooking(bookingId: string): Promise<AuditRecord[]> {
+    await this.db.ready();
+    const result = await this.db.pool.query<AuditRow>('SELECT * FROM audit_records WHERE booking_id = $1 ORDER BY id', [
+      bookingId,
+    ]);
+    return result.rows.map(toAuditRecord);
+  }
+
+  async findByStaff(staffId: string, from: Date, to: Date): Promise<AuditRecord[]> {
+    await this.db.ready();
+    const result = await this.db.pool.query<AuditRow>(
+      'SELECT * FROM audit_records WHERE staff_id = $1 AND at >= $2 AND at < $3 ORDER BY id',
+      [staffId, from, to],
+    );
+    return result.rows.map(toAuditRecord);
+  }
+}
diff --git a/src/adapters/outbound/persistence/PostgresDatabase.ts b/src/adapters/outbound/persistence/PostgresDatabase.ts
new file mode 100644
index 000000000..e001c2f53
--- /dev/null
+++ b/src/adapters/outbound/persistence/PostgresDatabase.ts
@@ -0,0 +1,85 @@
+import { Pool } from 'sqlwell';
+import { SEED_GUESTS, SEED_ROOMS } from './seedData';
+
+const SCHEMA = [
+  `CREATE TABLE IF NOT EXISTS rooms (
+     id text PRIMARY KEY,
+     number text NOT NULL,
+     nightly_rate_cents bigint NOT NULL,
+     capacity integer NOT NULL
+   )`,
+  `CREATE TABLE IF NOT EXISTS guests (
+     id text PRIMARY KEY,
+     name text NOT NULL,
+     email text NOT NULL
+   )`,
+  `CREATE TABLE IF NOT EXISTS bookings (
+     id text PRIMARY KEY,
+     room_id text NOT NULL REFERENCES rooms (id),
+     guest_id text NOT NULL REFERENCES guests (id),
+     check_in timestamptz NOT NULL,
+     check_out timestamptz NOT NULL,
+     total_cents bigint NOT NULL,
+     payment_ref text NOT NULL,
+     status text NOT NULL,
+     refund_pending boolean NOT NULL DEFAULT false
+   )`,
+  `CREATE INDEX IF NOT EXISTS bookings_room_idx ON bookings (room_id)`,
+  `CREATE TABLE IF NOT EXISTS audit_records (
+     id bigserial PRIMARY KEY,
+     booking_id text NOT NULL,
+     staff_id text NOT NULL,
+     action text NOT NULL,
+     at timestamptz NOT NULL,
+     before jsonb,
+     after jsonb
+   )`,
+  `CREATE INDEX IF NOT EXISTS audit_records_booking_idx ON audit_records (booking_id)`,
+  `CREATE INDEX IF NOT EXISTS audit_records_staff_idx ON audit_records (staff_id, at)`,
+];
+
+/** Shared connection pool; creates the tables and the starting rooms and guests once, on first use. */
+export class PostgresDatabase {
+  readonly pool: Pool;
+  private initialised: Promise<void> | undefined;
+
+  constructor(connectionString: string) {
+    this.pool = new Pool({ connectionString });
+  }
+
+  static fromEnv(env: NodeJS.ProcessEnv = process.env): PostgresDatabase | undefined {
+    const url = env['DATABASE_URL'];
+    return url ? new PostgresDatabase(url) : undefined;
+  }
+
+  ready(): Promise<void> {
+    if (this.initialised === undefined) {
+      this.initialised = this.initialise().catch((error: unknown) => {
+        this.initialised = undefined;
+        throw error;
+      });
+    }
+    return this.initialised;
+  }
+
+  private initialise(): Promise<void> {
+    return this.pool.transaction(async (tx) => {
+      // Servers starting together must not run the setup at the same time.
+      await tx.query('SELECT pg_advisory_xact_lock(727001)');
+      for (const statement of SCHEMA) await tx.query(statement);
+      for (const room of SEED_ROOMS) {
+        await tx.query(
+          'INSERT INTO rooms (id, number, nightly_rate_cents, capacity) VALUES ($1, $2, $3, $4) ON CONFLICT (id) DO NOTHING',
+          [room.id, room.number, room.nightlyRate.cents, room.capacity],
+        );
+      }
+      for (const guest of SEED_GUESTS) {
+        await tx.query('INSERT INTO guests (id, name, email) VALUES ($1, $2, $3) ON CONFLICT (id) DO NOTHING', [
+          guest.id,
+          guest.name,
+          guest.email,
+        ]);
+      }
+    });
+  }
+}
