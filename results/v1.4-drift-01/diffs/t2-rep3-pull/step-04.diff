+export interface RoomNightFigures {
+  roomId: string;
+  number: string;
+  revenueCents: number;
+}
+
+export interface NightFigures {
+  /** The night as YYYY-MM-DD (UTC): the night starting that day. */
+  date: string;
+  roomsOccupied: number;
+  /** Occupied rooms over all rooms, 0..1. */
+  occupancyRate: number;
+  revenueCents: number;
+  /** Only rooms with revenue that night. */
+  rooms: RoomNightFigures[];
+}
+
+export interface OccupancyReportView {
+  from: string;
+  nights: number;
+  totalRooms: number;
+  totalRevenueCents: number;
+  perNight: NightFigures[];
+}
+
+export interface OccupancyReport {
+  /** Report for `nights` nights (1..90) starting at the day `from` (YYYY-MM-DD). */
+  report(from: string, nights: number): Promise<OccupancyReportView>;
+}
diff --git a/src/application/services/OccupancyReportService.ts b/src/application/services/OccupancyReportService.ts
