--- /dev/null
+++ b/src/application/services/OccupancyReportService.ts
@@ -0,0 +1,81 @@
+import { BookingError } from '../../domain/errors/BookingError';
+import { OccupancyReport, OccupancyReportView, NightFigures, RoomNightFigures } from '../ports/in/OccupancyReport';
+import { BookingRepository } from '../ports/out/BookingRepository';
+import { RoomRepository } from '../ports/out/RoomRepository';
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const MAX_NIGHTS = 90;
+
+/** Read-only query: one pass over the active bookings, accumulating into a nights x rooms grid. */
+export class OccupancyReportService implements OccupancyReport {
+  constructor(
+    private readonly rooms: RoomRepository,
+    private readonly bookings: BookingRepository,
+  ) {}
+
+  async report(from: string, nights: number): Promise<OccupancyReportView> {
+    const start = Date.parse(from);
+    if (Number.isNaN(start)) throw new BookingError('invalid', 'from must be a valid date');
+    if (!Number.isInteger(nights) || nights < 1 || nights > MAX_NIGHTS) {
+      throw new BookingError('invalid', `nights must be a whole number from 1 to ${MAX_NIGHTS}`);
+    }
+    const firstDay = Math.floor(start / DAY_MS);
+
+    const rooms = await this.rooms.findAll();
+    const roomIndex = new Map<string, number>();
+    rooms.forEach((room, i) => roomIndex.set(room.id, i));
+    const roomCount = rooms.length;
+
+    const count = new Uint16Array(nights * roomCount);
+    const revenue = new Float64Array(nights * roomCount);
+
+    for (const booking of await this.bookings.findActive()) {
+      const r = roomIndex.get(booking.roomId);
+      if (r === undefined) continue;
+      const checkInDay = Math.floor(booking.stay.checkIn.getTime() / DAY_MS);
+      const stayNights = booking.stay.nights();
+      const perNight = booking.total.cents / stayNights;
+      const lo = Math.max(checkInDay, firstDay);
+      const hi = Math.min(checkInDay + stayNights, firstDay + nights);
+      for (let day = lo; day < hi; day++) {
+        const cell = (day - firstDay) * roomCount + r;
+        count[cell] += 1;
+        revenue[cell] += perNight;
+      }
+    }
+
+    let totalRevenue = 0;
+    const perNightFigures: NightFigures[] = [];
+    for (let n = 0; n < nights; n++) {
+      let occupied = 0;
+      let nightRevenue = 0;
+      const roomFigures: RoomNightFigures[] = [];
+      for (let r = 0; r < roomCount; r++) {
+        const cell = n * roomCount + r;
+        if (count[cell]! > 0) occupied += 1;
+        const cents = revenue[cell]!;
+        if (cents > 0) {
+          nightRevenue += cents;
+          const room = rooms[r]!;
+          roomFigures.push({ roomId: room.id, number: room.number, revenueCents: Math.round(cents) });
+        }
+      }
+      totalRevenue += nightRevenue;
+      perNightFigures.push({
+        date: new Date((firstDay + n) * DAY_MS).toISOString().slice(0, 10),
+        roomsOccupied: occupied,
+        occupancyRate: roomCount === 0 ? 0 : occupied / roomCount,
+        revenueCents: Math.round(nightRevenue),
+        rooms: roomFigures,
+      });
+    }
+
+    return {
+      from: new Date(firstDay * DAY_MS).toISOString().slice(0, 10),
+      nights,
+      totalRooms: roomCount,
+      totalRevenueCents: Math.round(totalRevenue),
+      perNight: perNightFigures,
+    };
+  }
+}
