+import { OccupancyReport } from '../../../application/ports/in/OccupancyReport';
+import { BookingError } from '../../../domain/errors/BookingError';
+import { HttpRequest, HttpResponse } from './HttpTypes';
+
+/** Driving adapter: GET occupancy report, query `from` (YYYY-MM-DD) and `nights` (1..90, default 90). */
+export class OccupancyReportController {
+  constructor(private readonly occupancyReport: OccupancyReport) {}
+
+  async show(request: HttpRequest): Promise<HttpResponse> {
+    try {
+      const { from } = request.query;
+      if (!from) throw new BookingError('invalid', 'from is required');
+      return { status: 200, body: await this.occupancyReport.report(from, Number(request.query['nights'] ?? 90)) };
+    } catch (error) {
+      if (error instanceof BookingError) return { status: 400, body: { error: error.message } };
+      return { status: 500, body: { error: 'Internal error' } };
+    }
+  }
+}
