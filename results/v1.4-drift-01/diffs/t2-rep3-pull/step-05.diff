new file mode 100644
index 000000000..84711d28b
--- /dev/null
+++ b/src/adapters/outbound/persistence/InMemoryBookingTransaction.ts
@@ -0,0 +1,22 @@
+import { BookingRepository } from '../../../application/ports/out/BookingRepository';
+import { BookingTransaction } from '../../../application/ports/out/BookingTransaction';
+
+/** In-process stand-in: requests for one room run one at a time. */
+export class InMemoryBookingTransaction implements BookingTransaction {
+  /** Tail of the pending chain per room. */
+  private readonly roomLocks = new Map<string, Promise<unknown>>();
+
+  constructor(private readonly bookings: BookingRepository) {}
+
+  async runForRoom<T>(roomId: string, work: (bookings: BookingRepository) => Promise<T>): Promise<T> {
+    const previous = this.roomLocks.get(roomId) ?? Promise.resolve();
+    const run = previous.then(() => work(this.bookings));
+    const tail = run.catch(() => undefined);
+    this.roomLocks.set(roomId, tail);
+    try {
+      return await run;
+    } finally {
+      if (this.roomLocks.get(roomId) === tail) this.roomLocks.delete(roomId);
+    }
+  }
+}
diff --git a/src/adapters/outbound/persistence/PostgresBookingRepository.ts b/src/adapters/outbound/persistence/PostgresBookingRepository.ts
