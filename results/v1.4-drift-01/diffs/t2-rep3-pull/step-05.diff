@@ -0,0 +1,67 @@
+import { Pool } from 'sqlwell';
+
+/** Creates the tables (and the demo rooms and guest) once per process; safe to run from several servers. */
+export class PostgresSchema {
+  private ready: Promise<void> | undefined;
+
+  constructor(private readonly pool: Pool) {}
+
+  ensure(): Promise<void> {
+    if (this.ready === undefined) {
+      this.ready = this.create().catch((error: unknown) => {
+        this.ready = undefined;
+        throw error;
+      });
+    }
+    return this.ready;
+  }
+
+  private async create(): Promise<void> {
+    await this.pool.transaction(async (tx) => {
+      await tx.query('SELECT pg_advisory_xact_lock(5120001)');
+      await tx.query(`CREATE TABLE IF NOT EXISTS rooms (
+        id text PRIMARY KEY,
+        number text NOT NULL,
+        nightly_rate_cents integer NOT NULL,
+        capacity integer NOT NULL
+      )`);
+      await tx.query(`CREATE TABLE IF NOT EXISTS guests (
+        id text PRIMARY KEY,
+        name text NOT NULL,
+        email text NOT NULL
+      )`);
+      await tx.query(`CREATE TABLE IF NOT EXISTS bookings (
+        id text PRIMARY KEY,
+        room_id text NOT NULL REFERENCES rooms (id),
+        guest_id text NOT NULL REFERENCES guests (id),
+        check_in timestamptz NOT NULL,
+        check_out timestamptz NOT NULL,
+        total_cents integer NOT NULL,
+        payment_ref text NOT NULL,
+        status text NOT NULL,
+        refund_pending boolean NOT NULL,
+        audit_count integer NOT NULL DEFAULT 0
+      )`);
+      await tx.query('CREATE INDEX IF NOT EXISTS bookings_room_idx ON bookings (room_id)');
+      await tx.query(`CREATE TABLE IF NOT EXISTS booking_audit (
+        id text PRIMARY KEY,
+        booking_id text NOT NULL REFERENCES bookings (id),
+        staff_id text NOT NULL,
+        action text NOT NULL,
+        at timestamptz NOT NULL,
+        before_values text,
+        after_values text
+      )`);
+      await tx.query('CREATE INDEX IF NOT EXISTS booking_audit_booking_idx ON booking_audit (booking_id)');
+      await tx.query(
+        `INSERT INTO rooms (id, number, nightly_rate_cents, capacity) VALUES
+          ('r-101', '101', 9000, 2), ('r-102', '102', 12000, 3), ('r-201', '201', 20000, 4)
+         ON CONFLICT (id) DO NOTHING`,
+      );
+      await tx.query(
+        `INSERT INTO guests (id, name, email) VALUES ('g-1', 'Alistair', 'alistair@example.org')
+         ON CONFLICT (id) DO NOTHING`,
+      );
+    });
+  }
+}
