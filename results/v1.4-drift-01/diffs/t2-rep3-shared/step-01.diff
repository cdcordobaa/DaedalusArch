+
+  /** Bookings cancelled whose refund failed, for the front desk to retry. */
+  async listPendingRefunds(): Promise<BookingView[]> {
+    return (await this.bookings.findRefundPending()).map(toBookingView);
+  }
+
+  async retryRefund(bookingId: string): Promise<BookingView> {
+    const booking = await this.bookings.findById(bookingId);
+    if (booking === undefined) throw new BookingError('not-found', `No booking ${bookingId}`);
+    if (!booking.isRefundPending) throw new BookingError('invalid', `Booking ${bookingId} has no refund pending`);
