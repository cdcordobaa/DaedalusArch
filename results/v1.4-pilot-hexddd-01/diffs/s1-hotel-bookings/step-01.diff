@@ -0,0 +1,34 @@
+import { Paystream } from '@paystream/node';
+import { PaymentGateway } from '../../../application/ports/out/PaymentGateway';
+import { BookingError } from '../../../domain/errors/BookingError';
+import { Money } from '../../../domain/model/Money';
+
+const CURRENCY = 'USD';
+
+/** Driven adapter that charges and refunds cards through Paystream. */
+export class PaystreamPaymentGateway implements PaymentGateway {
+  private readonly client: Paystream;
+
+  constructor(apiKey: string) {
+    this.client = new Paystream({ apiKey });
+  }
+
+  async charge(guestId: string, amount: Money, idempotencyKey: string): Promise<string> {
+    const charge = await this.client.charges.create({
+      amountMinor: amount.cents,
+      currency: CURRENCY,
+      customerRef: guestId,
+      idempotencyKey,
+    });
+    if (charge.status === 'declined') {
+      const code = charge.declineCode ?? 'declined';
+      throw new BookingError('payment-declined', `Payment declined: ${code}`, code);
+    }
+    return charge.id;
+  }
+
+  async refund(paymentRef: string): Promise<void> {
+    const refund = await this.client.refunds.create({ chargeId: paymentRef, idempotencyKey: `refund-${paymentRef}` });
+    if (refund.status === 'failed') throw new Error(`Refund ${refund.id} for charge ${paymentRef} failed`);
+  }
+}
