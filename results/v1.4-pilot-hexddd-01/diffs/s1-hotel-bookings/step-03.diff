@@ -0,0 +1,32 @@
+import { Booking } from './Booking';
+
+export type AuditAction = 'booking' | 'cancellation' | 'charge' | 'refund';
+
+/** The staff id recorded when a request carries no X-Staff-Id header. */
+export const DEFAULT_STAFF_ID = 'guest';
+
+export type AuditValues = Record<string, unknown>;
+
+/** What a service reports about one change; the store adds the id. */
+export interface AuditEntry {
+  staffId: string;
+  action: AuditAction;
+  bookingId: string;
+  at: Date;
+  before: AuditValues | null;
+  after: AuditValues | null;
+}
+
+export interface AuditRecord extends AuditEntry {
+  id: string;
+}
+
+/** The auditable state of a booking, copied so later changes to the booking do not alter the record. */
+export function bookingSnapshot(booking: Booking): AuditValues {
+  return {
+    status: booking.status,
+    refundStatus: booking.refundStatus,
+    totalCents: booking.total.cents,
+    paymentRef: booking.paymentRef,
+  };
+}
