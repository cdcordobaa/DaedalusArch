+import { AuditTrail } from '../../../application/ports/in/AuditTrail';
+import { BookingError } from '../../../domain/errors/BookingError';
+import { HttpRequest, HttpResponse } from './HttpTypes';
+
+/** Driving adapter for auditors: records of one booking, and of one staff user in a date range. */
+export class AuditController {
+  constructor(private readonly auditTrail: AuditTrail) {}
+
+  /** GET /bookings/:id/audit */
+  async forBooking(request: HttpRequest): Promise<HttpResponse> {
+    try {
+      return { status: 200, body: await this.auditTrail.listForBooking(String(request.params['id'])) };
+    } catch (error) {
+      return this.toResponse(error);
+    }
+  }
+
+  /** GET /staff/:id/audit?from=...&to=... */
+  async forStaff(request: HttpRequest): Promise<HttpResponse> {
+    const { from, to } = request.query;
+    if (from === undefined || to === undefined) return { status: 400, body: { error: 'from and to are required' } };
+    try {
+      return { status: 200, body: await this.auditTrail.listByStaff(String(request.params['id']), from, to) };
+    } catch (error) {
+      return this.toResponse(error);
+    }
+  }
+
+  private toResponse(error: unknown): HttpResponse {
+    if (error instanceof BookingError && error.reason === 'invalid') return { status: 400, body: { error: error.message } };
+    return { status: 500, body: { error: 'Internal error' } };
+  }
+}
