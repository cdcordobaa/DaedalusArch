diff --git a/src/application/services/AuditTrailService.ts b/src/application/services/AuditTrailService.ts
new file mode 100644
index 0000000..97c2522
--- /dev/null
+++ b/src/application/services/AuditTrailService.ts
@@ -0,0 +1,41 @@
+import { BookingError } from '../../domain/errors/BookingError';
+import { AuditRecord } from '../../domain/model/AuditRecord';
+import { AuditRecordView, AuditTrail } from '../ports/in/AuditTrail';
+import { AuditLog } from '../ports/out/AuditLog';
+
+const DATE_ONLY = /^\d{4}-\d{2}-\d{2}$/;
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+function toView(record: AuditRecord): AuditRecordView {
+  return {
+    id: record.id,
+    staffId: record.staffId,
+    action: record.action,
+    bookingId: record.bookingId,
+    at: record.at.toISOString(),
+    before: record.before,
+    after: record.after,
+  };
+}
+
+function parseInstant(value: string, name: string): Date {
+  const date = new Date(value);
+  if (Number.isNaN(date.getTime())) throw new BookingError('invalid', `${name} is not a valid date: ${value}`);
+  return date;
+}
+
+export class AuditTrailService implements AuditTrail {
+  constructor(private readonly log: AuditLog) {}
+
+  async listForBooking(bookingId: string): Promise<AuditRecordView[]> {
+    return (await this.log.findByBooking(bookingId)).map(toView);
+  }
+
+  async listByStaff(staffId: string, from: string, to: string): Promise<AuditRecordView[]> {
+    const start = parseInstant(from, 'from');
+    const end = parseInstant(to, 'to');
+    const exclusiveEnd = DATE_ONLY.test(to) ? new Date(end.getTime() + DAY_MS) : new Date(end.getTime() + 1);
+    if (exclusiveEnd.getTime() <= start.getTime()) throw new BookingError('invalid', 'to is before from');
+    return (await this.log.findByStaff(staffId, start, exclusiveEnd)).map(toView);
+  }
+}
