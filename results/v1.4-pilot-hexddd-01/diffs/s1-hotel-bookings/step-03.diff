 export interface HttpRequest {
   params: Record<string, string>;
   query: Record<string, string>;
   body: Record<string, unknown>;
+  /** Header names as the HTTP server delivers them (lower-case under Node/Express). */
+  headers?: Record<string, string | string[] | undefined>;
+}
+
+/** The staff user behind a request, from X-Staff-Id; 'guest' when the header is absent or blank. */
+export function staffIdOf(request: HttpRequest): string {
+  const headers = request.headers ?? {};
+  const key = Object.keys(headers).find((name) => name.toLowerCase() === 'x-staff-id');
+  const raw = key === undefined ? undefined : headers[key];
+  const value = (Array.isArray(raw) ? raw[0] : raw)?.trim();
+  return value ? value : DEFAULT_STAFF_ID;
 }
 
