+import { OccupancyReport } from '../../../application/ports/in/OccupancyReport';
+import { BookingError } from '../../../domain/errors/BookingError';
+import { HttpRequest, HttpResponse } from './HttpTypes';
+
+/** Driving adapter for the revenue manager's daily occupancy and revenue report. */
+export class ReportController {
+  constructor(private readonly occupancy: OccupancyReport) {}
+
+  /** GET /reports/occupancy?from=YYYY-MM-DD&to=YYYY-MM-DD (to exclusive, at most 90 nights) */
+  async occupancyReport(request: HttpRequest): Promise<HttpResponse> {
+    const { from, to } = request.query;
+    if (from === undefined || to === undefined) return { status: 400, body: { error: 'from and to are required' } };
+    try {
+      return { status: 200, body: await this.occupancy.report(from, to) };
+    } catch (error) {
+      if (error instanceof BookingError && error.reason === 'invalid') return { status: 400, body: { error: error.message } };
+      return { status: 500, body: { error: 'Internal error' } };
+    }
+  }
+}
