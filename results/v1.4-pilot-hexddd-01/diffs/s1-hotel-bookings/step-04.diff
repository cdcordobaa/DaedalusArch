+export interface RoomRevenueView {
+  roomId: string;
+  revenueCents: number;
+}
+
+export interface NightReportView {
+  /** The night, as YYYY-MM-DD (the night starting that day). */
+  date: string;
+  occupiedRooms: number;
+  /** Occupied rooms divided by all rooms, 0..1; 0 when the hotel has no rooms. */
+  occupancyRate: number;
+  revenueCents: number;
+  /** Revenue of each occupied room that night. */
+  rooms: RoomRevenueView[];
+}
+
+export interface OccupancyReportView {
+  from: string;
+  to: string;
+  totalRooms: number;
+  totalRevenueCents: number;
+  nights: NightReportView[];
+}
+
+/** Driving port: nightly occupancy and revenue. Dates are YYYY-MM-DD; `to` is exclusive, at most 90 nights. */
+export interface OccupancyReport {
+  report(from: string, to: string): Promise<OccupancyReportView>;
+}
diff --git a/src/application/services/OccupancyReportService.ts b/src/application/services/OccupancyReportService.ts
new file mode 100644
index 0000000..b234291
--- /dev/null
+++ b/src/application/services/OccupancyReportService.ts
@@ -0,0 +1,68 @@
+import { BookingError } from '../../domain/errors/BookingError';
+import { NightReportView, OccupancyReport, OccupancyReportView } from '../ports/in/OccupancyReport';
+import { BookingRepository } from '../ports/out/BookingRepository';
+import { RoomRepository } from '../ports/out/RoomRepository';
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const MAX_NIGHTS = 90;
+const DATE_ONLY = /^\d{4}-\d{2}-\d{2}$/;
+
+function parseDay(value: string, name: string): number {
+  const time = DATE_ONLY.test(value) ? new Date(value).getTime() : NaN;
+  if (Number.isNaN(time)) throw new BookingError('invalid', `${name} must be a date as YYYY-MM-DD: ${value}`);
+  return Math.floor(time / DAY_MS);
+}
+
+export class OccupancyReportService implements OccupancyReport {
+  constructor(
+    private readonly rooms: RoomRepository,
+    private readonly bookings: BookingRepository,
+  ) {}
+
+  async report(from: string, to: string): Promise<OccupancyReportView> {
+    const firstDay = parseDay(from, 'from');
+    const endDay = parseDay(to, 'to');
+    const nights = endDay - firstDay;
+    if (nights < 1) throw new BookingError('invalid', 'to must be after from');
+    if (nights > MAX_NIGHTS) throw new BookingError('invalid', `Range is limited to ${MAX_NIGHTS} nights`);
+
+    const [rooms, active] = await Promise.all([this.rooms.findAll(), this.bookings.findActive()]);
+
+    // One pass over the bookings, touching only the nights each one shares with the range.
+    const perNight: Map<string, number>[] = Array.from({ length: nights }, () => new Map());
+    for (const booking of active) {
+      const stayNights = booking.stay.nights();
+      const stayStart = Math.floor(booking.stay.checkIn.getTime() / DAY_MS);
+      const lo = Math.max(stayStart, firstDay);
+      const hi = Math.min(stayStart + stayNights, endDay);
+      if (lo >= hi) continue;
+      // Spread the total evenly in whole cents; the first `extra` nights carry the odd cents so the parts sum exactly.
+      const base = Math.floor(booking.total.cents / stayNights);
+      const extra = booking.total.cents - base * stayNights;
+      for (let day = lo; day < hi; day++) {
+        const share = base + (day - stayStart < extra ? 1 : 0);
+        const night = perNight[day - firstDay]!;
+        night.set(booking.roomId, (night.get(booking.roomId) ?? 0) + share);
+      }
+    }
+
+    let totalRevenueCents = 0;
+    const report: NightReportView[] = perNight.map((night, index) => {
+      let revenueCents = 0;
+      const roomViews = [...night].map(([roomId, cents]) => {
+        revenueCents += cents;
+        return { roomId, revenueCents: cents };
+      });
+      totalRevenueCents += revenueCents;
+      return {
+        date: new Date((firstDay + index) * DAY_MS).toISOString().slice(0, 10),
+        occupiedRooms: night.size,
+        occupancyRate: rooms.length === 0 ? 0 : night.size / rooms.length,
+        revenueCents,
+        rooms: roomViews,
+      };
+    });
+
+    return { from, to, totalRooms: rooms.length, totalRevenueCents, nights: report };
+  }
+}
