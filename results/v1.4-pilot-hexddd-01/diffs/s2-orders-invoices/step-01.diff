@@ -0,0 +1,12 @@
+import type { InvoiceRepository } from '../domain/invoice/InvoiceRepository.js';
+import type { UnpaidBalanceQuery } from '../contracts/UnpaidBalanceQuery.js';
+
+/** Sum of outstanding amounts on a customer's issued invoices in one currency. */
+export class UnpaidBalance implements UnpaidBalanceQuery {
+  constructor(private readonly invoices: InvoiceRepository) {}
+
+  async unpaidCents(customerId: string, currency: string): Promise<number> {
+    const all = await this.invoices.byCustomer(customerId);
+    return all.filter((i) => i.isIssued() && i.currency === currency).reduce((s, i) => s + i.outstanding().cents, 0);
+  }
+}
