+
+  /** Finance sets a customer-specific limit, in minor units of the order currency. */
+  setCreditLimit(cents: number): void {
+    if (!Number.isInteger(cents) || cents < 0) throw new Error('Credit limit must be a non-negative whole amount');
+    this.creditLimitCents = cents;
+  }
+
+  creditLimit(): number {
+    return this.creditLimitCents ?? DEFAULT_CREDIT_LIMIT_CENTS;
+  }
+
+  /** Refuses an order that would take unpaid invoices plus the new total over the limit. */
+  checkCredit(unpaidCents: number, orderTotal: Money): void {
+    const excess = unpaidCents + orderTotal.cents - this.creditLimit();
+    if (excess > 0) {
+      throw new Error(`Credit limit exceeded by ${(excess / 100).toFixed(2)} ${orderTotal.currency}`);
+    }
+  }
