diff --git a/src/billing/application/MonthlyRevenueReport.ts b/src/billing/application/MonthlyRevenueReport.ts
new file mode 100644
index 0000000..dcd813e
--- /dev/null
+++ b/src/billing/application/MonthlyRevenueReport.ts
@@ -0,0 +1,74 @@
+import type { InvoiceRepository } from '../domain/invoice/InvoiceRepository.js';
+import type { OrderCountSource } from './ports/OrderCountSource.js';
+
+export const MAX_REPORT_MONTHS = 24;
+
+export interface MonthlyRevenueRow {
+  readonly customerId: string;
+  readonly month: string;
+  readonly currency: string;
+  readonly orders: number;
+  readonly netCents: number;
+  readonly taxCents: number;
+  readonly paidCents: number;
+  readonly outstandingCents: number;
+}
+
+const MONTH = /^(\d{4})-(0[1-9]|1[0-2])$/;
+
+function parseMonth(value: string, name: string): number {
+  const m = MONTH.exec(value);
+  if (m === null) throw new Error(`${name} must be a month in YYYY-MM format, got ${value}`);
+  return Number(m[1]) * 12 + Number(m[2]) - 1;
+}
+
+function startOf(monthIndex: number): Date {
+  return new Date(Date.UTC(Math.floor(monthIndex / 12), monthIndex % 12, 1));
+}
+
+/**
+ * Per customer, UTC calendar month and currency: orders placed in the month, plus net, tax, paid and
+ * outstanding amounts of the invoices issued in that month (paid = all payments received so far
+ * against those invoices, so net + tax = paid + outstanding).
+ */
+export class MonthlyRevenueReport {
+  constructor(private readonly invoices: InvoiceRepository, private readonly orderCounts: OrderCountSource) {}
+
+  /** Inclusive month range, both "YYYY-MM". */
+  async execute(fromMonth: string, toMonth: string): Promise<MonthlyRevenueRow[]> {
+    const first = parseMonth(fromMonth, 'from');
+    const last = parseMonth(toMonth, 'to');
+    if (last < first) throw new Error('from must not be after to');
+    if (last - first + 1 > MAX_REPORT_MONTHS) throw new Error(`A report covers at most ${MAX_REPORT_MONTHS} months`);
+    const start = startOf(first);
+    const end = startOf(last + 1);
+
+    const rows = new Map<string, { -readonly [K in keyof MonthlyRevenueRow]: MonthlyRevenueRow[K] }>();
+    const rowFor = (customerId: string, month: string, currency: string) => {
+      const key = JSON.stringify([customerId, month, currency]);
+      let row = rows.get(key);
+      if (row === undefined) {
+        row = { customerId, month, currency, orders: 0, netCents: 0, taxCents: 0, paidCents: 0, outstandingCents: 0 };
+        rows.set(key, row);
+      }
+      return row;
+    };
+
+    for (const c of await this.orderCounts.ordersPlaced(start, end)) {
+      rowFor(c.customerId, c.month, c.currency).orders += c.orders;
+    }
+    for (const invoice of await this.invoices.issuedBetween(start, end)) {
+      const issuedAt = invoice.issuedAt();
+      if (issuedAt === null) continue;
+      const row = rowFor(invoice.customerId, issuedAt.toISOString().slice(0, 7), invoice.currency);
+      row.netCents += invoice.net().cents;
+      row.taxCents += invoice.tax().cents;
+      row.paidCents += invoice.paid().cents;
+      row.outstandingCents += invoice.outstanding().cents;
+    }
+
+    return [...rows.values()].sort(
+      (a, b) => a.customerId.localeCompare(b.customerId) || a.month.localeCompare(b.month) || a.currency.localeCompare(b.currency),
+    );
+  }
+}
