+import type { OrderCountQuery } from '../../ordering/index.js';
+import type { MonthlyOrderCount, OrderCountSource } from '../application/ports/OrderCountSource.js';
+
+/** Anti-corruption layer: translates ordering's order counts into billing's model. */
+export class OrderingCountAcl implements OrderCountSource {
+  constructor(private readonly ordering: OrderCountQuery) {}
+
+  async ordersPlaced(from: Date, to: Date): Promise<MonthlyOrderCount[]> {
+    const counts = await this.ordering.orderCounts(from, to);
+    return counts.map((c) => ({ customerId: c.customerId, month: c.month, currency: c.currency, orders: c.orders }));
+  }
+}
