index 0000000..e0aab02
--- /dev/null
+++ b/src/ordering/domain/order/LineDiscount.ts
@@ -0,0 +1,26 @@
+import { Money } from '../../../shared-kernel/value-objects/Money.js';
+
+export const MAX_DISCOUNT_PERCENT = 30;
+
+/** Value object: a discount on one order line, with its reason and the amount it takes off. */
+export class LineDiscount {
+  private constructor(readonly amount: Money, readonly reason: string, readonly percent: number | null) {}
+
+  static percentOf(gross: Money, percent: number, reason: string): LineDiscount {
+    if (!Number.isFinite(percent) || percent <= 0 || percent > MAX_DISCOUNT_PERCENT) {
+      throw new Error(`A percentage discount must be above 0 and at most ${MAX_DISCOUNT_PERCENT}%`);
+    }
+    return new LineDiscount(gross.times(percent / 100), LineDiscount.cleanReason(reason), percent);
+  }
+
+  static fixed(amount: Money, reason: string): LineDiscount {
+    if (amount.cents <= 0) throw new Error('A fixed discount must be positive');
+    return new LineDiscount(amount, LineDiscount.cleanReason(reason), null);
+  }
+
+  private static cleanReason(reason: string): string {
+    const r = typeof reason === 'string' ? reason.trim() : '';
+    if (r === '') throw new Error('A discount needs a reason');
+    return r;
+  }
+}
