diff --git a/a/src/sales/acl/MembershipDirectory.ts b/b/src/sales/acl/MembershipDirectory.ts
index 588a5088..dd34c277 100644
--- a/a/src/sales/acl/MembershipDirectory.ts
+++ b/b/src/sales/acl/MembershipDirectory.ts
@@ -8,4 +8,15 @@ export class MembershipDirectory implements MemberDirectory {
   exists(memberId: string): boolean {
     return this.membership.card(memberId) !== undefined;
   }
+
+  discountRate(memberId: string): number {
+    switch (this.membership.card(memberId)?.tier) {
+      case 'gold':
+        return 0.1;
+      case 'silver':
+        return 0.05;
+      default:
+        return 0;
+    }
+  }
 }
