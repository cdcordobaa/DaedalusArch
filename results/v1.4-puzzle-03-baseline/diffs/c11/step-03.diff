     let estimated = false;
     try {
       const rates = await this.rates.rates(parcel);
-      cheapest = rates.reduce<Quote | undefined>(
+      const allowed = rates.filter((r) => (r.freight === true) === parcel.requiresFreight());
+      cheapest = allowed.reduce<Quote | undefined>(
         (best, r) => (best === undefined || r.price.isLessThan(best.price) ? r : best),
         undefined,
       );
     } catch (e) {
       if (!(e instanceof RatesUnavailableError)) throw e;
-      cheapest = this.fallback.quote(parcel);
+      // the house rate is never freight, so it cannot serve parcels that require it
+      cheapest = parcel.requiresFreight() ? undefined : this.fallback.quote(parcel);
       estimated = true;
     }
     if (!cheapest) throw new ShippingError('no Fastship service available for this parcel');
