--- a/a/src/bookings/application/RequestBooking.ts
+++ b/b/src/bookings/application/RequestBooking.ts
@@ -12,6 +12,8 @@ export class RequestBooking {
   execute(passenger: string, sailingId: string, seats: number): string {
     if (!this.sailings.exists(sailingId)) throw new BookingError(`no sailing ${sailingId}`);
     const booking = Booking.request(this.bookings.nextId(), passenger, sailingId, seats);
+    if (this.sailings.take(sailingId, booking.id.value, seats)) booking.confirm();
+    else booking.reject();
     this.bookings.save(booking);
     return booking.id.value;
   }
