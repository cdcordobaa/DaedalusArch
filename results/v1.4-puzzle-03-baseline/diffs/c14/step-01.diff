diff --git a/a/src/bookings/acl/SailingsDirectory.ts b/b/src/bookings/acl/SailingsDirectory.ts
index 49641783..b2daece2 100644
--- a/a/src/bookings/acl/SailingsDirectory.ts
+++ b/b/src/bookings/acl/SailingsDirectory.ts
@@ -8,4 +8,11 @@ export class SailingsDirectory implements SailingDirectory {
   exists(sailingId: string): boolean {
     return this.sailings.sailing(sailingId) !== undefined;
   }
+
+  take(sailingId: string, holder: string, seats: number): boolean {
+    const sailing = this.sailings.sailing(sailingId);
+    if (sailing === undefined || sailing.seatsLeft < seats) return false;
+    this.sailings.holdSeats(sailingId, holder, seats);
+    return true;
+  }
 }
diff --git a/a/src/bookings/application/RequestBooking.ts b/b/src/bookings/application/RequestBooking.ts
