+  /** Cancelling a cancelled or rejected booking changes nothing. */
+  cancel(): void {
+    if (this.current === 'cancelled' || this.current === 'rejected') return;
+    if (this.current !== 'confirmed') throw new BookingError(`booking is still ${this.current}`);
+    this.current = 'cancelled';
+    this.pending.push(new BookingCancelled(this.id.value, this.sailingId));
+  }
+
   state(): BookingState {
     return { id: this.id, passenger: this.passenger, sailingId: this.sailingId, seats: this.seats, status: this.current };
   }
