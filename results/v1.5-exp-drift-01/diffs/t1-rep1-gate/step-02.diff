@@ -0,0 +1,14 @@
+import type { InvoicePaidEvent } from '../../billing/index.js';
+import type { DomainEvent } from '../../shared-kernel/DomainEvent.js';
+import type { OrderPaymentCommand } from '../contracts/OrderPayment.js';
+
+/** Anti-corruption layer: ordering reacts to billing's invoice-paid event by marking its own order paid. */
+export class InvoicePaidHandler {
+  static readonly eventName = 'billing.invoice-paid';
+
+  constructor(private readonly payments: OrderPaymentCommand) {}
+
+  async handle(event: DomainEvent): Promise<void> {
+    await this.payments.markPaid((event as DomainEvent & InvoicePaidEvent).orderId);
+  }
+}
