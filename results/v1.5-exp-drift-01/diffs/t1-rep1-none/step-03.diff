@@ -0,0 +1,66 @@
+import type { MonthlyRevenueRow } from '../contracts/MonthlyRevenue.js';
+import type { InvoiceRepository } from '../domain/invoice/InvoiceRepository.js';
+import type { OrderCounts } from './ports/OrderSource.js';
+
+export const MAX_REPORT_MONTHS = 24;
+
+type MutableRow = { -readonly [K in keyof MonthlyRevenueRow]: MonthlyRevenueRow[K] };
+
+function parseMonth(value: string): { year: number; month: number } {
+  const m = /^(\d{4})-(0[1-9]|1[0-2])$/.exec(value);
+  if (m === null) throw new Error(`Invalid month '${value}', expected YYYY-MM`);
+  return { year: Number(m[1]), month: Number(m[2]) };
+}
+
+function monthStart(year: number, month: number): Date {
+  const d = new Date(0);
+  d.setUTCFullYear(year, month - 1, 1);
+  return d;
+}
+
+/**
+ * Monthly revenue per customer and currency. Orders count in the month they were placed;
+ * invoice figures count in the month the invoice was issued, with paid/outstanding as of now.
+ * Months are UTC calendar months.
+ */
+export class GetMonthlyRevenue {
+  constructor(private readonly invoices: InvoiceRepository, private readonly orders: OrderCounts) {}
+
+  /** fromMonth and toMonth are inclusive, formatted YYYY-MM. */
+  async execute(fromMonth: string, toMonth: string): Promise<MonthlyRevenueRow[]> {
+    const a = parseMonth(fromMonth);
+    const b = parseMonth(toMonth);
+    const span = (b.year - a.year) * 12 + (b.month - a.month) + 1;
+    if (span < 1) throw new Error('The end month is before the start month');
+    if (span > MAX_REPORT_MONTHS) throw new Error(`A report covers at most ${MAX_REPORT_MONTHS} months`);
+    const from = monthStart(a.year, a.month);
+    const to = monthStart(b.year, b.month + 1);
+
+    const rows = new Map<string, MutableRow>();
+    const rowFor = (customerId: string, month: string, currency: string): MutableRow => {
+      const key = JSON.stringify([customerId, month, currency]);
+      let row = rows.get(key);
+      if (row === undefined) {
+        row = { customerId, month, currency, ordersPlaced: 0, netCents: 0, taxCents: 0, paidCents: 0, outstandingCents: 0 };
+        rows.set(key, row);
+      }
+      return row;
+    };
+
+    for (const c of await this.orders.placedBetween(from, to)) {
+      rowFor(c.customerId, c.month, c.currency).ordersPlaced += c.orders;
+    }
+    for (const inv of await this.invoices.issuedBetween(from, to)) {
+      const at = inv.issuedAt();
+      if (at === null) continue;
+      const row = rowFor(inv.customerId, at.toISOString().slice(0, 7), inv.currency);
+      row.netCents += inv.net().cents;
+      row.taxCents += inv.tax().cents;
+      row.paidCents += inv.paid().cents;
+      row.outstandingCents += inv.outstanding().cents;
+    }
+    return [...rows.values()].sort(
+      (x, y) => x.customerId.localeCompare(y.customerId) || x.month.localeCompare(y.month) || x.currency.localeCompare(y.currency),
+    );
+  }
+}
