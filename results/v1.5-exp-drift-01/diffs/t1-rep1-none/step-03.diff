+import type { OrderCountQuery } from '../../ordering/index.js';
+import type { OrderCountRow, OrderCounts } from '../application/ports/OrderSource.js';
+
+/** Anti-corruption layer: translates ordering's order counts into billing's model. */
+export class OrderCountsAcl implements OrderCounts {
+  constructor(private readonly ordering: OrderCountQuery) {}
+
+  async placedBetween(from: Date, to: Date): Promise<OrderCountRow[]> {
+    const rows = await this.ordering.placedBetween(from, to);
+    return rows.map((r) => ({ customerId: r.customerId, month: r.month, currency: r.currency, orders: r.orders }));
+  }
+}
