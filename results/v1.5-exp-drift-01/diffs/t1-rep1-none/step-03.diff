diff --git a/src/ordering/application/GetOrderCounts.ts b/src/ordering/application/GetOrderCounts.ts
new file mode 100644
index 000000000..739baca66
--- /dev/null
+++ b/src/ordering/application/GetOrderCounts.ts
@@ -0,0 +1,20 @@
+import type { OrderCountQuery, OrderCountRow } from '../contracts/OrderCount.js';
+import type { OrderRepository } from '../domain/order/OrderRepository.js';
+
+/** Query service behind the published OrderCountQuery contract. */
+export class GetOrderCounts implements OrderCountQuery {
+  constructor(private readonly orders: OrderRepository) {}
+
+  async placedBetween(from: Date, to: Date): Promise<OrderCountRow[]> {
+    const counts = new Map<string, OrderCountRow>();
+    for (const order of await this.orders.placedBetween(from, to)) {
+      const at = order.placedAt();
+      if (at === null) continue;
+      const month = at.toISOString().slice(0, 7);
+      const key = JSON.stringify([order.customerId.value, month, order.currency]);
+      const row = counts.get(key);
+      counts.set(key, { customerId: order.customerId.value, month, currency: order.currency, orders: (row?.orders ?? 0) + 1 });
+    }
+    return [...counts.values()];
+  }
+}
