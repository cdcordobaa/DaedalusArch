diff --git a/src/ordering/domain/order/value-objects/Discount.ts b/src/ordering/domain/order/value-objects/Discount.ts
new file mode 100644
index 000000000..581e2ec93
--- /dev/null
+++ b/src/ordering/domain/order/value-objects/Discount.ts
@@ -0,0 +1,34 @@
+import { Money } from '../../../../shared-kernel/value-objects/Money.js';
+
+export const MAX_DISCOUNT_PERCENT = 30;
+
+/** Value object: a percentage (up to 30%) or a fixed amount off one order line, always with a reason. Immutable. */
+export class Discount {
+  private constructor(
+    readonly kind: 'percent' | 'fixed',
+    readonly percent: number,
+    readonly fixed: Money | null,
+    readonly reason: string,
+  ) {}
+
+  static percentage(percent: number, reason: string): Discount {
+    if (!(percent > 0) || percent > MAX_DISCOUNT_PERCENT) throw new Error(`A percentage discount must be above 0 and at most ${MAX_DISCOUNT_PERCENT}%`);
+    return new Discount('percent', percent, null, Discount.checkedReason(reason));
+  }
+
+  static amount(amount: Money, reason: string): Discount {
+    if (!(amount.cents > 0)) throw new Error('A fixed discount must be positive');
+    return new Discount('fixed', 0, amount, Discount.checkedReason(reason));
+  }
+
+  private static checkedReason(reason: string): string {
+    const trimmed = typeof reason === 'string' ? reason.trim() : '';
+    if (trimmed === '') throw new Error('A discount needs a reason');
+    return trimmed;
+  }
+
+  /** The amount taken off a line worth `base`. */
+  amountOff(base: Money): Money {
+    return this.kind === 'percent' ? base.times(this.percent / 100) : (this.fixed as Money);
+  }
+}
