@@ -0,0 +1,33 @@
+import { Money } from '../../shared-kernel/value-objects/Money.js';
+import type { OrderRepository } from '../domain/order/OrderRepository.js';
+import { OrderId } from '../domain/order/value-objects/OrderId.js';
+import { Discount } from '../domain/order/value-objects/Discount.js';
+import type { InvoiceStatus } from './ports/InvoiceStatus.js';
+
+export interface DiscountOrderLineCommand {
+  readonly orderId: string;
+  readonly lineNo: number;
+  readonly reason: string;
+  /** Exactly one of the two. */
+  readonly percent?: number;
+  readonly amountCents?: number;
+}
+
+/** Application service: loads, delegates to the aggregate, saves. */
+export class DiscountOrderLine {
+  constructor(private readonly orders: OrderRepository, private readonly invoiced: InvoiceStatus) {}
+
+  async execute(cmd: DiscountOrderLineCommand): Promise<void> {
+    const hasPercent = cmd.percent !== undefined;
+    const hasAmount = cmd.amountCents !== undefined;
+    if (hasPercent === hasAmount) throw new Error('Give either a percentage or a fixed amount');
+    const order = await this.orders.byId(new OrderId(cmd.orderId));
+    if (order === null) throw new Error('Unknown order');
+    if (await this.invoiced.isInvoiced(cmd.orderId)) throw new Error('An invoiced order cannot be discounted');
+    const discount = hasPercent
+      ? Discount.percentage(cmd.percent as number, cmd.reason)
+      : Discount.amount(Money.of(cmd.amountCents as number, order.currency), cmd.reason);
+    order.discountLine(cmd.lineNo, discount);
+    await this.orders.save(order);
+  }
+}
