@@ -0,0 +1,32 @@
+import { Money } from '../../../shared-kernel/value-objects/Money.js';
+
+export const MAX_DISCOUNT_PERCENT = 30;
+
+export type DiscountKind = 'percentage' | 'fixed';
+
+/** Value object: a reasoned discount on one order line, either a percentage or a fixed amount in cents. */
+export class LineDiscount {
+  private constructor(readonly kind: DiscountKind, readonly value: number, readonly reason: string) {}
+
+  static percentage(percent: number, reason: string): LineDiscount {
+    if (!(percent > 0 && percent <= MAX_DISCOUNT_PERCENT)) throw new Error(`A percentage discount must be above 0 and at most ${MAX_DISCOUNT_PERCENT}%`);
+    return new LineDiscount('percentage', percent, LineDiscount.checkReason(reason));
+  }
+
+  static fixed(cents: number, reason: string): LineDiscount {
+    if (!Number.isInteger(cents) || cents <= 0) throw new Error('A fixed discount must be a positive whole number of cents');
+    return new LineDiscount('fixed', cents, LineDiscount.checkReason(reason));
+  }
+
+  private static checkReason(reason: string): string {
+    const trimmed = typeof reason === 'string' ? reason.trim() : '';
+    if (trimmed === '') throw new Error('A discount needs a reason');
+    return trimmed;
+  }
+
+  /** The amount taken off the given gross line amount. */
+  amountOn(gross: Money): Money {
+    const cents = this.kind === 'percentage' ? Math.round((gross.cents * this.value) / 100) : this.value;
+    return Money.of(cents, gross.currency);
+  }
+}
