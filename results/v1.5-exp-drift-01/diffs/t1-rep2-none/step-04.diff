new file mode 100644
index 000000000..79d71def2
--- /dev/null
+++ b/src/ordering/application/SetTaxRate.ts
@@ -0,0 +1,11 @@
+import type { TaxRates } from '../domain/tax/TaxRates.js';
+
+/** Finance changes a country's tax rate; it applies to orders placed afterwards. */
+export class SetTaxRate {
+  constructor(private readonly rates: TaxRates) {}
+
+  async execute(country: string, rate: number): Promise<void> {
+    if (!Number.isFinite(rate) || rate < 0 || rate >= 1) throw new Error('Tax rate must be a fraction from 0 up to (not including) 1');
+    await this.rates.setRate(country, rate);
+  }
+}
