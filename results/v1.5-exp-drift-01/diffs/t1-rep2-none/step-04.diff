diff --git a/src/ordering/domain/tax/TaxRates.ts b/src/ordering/domain/tax/TaxRates.ts
new file mode 100644
index 000000000..815ccc506
--- /dev/null
+++ b/src/ordering/domain/tax/TaxRates.ts
@@ -0,0 +1,11 @@
+/** Tax rate (as a fraction, e.g. 0.2) per country. Finance may change a rate; unlisted countries are untaxed. */
+export interface TaxRates {
+  rateFor(country: string): Promise<number>;
+  setRate(country: string, rate: number): Promise<void>;
+}
+
+export function normalizeCountry(country: string): string {
+  const code = typeof country === 'string' ? country.trim().toUpperCase() : '';
+  if (!/^[A-Z]{2}$/.test(code)) throw new Error(`Invalid country "${String(country)}", expected a two-letter code`);
+  return code;
+}
diff --git a/src/ordering/infrastructure/InMemoryTaxRates.ts b/src/ordering/infrastructure/InMemoryTaxRates.ts
new file mode 100644
index 000000000..52cce90cb
--- /dev/null
+++ b/src/ordering/infrastructure/InMemoryTaxRates.ts
@@ -0,0 +1,17 @@
+import { normalizeCountry, type TaxRates } from '../domain/tax/TaxRates.js';
+
+export class InMemoryTaxRates implements TaxRates {
+  private readonly rates = new Map<string, number>([
+    ['GB', 0.2],
+    ['DE', 0.19],
+    ['ES', 0.21],
+  ]);
+
+  async rateFor(country: string): Promise<number> {
+    return this.rates.get(normalizeCountry(country)) ?? 0;
+  }
+
+  async setRate(country: string, rate: number): Promise<void> {
+    this.rates.set(normalizeCountry(country), rate);
+  }
+}
