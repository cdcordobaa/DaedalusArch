index 000000000..4c125514d
--- /dev/null
+++ b/src/billing/application/GetRevenueReport.ts
@@ -0,0 +1,62 @@
+import type { RevenueReportRow } from '../contracts/RevenueReport.js';
+import type { InvoiceRepository } from '../domain/invoice/InvoiceRepository.js';
+import type { OrderActivitySource } from './ports/OrderActivitySource.js';
+
+export const MAX_REPORT_MONTHS = 24;
+
+const MONTH = /^(\d{4})-(0[1-9]|1[0-2])$/;
+
+function parseMonth(value: string): number {
+  const m = MONTH.exec(value);
+  if (m === null) throw new Error(`Invalid month "${value}", expected YYYY-MM`);
+  return Number(m[1]) * 12 + (Number(m[2]) - 1);
+}
+
+function startOf(monthIndex: number): Date {
+  return new Date(Date.UTC(Math.floor(monthIndex / 12), monthIndex % 12, 1));
+}
+
+/**
+ * Read-only query: revenue per customer, calendar month (UTC) and currency.
+ * Orders count in the month they were placed. Invoiced, paid and outstanding amounts
+ * are grouped by the month the invoice was issued; paid is what has been paid on those
+ * invoices so far, so net + tax = paid + outstanding.
+ */
+export class GetRevenueReport {
+  constructor(private readonly invoices: InvoiceRepository, private readonly orders: OrderActivitySource) {}
+
+  async execute(fromMonth: string, toMonth: string): Promise<RevenueReportRow[]> {
+    const first = parseMonth(fromMonth);
+    const last = parseMonth(toMonth);
+    if (last < first) throw new Error('The end month must not be before the start month');
+    if (last - first + 1 > MAX_REPORT_MONTHS) throw new Error(`A report covers at most ${MAX_REPORT_MONTHS} months`);
+    const from = startOf(first);
+    const to = startOf(last + 1);
+
+    const rows = new Map<string, { -readonly [K in keyof RevenueReportRow]: RevenueReportRow[K] }>();
+    const rowFor = (customerId: string, month: string, currency: string) => {
+      const key = `${customerId}|${month}|${currency}`;
+      let row = rows.get(key);
+      if (row === undefined) {
+        row = { customerId, month, currency, ordersPlaced: 0, netCents: 0, taxCents: 0, paidCents: 0, outstandingCents: 0 };
+        rows.set(key, row);
+      }
+      return row;
+    };
+
+    for (const a of await this.orders.ordersPlaced(from, to)) rowFor(a.customerId, a.month, a.currency).ordersPlaced += a.orders;
+    for (const invoice of await this.invoices.issuedBetween(from, to)) {
+      const issuedAt = invoice.issuedAt();
+      if (issuedAt === null) continue;
+      const row = rowFor(invoice.customerId, issuedAt.toISOString().slice(0, 7), invoice.currency);
+      row.netCents += invoice.net().cents;
+      row.taxCents += invoice.tax().cents;
+      row.paidCents += invoice.paid().cents;
+      row.outstandingCents += invoice.outstanding().cents;
+    }
+
+    return [...rows.values()].sort(
+      (a, b) => a.customerId.localeCompare(b.customerId) || a.month.localeCompare(b.month) || a.currency.localeCompare(b.currency),
+    );
+  }
+}
