diff --git a/src/ordering/application/GetOrdersPlaced.ts b/src/ordering/application/GetOrdersPlaced.ts
new file mode 100644
index 000000000..9aecab0d9
--- /dev/null
+++ b/src/ordering/application/GetOrdersPlaced.ts
@@ -0,0 +1,21 @@
+import type { OrdersPlacedCount, OrdersPlacedQuery } from '../contracts/OrdersPlacedReport.js';
+import type { OrderRepository } from '../domain/order/OrderRepository.js';
+
+/** Query service behind the published OrdersPlacedQuery contract. Read-only. */
+export class GetOrdersPlaced implements OrdersPlacedQuery {
+  constructor(private readonly orders: OrderRepository) {}
+
+  async countPlaced(from: Date, to: Date): Promise<OrdersPlacedCount[]> {
+    const counts = new Map<string, OrdersPlacedCount>();
+    for (const order of await this.orders.placedBetween(from, to)) {
+      const at = order.placedAt();
+      if (at === null) continue;
+      const month = at.toISOString().slice(0, 7);
+      const customerId = order.customerId.value;
+      const key = `${customerId}|${month}|${order.currency}`;
+      const current = counts.get(key);
+      counts.set(key, { customerId, month, currency: order.currency, orders: (current?.orders ?? 0) + 1 });
+    }
+    return [...counts.values()];
+  }
+}
