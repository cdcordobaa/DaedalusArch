+import type { OrdersPlacedQuery } from '../../ordering/index.js';
+import type { OrderActivity, OrderActivitySource } from '../application/ports/OrderActivitySource.js';
+
+/** Anti-corruption layer: translates ordering's order counts into billing's model. */
+export class OrderActivityAcl implements OrderActivitySource {
+  constructor(private readonly ordering: OrdersPlacedQuery) {}
+
+  async ordersPlaced(from: Date, to: Date): Promise<OrderActivity[]> {
+    const counts = await this.ordering.countPlaced(from, to);
+    return counts.map((c) => ({ customerId: c.customerId, month: c.month, currency: c.currency, orders: c.orders }));
+  }
+}
