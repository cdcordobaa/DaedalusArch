diff --git a/src/ordering/domain/tax/TaxRates.ts b/src/ordering/domain/tax/TaxRates.ts
new file mode 100644
index 000000000..3ca17b1ae
--- /dev/null
+++ b/src/ordering/domain/tax/TaxRates.ts
@@ -0,0 +1,18 @@
+/** Aggregate root: the tax rate per country. Countries without an explicit rate are taxed at 0. */
+export class TaxRates {
+  private readonly rates = new Map<string, number>([
+    ['GB', 0.2],
+    ['DE', 0.19],
+    ['ES', 0.21],
+  ]);
+
+  rateFor(country: string): number {
+    return this.rates.get(country) ?? 0;
+  }
+
+  /** Finance changes a country's rate; it applies to orders placed after the change. */
+  setRate(country: string, rate: number): void {
+    if (!Number.isFinite(rate) || rate < 0) throw new Error('A tax rate must be a non-negative number');
+    this.rates.set(country, rate);
+  }
+}
