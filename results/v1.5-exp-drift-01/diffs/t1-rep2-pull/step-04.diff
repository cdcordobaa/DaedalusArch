@@ -0,0 +1,12 @@
+import type { TaxRatesRepository } from '../domain/tax/TaxRatesRepository.js';
+
+/** Finance changes the tax rate of a country (e.g. 0.2 for 20%). */
+export class SetTaxRate {
+  constructor(private readonly taxRates: TaxRatesRepository) {}
+
+  async execute(country: string, rate: number): Promise<void> {
+    const rates = await this.taxRates.get();
+    rates.setRate(country, rate);
+    await this.taxRates.save(rates);
+  }
+}
