diff --git a/src/ordering/application/SetTaxRate.ts b/src/ordering/application/SetTaxRate.ts
new file mode 100644
index 000000000..c9101d330
--- /dev/null
+++ b/src/ordering/application/SetTaxRate.ts
@@ -0,0 +1,12 @@
+import type { TaxRateRepository } from '../domain/tax/TaxRateRepository.js';
+
+/** Finance changes a country's tax rate; it applies to orders placed afterwards. */
+export class SetTaxRate {
+  constructor(private readonly rates: TaxRateRepository) {}
+
+  async execute(country: string, rate: number): Promise<void> {
+    if (!/^[A-Z]{2}$/.test(country)) throw new Error('A country is a two-letter code');
+    if (!Number.isFinite(rate) || rate < 0) throw new Error('The tax rate cannot be negative');
+    await this.rates.setRate(country, rate);
+  }
+}
