 import { Quantity } from '../value-objects/Quantity.js';
 
 /** Inner entity of the Order aggregate: reachable only through Order. */
 export class OrderLine {
   constructor(readonly lineNo: number, readonly productId: string, private quantity: Quantity, readonly unitPrice: Money) {}
 
-  subtotal(): Money {
+  private discount: LineDiscount | null = null;
+
+  /** Undiscounted amount. */
+  gross(): Money {
     return this.unitPrice.times(this.quantity.value);
   }
 
+  discountAmount(): Money {
+    return this.discount === null ? Money.of(0, this.unitPrice.currency) : this.discount.amountOn(this.gross());
+  }
+
+  discountReason(): string | null {
+    return this.discount === null ? null : this.discount.reason;
+  }
+
+  /** Amount charged for the line: gross minus discount, never below zero. */
+  subtotal(): Money {
+    return this.gross().subtract(this.discountAmount());
