diff --git a/src/ordering/domain/order/LineDiscount.ts b/src/ordering/domain/order/LineDiscount.ts
new file mode 100644
index 000000000..4a92964ae
--- /dev/null
+++ b/src/ordering/domain/order/LineDiscount.ts
@@ -0,0 +1,36 @@
+import { Money } from '../../../shared-kernel/value-objects/Money.js';
+
+export const MAX_DISCOUNT_PERCENT = 30;
+
+/** Value object: a percentage or fixed discount on one order line, always with a reason. */
+export class LineDiscount {
+  private constructor(
+    private readonly percent: number | null,
+    private readonly fixed: Money | null,
+    readonly reason: string,
+  ) {}
+
+  static percentage(percent: number, reason: string): LineDiscount {
+    if (!Number.isFinite(percent) || percent <= 0 || percent > MAX_DISCOUNT_PERCENT) {
+      throw new Error(`Discount percentage must be above 0 and at most ${String(MAX_DISCOUNT_PERCENT)}`);
+    }
+    return new LineDiscount(percent, null, LineDiscount.requireReason(reason));
+  }
+
+  static fixedAmount(amount: Money, reason: string): LineDiscount {
+    if (amount.cents <= 0) throw new Error('Discount amount must be positive');
+    return new LineDiscount(null, amount, LineDiscount.requireReason(reason));
+  }
+
+  private static requireReason(reason: string): string {
+    const trimmed = typeof reason === 'string' ? reason.trim() : '';
+    if (trimmed === '') throw new Error('A discount needs a reason');
+    return trimmed;
+  }
+
+  /** The amount taken off a line whose undiscounted amount is `base`. */
+  amountOn(base: Money): Money {
+    if (this.fixed !== null) return this.fixed;
+    return base.times((this.percent ?? 0) / 100);
+  }
+}
