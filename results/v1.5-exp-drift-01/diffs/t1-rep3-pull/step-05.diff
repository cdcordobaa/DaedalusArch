--- /dev/null
+++ b/src/ordering/domain/order/value-objects/LineDiscount.ts
@@ -0,0 +1,33 @@
+import { Money } from '../../../../shared-kernel/value-objects/Money.js';
+
+export const MAX_DISCOUNT_PERCENT = 30;
+
+/** Value object: a discount on one order line, either a percentage or a fixed amount, always with a reason. */
+export class LineDiscount {
+  private constructor(readonly percent: number | null, readonly fixed: Money | null, readonly reason: string) {}
+
+  static percentage(percent: number, reason: string): LineDiscount {
+    if (!Number.isFinite(percent) || percent <= 0) throw new Error('A discount percentage must be positive');
+    if (percent > MAX_DISCOUNT_PERCENT) throw new Error(`A discount must not exceed ${MAX_DISCOUNT_PERCENT}%`);
+    return new LineDiscount(percent, null, LineDiscount.cleanReason(reason));
+  }
+
+  static amount(amount: Money, reason: string): LineDiscount {
+    if (amount.cents <= 0) throw new Error('A discount amount must be positive');
+    return new LineDiscount(null, amount, LineDiscount.cleanReason(reason));
+  }
+
+  private static cleanReason(reason: string): string {
+    const trimmed = typeof reason === 'string' ? reason.trim() : '';
+    if (trimmed === '') throw new Error('A discount needs a reason');
+    return trimmed;
+  }
+
+  /** The amount taken off a line worth `base`. */
+  amountOff(base: Money): Money {
+    const off = this.fixed ?? base.times(this.percent! / 100);
+    if (off.currency !== base.currency) throw new Error('Currency mismatch');
+    if (off.isGreaterThan(base)) throw new Error('A discount must not take a line below zero');
+    return off;
+  }
+}
