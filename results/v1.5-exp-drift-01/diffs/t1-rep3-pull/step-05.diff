@@ -0,0 +1,25 @@
+import { Money } from '../../shared-kernel/value-objects/Money.js';
+import type { OrderRepository } from '../domain/order/OrderRepository.js';
+import { OrderId } from '../domain/order/value-objects/OrderId.js';
+import { LineDiscount } from '../domain/order/value-objects/LineDiscount.js';
+import type { InvoiceStatusSource } from './ports/InvoiceStatusSource.js';
+
+export type DiscountOrderLineCommand =
+  | { readonly orderId: string; readonly lineNo: number; readonly reason: string; readonly percent: number }
+  | { readonly orderId: string; readonly lineNo: number; readonly reason: string; readonly amountCents: number };
+
+/** Application service: loads the order, lets the aggregate guard the rules, saves. */
+export class DiscountOrderLine {
+  constructor(private readonly orders: OrderRepository, private readonly invoices: InvoiceStatusSource) {}
+
+  async execute(cmd: DiscountOrderLineCommand): Promise<void> {
+    const order = await this.orders.byId(new OrderId(cmd.orderId));
+    if (order === null) throw new Error('Unknown order');
+    const discount =
+      'percent' in cmd
+        ? LineDiscount.percentage(cmd.percent, cmd.reason)
+        : LineDiscount.amount(Money.of(cmd.amountCents, order.currency), cmd.reason);
+    order.discountLine(cmd.lineNo, discount, await this.invoices.isInvoiced(cmd.orderId));
+    await this.orders.save(order);
+  }
+}
