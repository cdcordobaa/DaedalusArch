+import { AuditTrail } from '../../../application/ports/in/AuditTrail';
+import { HttpRequest, HttpResponse } from './HttpTypes';
+
+const DATE_ONLY = /^\d{4}-\d{2}-\d{2}$/;
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+/** Parses a query date; a date-only `to` covers the whole day. */
+function parseBound(value: string | undefined, endOfDay: boolean): Date | undefined {
+  if (value === undefined || value === '') return undefined;
+  const parsed = new Date(value);
+  if (Number.isNaN(parsed.getTime())) return undefined;
+  return endOfDay && DATE_ONLY.test(value) ? new Date(parsed.getTime() + DAY_MS - 1) : parsed;
+}
+
+/** Driving adapter: audit trail queries for staff. */
+export class AuditController {
+  constructor(private readonly trail: AuditTrail) {}
+
+  async forBooking(request: HttpRequest): Promise<HttpResponse> {
+    return { status: 200, body: await this.trail.listForBooking(String(request.params['id'])) };
+  }
+
+  /** `GET .../staff/:id/audit?from=...&to=...` */
+  async forStaff(request: HttpRequest): Promise<HttpResponse> {
+    const from = parseBound(request.query['from'], false);
+    const to = parseBound(request.query['to'], true);
+    if (from === undefined || to === undefined) {
+      return { status: 400, body: { error: 'from and to must be valid dates' } };
+    }
+    if (from > to) return { status: 400, body: { error: 'from must not be after to' } };
+    return { status: 200, body: await this.trail.listForStaff(String(request.params['id']), from, to) };
+  }
+}
