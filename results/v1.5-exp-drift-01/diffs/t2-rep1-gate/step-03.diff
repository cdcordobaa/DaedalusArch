+export type AuditAction = 'book' | 'charge' | 'cancel' | 'refund' | 'refund-failed';
+
+/** Who did what to a booking, when, and the values before and after. */
+export interface AuditRecord {
+  readonly id: string;
+  readonly staffId: string;
+  readonly at: Date;
+  readonly action: AuditAction;
+  readonly bookingId: string;
+  /** Null when nothing existed before the change (booking, charge). */
+  readonly before: Readonly<Record<string, unknown>> | null;
+  readonly after: Readonly<Record<string, unknown>>;
+}
+
+/** What an aggregate records about a change; the store assigns the id when it saves it. */
+export type AuditEvent = Omit<AuditRecord, 'id' | 'bookingId'>;
+
+/** Actor recorded when a request carries no staff id. */
+export const DEFAULT_STAFF_ID = 'guest';
