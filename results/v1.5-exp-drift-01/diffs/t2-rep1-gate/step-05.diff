diff --git a/src/adapters/outbound/persistence/PostgresBookingRepository.ts b/src/adapters/outbound/persistence/PostgresBookingRepository.ts
new file mode 100644
index 000000000..ded63e773
--- /dev/null
+++ b/src/adapters/outbound/persistence/PostgresBookingRepository.ts
@@ -0,0 +1,184 @@
+import { AsyncLocalStorage } from 'node:async_hooks';
+import { randomUUID } from 'node:crypto';
+import { Queryable } from 'sqlwell';
+import { AuditLog } from '../../../application/ports/out/AuditLog';
+import { BookingRepository } from '../../../application/ports/out/BookingRepository';
+import { AuditAction, AuditRecord } from '../../../domain/model/AuditRecord';
+import { Booking, BookingStatus } from '../../../domain/model/Booking';
+import { DateRange } from '../../../domain/model/DateRange';
+import { Money } from '../../../domain/model/Money';
+import { parseJson, PostgresDatabase } from './PostgresDatabase';
+
+interface BookingRow {
+  id: string;
+  room_id: string;
+  guest_id: string;
+  check_in: Date | string;
+  check_out: Date | string;
+  total: string | number;
+  status: BookingStatus;
+  refund_pending: boolean;
+  payment_ref: string;
+}
+
+interface AuditRow {
+  seq: string | number;
+  booking_id: string;
+  staff_id: string;
+  at: Date | string;
+  action: AuditAction;
+  before: unknown;
+  after: unknown;
+}
+
+const BOOKING_COLUMNS =
+  'id, room_id, guest_id, check_in, check_out, total_cents::text AS total, status, refund_pending, payment_ref';
+const AUDIT_COLUMNS = 'seq::text AS seq, booking_id, staff_id, at, action, before, after';
+
+function toBooking(row: BookingRow): Booking {
+  return Booking.restore({
+    id: row.id,
+    roomId: row.room_id,
+    guestId: row.guest_id,
+    stay: new DateRange(new Date(row.check_in), new Date(row.check_out)),
+    total: Money.ofCents(Number(row.total)),
+    paymentRef: row.payment_ref,
+    status: row.status,
+    refundPending: row.refund_pending,
+  });
+}
+
+function toAuditRecord(row: AuditRow): AuditRecord {
+  return {
+    id: `au-${row.seq}`,
+    bookingId: row.booking_id,
+    staffId: row.staff_id,
+    at: new Date(row.at),
+    action: row.action,
+    before: row.before === null ? null : parseJson<Record<string, unknown>>(row.before),
+    after: parseJson<Record<string, unknown>>(row.after),
+  };
+}
+
+export class PostgresBookingRepository implements BookingRepository, AuditLog {
+  /** The transaction of the enclosing `exclusively` call, so reads and `save` join it. */
+  private readonly current = new AsyncLocalStorage<Queryable>();
+
+  constructor(private readonly db: PostgresDatabase) {}
+
+  private executor(): Queryable {
+    return this.current.getStore() ?? this.db.pool;
+  }
+
+  /**
+   * Runs `work` in one database transaction holding a row lock on the room, so that servers booking the
+   * same room take turns: the overlap check, the charge and the save are one unit.
+   */
+  async exclusively<T>(roomId: string, work: () => Promise<T>): Promise<T> {
+    await this.db.ensureSchema();
+    return this.db.pool.transaction((tx) => {
+      return tx
+        .query('SELECT id FROM rooms WHERE id = $1 FOR UPDATE', [roomId])
+        .then(() => this.current.run(tx, work));
+    });
+  }
+
+  async findById(id: string): Promise<Booking | undefined> {
+    await this.db.ensureSchema();
+    const result = await this.executor().query<BookingRow>(`SELECT ${BOOKING_COLUMNS} FROM bookings WHERE id = $1`, [id]);
+    return result.rows[0] === undefined ? undefined : toBooking(result.rows[0]);
+  }
+
+  async findByRoom(roomId: string): Promise<Booking[]> {
+    await this.db.ensureSchema();
+    const result = await this.executor().query<BookingRow>(
+      `SELECT ${BOOKING_COLUMNS} FROM bookings WHERE room_id = $1 ORDER BY id`,
+      [roomId],
+    );
+    return result.rows.map(toBooking);
+  }
+
+  async findActive(): Promise<Booking[]> {
+    await this.db.ensureSchema();
+    const result = await this.executor().query<BookingRow>(
+      `SELECT ${BOOKING_COLUMNS} FROM bookings WHERE status = 'confirmed' ORDER BY id`,
+    );
+    return result.rows.map(toBooking);
+  }
+
+  async findPendingRefunds(): Promise<Booking[]> {
+    await this.db.ensureSchema();
+    const result = await this.executor().query<BookingRow>(
+      `SELECT ${BOOKING_COLUMNS} FROM bookings WHERE refund_pending ORDER BY id`,
+    );
+    return result.rows.map(toBooking);
+  }
+
+  async save(booking: Booking): Promise<void> {
+    await this.db.ensureSchema();
+    const events = booking.pullEvents();
+    const write = async (q: Queryable): Promise<void> => {
+      await q.query(
+        `INSERT INTO bookings (id, room_id, guest_id, check_in, check_out, total_cents, status, refund_pending, payment_ref)
+         VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9)
+         ON CONFLICT (id) DO UPDATE SET status = EXCLUDED.status, refund_pending = EXCLUDED.refund_pending`,
+        [
+          booking.id,
+          booking.roomId,
+          booking.guestId,
+          booking.stay.checkIn,
+          booking.stay.checkOut,
+          booking.total.cents,
+          booking.status,
+          booking.refundPending,
+          booking.paymentRef,
+        ],
+      );
+      for (const event of events) {
+        await q.query(
+          `INSERT INTO audit_records (booking_id, staff_id, at, action, before, after)
+           VALUES ($1, $2, $3, $4, $5::jsonb, $6::jsonb)`,
+          [
+            booking.id,
+            event.staffId,
+            event.at,
+            event.action,
+            event.before === null ? null : JSON.stringify(event.before),
+            JSON.stringify(event.after),
+          ],
+        );
+      }
+    };
+    try {
+      const joined = this.current.getStore();
+      if (joined !== undefined) await write(joined);
+      else await this.db.pool.transaction(write);
+    } catch (error) {
+      for (const event of events) booking.recordEvent(event);
+      throw error;
+    }
+  }
+
+  async findByBooking(bookingId: string): Promise<AuditRecord[]> {
+    await this.db.ensureSchema();
+    const result = await this.db.pool.query<AuditRow>(
+      `SELECT ${AUDIT_COLUMNS} FROM audit_records WHERE booking_id = $1 ORDER BY seq`,
+      [bookingId],
+    );
+    return result.rows.map(toAuditRecord);
+  }
+
+  async findByStaff(staffId: string, from: Date, to: Date): Promise<AuditRecord[]> {
+    await this.db.ensureSchema();
+    const result = await this.db.pool.query<AuditRow>(
+      `SELECT ${AUDIT_COLUMNS} FROM audit_records WHERE staff_id = $1 AND at >= $2 AND at <= $3 ORDER BY at, seq`,
+      [staffId, from, to],
+    );
+    return result.rows.map(toAuditRecord);
+  }
+
+  /** Unique across servers without a round trip. */
+  nextId(): string {
+    return `bk-${randomUUID()}`;
+  }
+}
diff --git a/src/adapters/outbound/persistence/PostgresDatabase.ts b/src/adapters/outbound/persistence/PostgresDatabase.ts
new file mode 100644
index 000000000..8f669e57c
--- /dev/null
+++ b/src/adapters/outbound/persistence/PostgresDatabase.ts
@@ -0,0 +1,85 @@
+import { Pool, Queryable } from 'sqlwell';
+
+const SCHEMA = [
+  `CREATE TABLE IF NOT EXISTS rooms (
+    id text PRIMARY KEY,
+    number text NOT NULL,
+    nightly_rate_cents bigint NOT NULL,
+    capacity integer NOT NULL
+  )`,
+  `CREATE TABLE IF NOT EXISTS guests (
+    id text PRIMARY KEY,
+    name text NOT NULL,
+    email text NOT NULL
+  )`,
+  `CREATE TABLE IF NOT EXISTS bookings (
+    id text PRIMARY KEY,
+    room_id text NOT NULL REFERENCES rooms (id),
+    guest_id text NOT NULL REFERENCES guests (id),
+    check_in timestamptz NOT NULL,
+    check_out timestamptz NOT NULL,
+    total_cents bigint NOT NULL,
+    status text NOT NULL,
+    refund_pending boolean NOT NULL DEFAULT false,
+    payment_ref text NOT NULL
+  )`,
+  `CREATE INDEX IF NOT EXISTS bookings_room_idx ON bookings (room_id)`,
+  `CREATE TABLE IF NOT EXISTS audit_records (
+    seq bigserial PRIMARY KEY,
+    booking_id text NOT NULL REFERENCES bookings (id),
+    staff_id text NOT NULL,
+    at timestamptz NOT NULL,
+    action text NOT NULL,
+    before jsonb,
+    after jsonb NOT NULL
+  )`,
+  `CREATE INDEX IF NOT EXISTS audit_records_booking_idx ON audit_records (booking_id)`,
+  `CREATE INDEX IF NOT EXISTS audit_records_staff_idx ON audit_records (staff_id, at)`,
+  `INSERT INTO rooms (id, number, nightly_rate_cents, capacity) VALUES
+    ('r-101', '101', 9000, 2),
+    ('r-102', '102', 12000, 3),
+    ('r-201', '201', 20000, 4)
+   ON CONFLICT (id) DO NOTHING`,
+  `INSERT INTO guests (id, name, email) VALUES ('g-1', 'Alistair', 'alistair@example.org')
+   ON CONFLICT (id) DO NOTHING`,
+];
+
+/** Shared sqlwell pool; creates the schema (and seed rows) once, before the first query. */
+export class PostgresDatabase {
+  readonly pool: Pool;
+  private ready: Promise<void> | undefined;
+
+  constructor(connectionString: string) {
+    this.pool = new Pool({ connectionString });
+  }
+
+  static fromEnvironment(env: NodeJS.ProcessEnv = process.env): PostgresDatabase | undefined {
+    const url = env['DATABASE_URL'];
+    return url ? new PostgresDatabase(url) : undefined;
+  }
+
+  /** Resolves once the schema exists. Concurrent servers are serialised by an advisory lock. */
+  ensureSchema(): Promise<void> {
+    if (this.ready === undefined) {
+      this.ready = this.pool
+        .transaction(async (tx: Queryable) => {
+          await tx.query('SELECT pg_advisory_xact_lock(727001)');
+          for (const statement of SCHEMA) await tx.query(statement);
+        })
+        .catch((error: unknown) => {
+          this.ready = undefined;
+          throw error;
+        });
+    }
+    return this.ready;
+  }
+
+  close(): Promise<void> {
+    return this.pool.end();
+  }
+}
+
+/** Reads a jsonb column whether the client returns it parsed or as text. */
+export function parseJson<T>(value: unknown): T {
+  return (typeof value === 'string' ? JSON.parse(value) : value) as T;
+}
