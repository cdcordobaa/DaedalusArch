+import { RoomRepository } from '../../../application/ports/out/RoomRepository';
+import { Money } from '../../../domain/model/Money';
+import { Room } from '../../../domain/model/Room';
+import { PostgresDatabase } from './PostgresDatabase';
+
+interface RoomRow {
+  id: string;
+  number: string;
+  rate: string | number;
+  capacity: number;
+}
+
+const COLUMNS = 'id, number, nightly_rate_cents::text AS rate, capacity';
+
+function toRoom(row: RoomRow): Room {
+  return new Room(row.id, row.number, Money.ofCents(Number(row.rate)), Number(row.capacity));
+}
+
+export class PostgresRoomRepository implements RoomRepository {
+  constructor(private readonly db: PostgresDatabase) {}
+
+  async findById(id: string): Promise<Room | undefined> {
+    await this.db.ensureSchema();
+    const result = await this.db.pool.query<RoomRow>(`SELECT ${COLUMNS} FROM rooms WHERE id = $1`, [id]);
+    return result.rows[0] === undefined ? undefined : toRoom(result.rows[0]);
+  }
+
+  async findAll(): Promise<Room[]> {
+    await this.db.ensureSchema();
+    const result = await this.db.pool.query<RoomRow>(`SELECT ${COLUMNS} FROM rooms ORDER BY id`);
+    return result.rows.map(toRoom);
+  }
+}
