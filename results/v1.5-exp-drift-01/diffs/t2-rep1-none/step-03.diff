@@ -0,0 +1,32 @@
+import { AuditTrail } from '../../../application/ports/in/AuditTrail';
+import { BookingError } from '../../../domain/errors/BookingError';
+import { HttpRequest, HttpResponse } from './HttpTypes';
+
+const STATUS = { 'not-found': 404, unavailable: 409, invalid: 400, 'payment-declined': 402 } as const;
+
+export class AuditController {
+  constructor(private readonly trail: AuditTrail) {}
+
+  async forBooking(request: HttpRequest): Promise<HttpResponse> {
+    try {
+      return { status: 200, body: await this.trail.listForBooking(String(request.params['id'])) };
+    } catch (error) {
+      return this.toResponse(error);
+    }
+  }
+
+  async forStaff(request: HttpRequest): Promise<HttpResponse> {
+    try {
+      const { from, to } = request.query;
+      if (from === undefined || to === undefined) throw new BookingError('invalid', 'from and to are required');
+      return { status: 200, body: await this.trail.listForStaff(String(request.params['staffId']), from, to) };
+    } catch (error) {
+      return this.toResponse(error);
+    }
+  }
+
+  private toResponse(error: unknown): HttpResponse {
+    if (error instanceof BookingError) return { status: STATUS[error.reason], body: { error: error.message } };
+    return { status: 500, body: { error: 'Internal error' } };
+  }
+}
