+
+/** Staff id from the X-Staff-Id header, or "guest" when absent or blank. */
+export function staffIdOf(request: HttpRequest): string {
+  for (const [name, value] of Object.entries(request.headers ?? {})) {
+    if (name.toLowerCase() !== 'x-staff-id') continue;
+    const text = (Array.isArray(value) ? value[0] : value)?.trim();
+    if (text) return text;
+  }
+  return 'guest';
