+import { BookingView } from '../in/BookingView';
+
+export type AuditAction = 'book' | 'cancel' | 'charge' | 'refund';
+
+export interface AuditRecord {
+  id: string;
+  staffId: string;
+  action: AuditAction;
+  bookingId: string;
+  /** ISO-8601 time of the change. */
+  at: string;
+  before: BookingView | null;
+  after: BookingView | null;
+}
+
+/** Driven port: read side of the audit trail. Records are written only together with a booking save. */
+export interface AuditLog {
+  findByBooking(bookingId: string): Promise<AuditRecord[]>;
+  /** Records made by one staff user with `from <= at < to`. */
+  findByStaff(staffId: string, from: Date, to: Date): Promise<AuditRecord[]>;
+  nextAuditId(): string;
+}
