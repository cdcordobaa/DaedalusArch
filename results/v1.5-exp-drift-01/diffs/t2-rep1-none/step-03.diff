+++ b/src/application/services/AuditTrailService.ts
@@ -0,0 +1,28 @@
+import { BookingError } from '../../domain/errors/BookingError';
+import { AuditTrail } from '../ports/in/AuditTrail';
+import { AuditLog, AuditRecord } from '../ports/out/AuditLog';
+
+const DATE_ONLY = /^\d{4}-\d{2}-\d{2}$/;
+
+function parseInstant(text: string, label: string): Date {
+  const date = new Date(text);
+  if (Number.isNaN(date.getTime())) throw new BookingError('invalid', `Invalid ${label} date: ${text}`);
+  return date;
+}
+
+export class AuditTrailService implements AuditTrail {
+  constructor(private readonly audit: AuditLog) {}
+
+  listForBooking(bookingId: string): Promise<AuditRecord[]> {
+    return this.audit.findByBooking(bookingId);
+  }
+
+  async listForStaff(staffId: string, from: string, to: string): Promise<AuditRecord[]> {
+    const start = parseInstant(from, 'from');
+    const end = parseInstant(to, 'to');
+    if (DATE_ONLY.test(to)) end.setUTCDate(end.getUTCDate() + 1);
+    else end.setTime(end.getTime() + 1);
+    if (end.getTime() <= start.getTime()) throw new BookingError('invalid', 'Range end is before its start');
+    return this.audit.findByStaff(staffId, start, end);
+  }
+}
