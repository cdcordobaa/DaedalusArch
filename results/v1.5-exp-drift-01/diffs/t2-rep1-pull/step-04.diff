index 000000000..c5c6ddfcf
--- /dev/null
+++ b/src/application/services/OccupancyReportService.ts
@@ -0,0 +1,69 @@
+import { BookingError } from '../../domain/errors/BookingError';
+import { NightlyOccupancy, OccupancyReport } from '../ports/in/OccupancyReport';
+import { BookingRepository } from '../ports/out/BookingRepository';
+import { RoomRepository } from '../ports/out/RoomRepository';
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const MAX_NIGHTS = 90;
+
+export class OccupancyReportService implements OccupancyReport {
+  constructor(
+    private readonly rooms: RoomRepository,
+    private readonly bookings: BookingRepository,
+  ) {}
+
+  async report(from: string, to: string): Promise<NightlyOccupancy[]> {
+    const start = new Date(from).getTime();
+    const end = new Date(to).getTime();
+    if (Number.isNaN(start) || Number.isNaN(end) || start > end) {
+      throw new BookingError('invalid', 'Invalid date range');
+    }
+    const first = Math.floor(start / DAY_MS);
+    const nights = Math.floor(end / DAY_MS) - first + 1;
+    if (nights > MAX_NIGHTS) throw new BookingError('invalid', `Range exceeds ${MAX_NIGHTS} nights`);
+
+    const [rooms, active] = await Promise.all([this.rooms.findAll(), this.bookings.findActive()]);
+    const roomIndex = new Map<string, number>();
+    rooms.forEach((room, i) => roomIndex.set(room.id, i));
+
+    // revenue[room * nights + night]; occupied marks the same cells (a room is occupied once per night).
+    const revenue = new Float64Array(rooms.length * nights);
+    const occupied = new Uint8Array(rooms.length * nights);
+    for (const booking of active) {
+      const room = roomIndex.get(booking.roomId);
+      if (room === undefined) continue;
+      const stayNights = Math.max(1, booking.stay.nights());
+      const bookingFirst = Math.floor(booking.stay.checkIn.getTime() / DAY_MS);
+      const perNight = booking.total.cents / stayNights;
+      const lo = Math.max(bookingFirst, first);
+      const hi = Math.min(bookingFirst + stayNights - 1, first + nights - 1);
+      for (let day = lo; day <= hi; day++) {
+        const cell = room * nights + (day - first);
+        occupied[cell] = 1;
+        revenue[cell] += perNight;
+      }
+    }
+
+    const result: NightlyOccupancy[] = [];
+    for (let n = 0; n < nights; n++) {
+      let count = 0;
+      let total = 0;
+      const revenueByRoom = [];
+      for (let r = 0; r < rooms.length; r++) {
+        const cell = r * nights + n;
+        if (!occupied[cell]) continue;
+        count++;
+        total += revenue[cell];
+        revenueByRoom.push({ roomId: rooms[r].id, revenueCents: revenue[cell] });
+      }
+      result.push({
+        night: new Date((first + n) * DAY_MS).toISOString().slice(0, 10),
+        roomsOccupied: count,
+        occupancyRate: rooms.length === 0 ? 0 : count / rooms.length,
+        totalRevenueCents: total,
+        revenueByRoom,
+      });
+    }
+    return result;
+  }
+}
