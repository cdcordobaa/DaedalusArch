@@ -0,0 +1,21 @@
+export interface NightlyRoomRevenue {
+  roomId: string;
+  revenueCents: number;
+}
+
+export interface NightlyOccupancy {
+  /** The night, as an ISO date (YYYY-MM-DD, UTC). */
+  night: string;
+  roomsOccupied: number;
+  /** Occupied rooms over all rooms, 0..1. */
+  occupancyRate: number;
+  totalRevenueCents: number;
+  /** Only rooms with revenue that night. */
+  revenueByRoom: NightlyRoomRevenue[];
+}
+
+/** Driving port: occupancy and revenue per night for the revenue manager. */
+export interface OccupancyReport {
+  /** `from` and `to` are ISO dates, both inclusive; at most 90 nights. */
+  report(from: string, to: string): Promise<NightlyOccupancy[]>;
+}
diff --git a/src/application/services/OccupancyReportService.ts b/src/application/services/OccupancyReportService.ts
