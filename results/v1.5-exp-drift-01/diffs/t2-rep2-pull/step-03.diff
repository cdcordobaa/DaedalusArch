diff --git a/src/domain/model/AuditRecord.ts b/src/domain/model/AuditRecord.ts
new file mode 100644
index 000000000..1b21a1d4c
--- /dev/null
+++ b/src/domain/model/AuditRecord.ts
@@ -0,0 +1,13 @@
+export type AuditAction = 'booking' | 'cancellation' | 'charge' | 'refund';
+
+export type AuditValues = Readonly<Record<string, unknown>> | null;
+
+/** Who changed what and when, with the values before and after the change. */
+export interface AuditRecord {
+  readonly staffId: string;
+  readonly action: AuditAction;
+  readonly bookingId: string;
+  readonly at: Date;
+  readonly before: AuditValues;
+  readonly after: AuditValues;
+}
