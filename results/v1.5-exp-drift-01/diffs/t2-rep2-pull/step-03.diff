@@ -0,0 +1,17 @@
+import { BookingError } from '../../domain/errors/BookingError';
+import { AuditRecord } from '../../domain/model/AuditRecord';
+import { AuditTrail } from '../ports/in/AuditTrail';
+import { BookingRepository } from '../ports/out/BookingRepository';
+
+export class AuditTrailService implements AuditTrail {
+  constructor(private readonly bookings: BookingRepository) {}
+
+  forBooking(bookingId: string): Promise<AuditRecord[]> {
+    return this.bookings.auditByBooking(bookingId);
+  }
+
+  async forStaff(staffId: string, from: Date, to: Date): Promise<AuditRecord[]> {
+    if (Number.isNaN(from.getTime()) || Number.isNaN(to.getTime())) throw new BookingError('invalid', 'Invalid date range');
+    return this.bookings.auditByStaff(staffId, from, to);
+  }
+}
