new file mode 100644
index 000000000..a46640861
--- /dev/null
+++ b/src/application/services/AuditTrailService.ts
@@ -0,0 +1,42 @@
+import { BookingError } from '../../domain/errors/BookingError';
+import { AuditEntry } from '../../domain/model/AuditEntry';
+import { AuditRecordView, AuditTrail } from '../ports/in/AuditTrail';
+import { BookingRepository } from '../ports/out/BookingRepository';
+
+const DAY_ONLY = /^\d{4}-\d{2}-\d{2}$/;
+
+function parseInstant(text: string, endOfDay: boolean): Date {
+  const date = new Date(DAY_ONLY.test(text) && endOfDay ? `${text}T23:59:59.999Z` : text);
+  if (Number.isNaN(date.getTime())) throw new BookingError('invalid', `Invalid date: ${text}`);
+  return date;
+}
+
+function toView(record: AuditEntry): AuditRecordView {
+  return {
+    id: record.id,
+    bookingId: record.bookingId,
+    staffId: record.staffId,
+    action: record.action,
+    at: record.at.toISOString(),
+    before: record.before === null ? null : { ...record.before },
+    after: record.after === null ? null : { ...record.after },
+  };
+}
+
+export class AuditTrailService implements AuditTrail {
+  constructor(private readonly bookings: BookingRepository) {}
+
+  async forBooking(bookingId: string): Promise<AuditRecordView[]> {
+    if ((await this.bookings.findById(bookingId)) === undefined) {
+      throw new BookingError('not-found', `No booking ${bookingId}`);
+    }
+    return (await this.bookings.findAuditByBooking(bookingId)).map(toView);
+  }
+
+  async byStaff(staffId: string, from: string, to: string): Promise<AuditRecordView[]> {
+    const start = parseInstant(from, false);
+    const end = parseInstant(to, true);
+    if (start > end) throw new BookingError('invalid', 'from is after to');
+    return (await this.bookings.findAuditByStaff(staffId, start, end)).map(toView);
+  }
+}
