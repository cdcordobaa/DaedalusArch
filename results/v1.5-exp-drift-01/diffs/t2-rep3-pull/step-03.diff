 import { Money } from './Money';
 
@@ -30,6 +31,32 @@ export class Booking {
     this.refundOutstanding = false;
   }
 
+  private recorded = 0;
+  private pendingAudit: AuditEntry[] = [];
+
+  /** The audited values right now, as plain data. */
+  snapshot(): AuditValues {
+    return {
+      status: this.bookingStatus,
+      totalCents: this.total.cents,
+      paymentRef: this.paymentRef,
+      refundPending: this.refundOutstanding,
+    };
+  }
+
+  /** Notes a change on this booking; it is stored with the booking when the booking is saved. */
+  recordChange(action: AuditAction, staffId: string, at: Date, before: AuditValues | null, after: AuditValues | null): void {
+    this.recorded += 1;
+    this.pendingAudit.push({ id: `${this.id}-a${this.recorded}`, bookingId: this.id, staffId, action, at, before, after });
+  }
+
+  /** Hands the not yet stored audit entries to the repository saving this booking. */
+  takeAuditEntries(): AuditEntry[] {
+    const entries = this.pendingAudit;
+    this.pendingAudit = [];
+    return entries;
+  }
+
   get status(): BookingStatus {
     return this.bookingStatus;
   }
