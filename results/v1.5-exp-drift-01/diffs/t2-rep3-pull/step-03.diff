@@ -0,0 +1,15 @@
+export type AuditAction = 'booking' | 'cancellation' | 'charge' | 'refund';
+
+/** Plain-data copy of the audited values of a booking at one moment. */
+export type AuditValues = Readonly<Record<string, string | number | boolean | null>>;
+
+/** Immutable account of one change: who made it, when, and the values before and after. */
+export interface AuditEntry {
+  readonly id: string;
+  readonly bookingId: string;
+  readonly staffId: string;
+  readonly action: AuditAction;
+  readonly at: Date;
+  readonly before: AuditValues | null;
+  readonly after: AuditValues | null;
+}
