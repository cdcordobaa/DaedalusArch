+++ b/step-01/src/adapters/out/gps/TrackpointPositions.ts
@@ -0,0 +1,13 @@
+import type { RiderPosition, RiderPositions } from '../../../application/ports/out/RiderPositions';
+import type { TrackpointClient } from './TrackpointClient';
+
+/** Reads rider positions from Trackpoint, converting 1e-7 degrees and epoch milliseconds. */
+export class TrackpointPositions implements RiderPositions {
+  constructor(private readonly client: TrackpointClient) {}
+
+  async latest(trackerId: string): Promise<RiderPosition | null> {
+    const fix = await this.client.lastFix(trackerId);
+    if (fix === null) return null;
+    return { point: { lat: fix.latE7 / 1e7, lng: fix.lonE7 / 1e7 }, at: new Date(fix.fixedAtMs) };
+  }
+}
