+/** Months are written YYYY-MM, month 01 to 12. */
+export function requireMonth(month: string): string {
+  const m = /^(\d{4})-(\d{2})$/.exec(month);
+  if (m === null || Number(m[2]) < 1 || Number(m[2]) > 12) throw new ShelterError(`not a month: ${month}`);
+  return month;
+}
