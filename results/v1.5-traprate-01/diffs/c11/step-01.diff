@@ -0,0 +1,16 @@
+import type { TeacherCalendar } from '../../../application/ports/out/TeacherCalendar';
+import type { TimeWindow } from '../../../domain/time/TimeWindow';
+import type { TempoCalendarClient } from './TempoCalendarClient';
+
+/** Lessons are events of category APPOINTMENT, so they never count as teaching hours. */
+export class TempoTeacherCalendar implements TeacherCalendar {
+  constructor(private readonly tempo: TempoCalendarClient) {}
+
+  addAppointment(calendarId: string, title: string, date: string, slot: TimeWindow): string {
+    return this.tempo.createEvent(calendarId, { summary: title, day: date, startsAt: slot.start, endsAt: slot.end, category: 'APPOINTMENT' });
+  }
+
+  removeAppointment(calendarId: string, eventId: string): void {
+    this.tempo.deleteEvent(calendarId, eventId);
+  }
+}
