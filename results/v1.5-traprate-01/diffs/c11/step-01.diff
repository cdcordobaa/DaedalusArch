+/** The teacher's own calendar, where booked lessons appear as appointments. */
+export interface TeacherCalendar {
+  /** Puts an appointment on the calendar and answers its event id. */
+  addAppointment(calendarId: string, title: string, date: string, slot: TimeWindow): string;
+  removeAppointment(calendarId: string, eventId: string): void;
+}
