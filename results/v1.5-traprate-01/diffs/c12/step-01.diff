+/** A usable mid rate from EUR to a currency. */
+export interface EuroRate {
+  readonly currency: string;
+  readonly mid: number;
+}
+
+export interface ExchangeRates {
+  /** The latest usable rate from EUR to the currency, or undefined when there is none. */
+  fromEuro(currency: string): Promise<EuroRate | undefined>;
+}
