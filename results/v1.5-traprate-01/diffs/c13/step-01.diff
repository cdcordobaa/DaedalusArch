@@ -6,8 +6,17 @@ import type { BackerLookup } from './ports/BackerLookup';
 export interface PledgeReceipt {
   readonly pledgeId: string;
   readonly campaignTotal: number;
+  /** Room the backer has left on this campaign after the pledge. */
