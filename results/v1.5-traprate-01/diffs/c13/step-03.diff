-    for (let batch = this.pending.drain(); batch.length > 0; batch = this.pending.drain()) {
-      for (const event of batch) {
-        for (const s of this.subscribers) if (s.type === event.type) s.run(event);
+    for (let progressed = true; progressed; ) {
+      progressed = false;
+      for (const { id, event } of this.pending.pending()) {
+        let allHandled = true;
+        for (const s of this.subscribers) {
+          if (s.type !== event.type || this.pending.isHandled(id, s.key)) continue;
+          try {
+            s.run(event);
