+/** Where the finance office picks up its files. */
+export interface FinanceFolder {
+  /** Stores the file, replacing any file of the same name. */
+  write(name: string, text: string): void;
+  /** The file text, or null when there is no such file. */
+  read(name: string): string | null;
+  /** The file names, in name order. */
+  names(): string[];
+}
