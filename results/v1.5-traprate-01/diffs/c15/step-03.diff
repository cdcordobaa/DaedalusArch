@@ -0,0 +1,18 @@
+import type { FinanceFolder } from '../../../application/ports/out/FinanceFolder';
+
+/** The finance folder, kept in memory. */
+export class MemoryFinanceFolder implements FinanceFolder {
+  private readonly files = new Map<string, string>();
+
+  write(name: string, text: string): void {
+    this.files.set(name, text);
+  }
+
+  read(name: string): string | null {
+    return this.files.get(name) ?? null;
+  }
+
+  names(): string[] {
+    return [...this.files.keys()].sort((a, b) => (a < b ? -1 : a > b ? 1 : 0));
+  }
+}
