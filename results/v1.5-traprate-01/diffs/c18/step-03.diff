+  async sendReminders(now: Date): Promise<string[]> {
+    const reminded: string[] = [];
+    for (const agreement of await this.store.all()) {
+      if (agreement.envelopeId === undefined || !agreement.isDueForReminder(now, LINK_VALID_DAYS)) continue;
+      const unsigned = (await this.sender.unsignedSigners(agreement.envelopeId)).map((e) => e.toLowerCase());
+      const emails = agreement.tenants.filter((t) => unsigned.includes(t.email.toLowerCase())).map((t) => t.email);
+      if (emails.length === 0) continue;
+      if (!(await this.sender.remind(agreement.envelopeId, emails))) continue;
+      agreement.markReminded(now);
+      await this.store.save(agreement);
+      reminded.push(agreement.id);
+    }
+    return reminded;
+  }
