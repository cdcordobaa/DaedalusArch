+++ b/step-01/src/adapters/out/calendar/TempoLessonCalendar.ts
@@ -0,0 +1,23 @@
+import type { Lesson } from '../../../domain/lessons/Lesson';
+import { formatTime } from '../../../domain/time/TimeOfDay';
+import type { LessonCalendar } from '../../../application/ports/out/LessonCalendar';
+import type { TempoCalendarClient } from './TempoCalendarClient';
+
+/** Lessons are APPOINTMENT events in the teacher's Tempo calendar, so teaching hours are untouched. */
+export class TempoLessonCalendar implements LessonCalendar {
+  constructor(private readonly tempo: TempoCalendarClient) {}
+
+  add(calendarId: string, lesson: Lesson, studentName: string): string {
+    return this.tempo.createEvent(calendarId, {
+      summary: `${lesson.instrument} lesson: ${studentName}`,
+      day: lesson.date,
+      startsAt: formatTime(lesson.slot.start),
+      endsAt: formatTime(lesson.slot.end),
+      category: 'APPOINTMENT',
+    });
+  }
+
+  remove(calendarId: string, reference: string): void {
+    this.tempo.deleteEvent(calendarId, reference);
+  }
+}
