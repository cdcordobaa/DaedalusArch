diff --git a/step-02/src/bookings/acl/MembershipDirectory.ts b/step-03/src/bookings/acl/MembershipDirectory.ts
index c2d2a78bf..90b49d673 100644
--- a/step-02/src/bookings/acl/MembershipDirectory.ts
+++ b/step-03/src/bookings/acl/MembershipDirectory.ts
@@ -12,4 +12,8 @@ export class MembershipDirectory implements MemberDirectory {
   levelOf(memberId: string): string | undefined {
     return this.membership.card(memberId)?.level;
   }
+
+  addVisits(memberId: string, visits: number): void {
+    this.membership.addVisits(memberId, visits);
+  }
