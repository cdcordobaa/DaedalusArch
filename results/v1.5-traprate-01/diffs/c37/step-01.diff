+
+  async deliveryOf(textId: string): Promise<'delivered' | 'failed' | 'sent'> {
+    const report = await this.client.deliveryReport(textId);
+    switch (report.deliveryState) {
+      case 'DELIVERED':
+        return 'delivered';
+      case 'UNDELIVERED':
+      case 'EXPIRED':
+        return 'failed';
+      default:
+        return 'sent';
+    }
+  }
 }
