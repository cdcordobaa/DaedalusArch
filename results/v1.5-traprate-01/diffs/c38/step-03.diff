--- a/step-02/src/application/ports/out/TextMessages.ts
+++ b/step-03/src/application/ports/out/TextMessages.ts
@@ -9,8 +9,26 @@ export class TextsThrottledError extends Error {
   }
 }
 
+/** The recipient opted out (replied STOP); the number must never be texted again. */
+export class TextsOptedOutError extends Error {
+  constructor(cause?: unknown) {
+    super(cause instanceof Error ? cause.message : 'recipient opted out');
+    this.name = 'TextsOptedOutError';
+  }
+}
+
+/** The phone carrier blocks the number; not an opt-out, so it may be tried again later. */
+export class TextsCarrierBlockedError extends Error {
+  constructor(cause?: unknown) {
+    super(cause instanceof Error ? cause.message : 'recipient blocked by carrier');
+    this.name = 'TextsCarrierBlockedError';
+  }
+}
+
 /** Sends a text message to a patient's phone, in the application's own terms. */
 export interface TextMessages {
+  /** Whether the number is known to have opted out; such a number is never texted. */
+  hasOptedOut(phone: PhoneNumber): Promise<boolean>;
   send(to: PhoneNumber, text: string): Promise<SentText>;
   /** The latest delivery status of a text we sent, by its id. */
   deliveryOf(textId: string): Promise<DeliveryStatus>;
