+/** A rate from euro to one currency, as the pricing rules need it. */
+export interface EuroRate {
+  readonly currency: string;
+  readonly mid: number;
+  readonly asOf: Date;
+  readonly indicative: boolean;
+}
+
+export interface ExchangeRates {
+  /** The latest rate from EUR to the given currency, if there is one. */
+  latestFromEur(currency: string): Promise<EuroRate | undefined>;
+}
