{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://daedalus-arch.local/schemas/report.schema.json",
  "$comment": "FROZEN at U3-R10 (FR-14, FR-36; U3 BR-U3-59, 60, 65; domain-entities.md §7). Embedded as REPORT_SCHEMA in src/scoring-engine/report-schema.ts (deep-equal test); validateReport runs it on every assembled report. Version = $id + the CLI commit (no reportSchemaVersion). A change reopens U3 as a reviewed patch. Enums mirror NODE_TYPES, EDGE_TYPES, DIMENSIONS (src/shared/types/enums.ts) and BUILT_IN_VIOLATION_TYPES; neuralResults rows are U4 NeuralResultRow (U4 DE §4.8).",
  "title": "DaedalusArch evaluation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "projectPath",
    "specVersion",
    "evaluationMode",
    "durationMs",
    "verdict",
    "scoring",
    "perDimensionScores",
    "droppedDimensions",
    "violations",
    "functionExecution",
    "functionResults",
    "disabledFunctions",
    "universalMetrics",
    "graphStats",
    "layerAnnotation",
    "parseCoverage",
    "importResolution",
    "timings",
    "judge",
    "warnings"
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "evaluationMode"
        ],
        "properties": {
          "evaluationMode": {
            "const": "neuronal-only"
          }
        }
      },
      "then": {
        "required": [
          "ahsNeuronal",
          "neuralResults"
        ]
      },
      "else": {
        "required": [
          "ahsDeterministic"
        ]
      }
    },
    {
      "if": {
        "required": [
          "evaluationMode"
        ],
        "properties": {
          "evaluationMode": {
            "const": "full"
          }
        }
      },
      "then": {
        "required": [
          "ahsCombined",
          "ahsNeuronal",
          "neuralResults"
        ]
      }
    },
    {
      "if": {
        "required": [
          "evaluationMode"
        ],
        "properties": {
          "evaluationMode": {
            "const": "symbolic-only"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "neuralResults"
          ]
        }
      }
    }
  ],
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "projectPath": {
      "type": "string"
    },
    "specVersion": {
      "type": "string"
    },
    "ahsDeterministic": {
      "$ref": "#/definitions/unitInterval"
    },
    "ahsCombined": {
      "$ref": "#/definitions/unitInterval"
    },
    "ahsNeuronal": {
      "$ref": "#/definitions/unitInterval"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "warning",
        "soft-block",
        "hard-block"
      ]
    },
    "scoring": {
      "$ref": "#/definitions/reportScoring"
    },
    "perDimensionScores": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/perDimensionScore"
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/violation"
      }
    },
    "universalMetrics": {
      "$ref": "#/definitions/universalHealthMetrics"
    },
    "evaluationMode": {
      "type": "string",
      "enum": [
        "full",
        "symbolic-only",
        "neuronal-only"
      ]
    },
    "durationMs": {
      "$ref": "#/definitions/nonNegativeNumber"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/pipelineWarning"
      }
    },
    "functionExecution": {
      "$ref": "#/definitions/functionExecution"
    },
    "functionResults": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/functionResultRow"
      }
    },
    "disabledFunctions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/disabledFunctionRow"
      }
    },
    "graphStats": {
      "$ref": "#/definitions/graphStats"
    },
    "layerAnnotation": {
      "$ref": "#/definitions/layerAnnotationSummary"
    },
    "parseCoverage": {
      "$ref": "#/definitions/parseCoverage"
    },
    "importResolution": {
      "$ref": "#/definitions/importResolutionStats"
    },
    "timings": {
      "$ref": "#/definitions/stageTimings"
    },
    "droppedDimensions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/droppedDimension"
      }
    },
    "judge": {
      "$ref": "#/definitions/judgeProvenance"
    },
    "neuralResults": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/neuralResultRow"
      }
    }
  },
  "definitions": {
    "unitInterval": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "nonNegativeNumber": {
      "type": "number",
      "minimum": 0
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "countOrNull": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "ratioOrNull": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "dimension": {
      "type": "string",
      "enum": [
        "structural",
        "coupling",
        "pattern",
        "solid",
        "convention",
        "semantic",
        "integrity"
      ]
    },
    "nodeType": {
      "type": "string",
      "enum": [
        "File",
        "Class",
        "Interface",
        "Method",
        "Function",
        "Package"
      ]
    },
    "edgeType": {
      "type": "string",
      "enum": [
        "IMPORTS",
        "IMPLEMENTS",
        "EXTENDS",
        "CONSTRUCTOR_INJECTS",
        "CALLS",
        "DECLARES",
        "CONTAINS",
        "FLOWS_TO",
        "RE_EXPORTS"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "major",
        "minor",
        "advisory"
      ]
    },
    "route": {
      "type": "string",
      "enum": [
        "symbolic",
        "neuronal",
        "hybrid"
      ]
    },
    "templateTag": {
      "type": "string",
      "enum": [
        "structural",
        "topological",
        "pattern-proxy"
      ]
    },
    "violationType": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "LAYER_VIOLATION",
            "CYCLIC_DEPENDENCY",
            "LAYER_SKIP",
            "DOMAIN_OUTWARD_DEP",
            "DOMAIN_PURITY_VIOLATION",
            "DEPENDENCY_INVERSION_VIOLATION",
            "REPOSITORY_PATTERN_VIOLATION",
            "USE_CASE_ISOLATION_VIOLATION",
            "CONTROLLER_ENTITY_VIOLATION",
            "FAN_OUT_EXCEEDED",
            "FAN_IN_EXCEEDED",
            "INSTABILITY_VIOLATION",
            "ORPHAN_FILE",
            "LOW_ABSTRACTION_RATIO",
            "SRP_VIOLATION",
            "ISP_VIOLATION",
            "INHERITANCE_DEPTH_EXCEEDED",
            "NAMING_CONVENTION",
            "PLACEMENT_CONVENTION",
            "MISSING_TEST_FILE",
            "INDEX_LOGIC_VIOLATION",
            "SEMANTIC_RULE_VIOLATION",
            "INTENT_VIOLATION",
            "DOMAIN_STATE_PURITY_VIOLATION",
            "INTEGRITY_VIOLATION"
          ]
        },
        {
          "type": "string",
          "pattern": "^CUSTOM_"
        }
      ]
    },
    "violation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "dimension",
        "severity",
        "functionId",
        "route",
        "filePath",
        "message",
        "deterministic"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/violationType"
        },
        "dimension": {
          "$ref": "#/definitions/dimension"
        },
        "severity": {
          "$ref": "#/definitions/severity"
        },
        "functionId": {
          "type": "string"
        },
        "route": {
          "$ref": "#/definitions/route"
        },
        "filePath": {
          "type": "string"
        },
        "sourceLayer": {
          "type": "string"
        },
        "targetLayer": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deterministic": {
          "type": "boolean"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "target": {
          "type": "string"
        },
        "isTypeOnly": {
          "type": "boolean"
        },
        "tag": {
          "$ref": "#/definitions/templateTag"
        },
        "unitId": {
          "type": "string"
        },
        "discriminator": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "perDimensionScore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "avr",
        "violatedWeight",
        "weight",
        "effectiveWeight",
        "violationCount",
        "functionCount"
      ],
      "properties": {
        "dimension": {
          "$ref": "#/definitions/dimension"
        },
        "avr": {
          "$ref": "#/definitions/unitInterval"
        },
        "violatedWeight": {
          "$ref": "#/definitions/nonNegativeNumber"
        },
        "weight": {
          "$ref": "#/definitions/nonNegativeNumber"
        },
        "effectiveWeight": {
          "$ref": "#/definitions/unitInterval"
        },
        "violationCount": {
          "$ref": "#/definitions/count"
        },
        "functionCount": {
          "$ref": "#/definitions/count"
        }
      }
    },
    "universalHealthMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cyclicDependencyCount",
        "maxFanOut",
        "maxFanIn",
        "abstractionRatio",
        "averageInstability",
        "orphanFileCount"
      ],
      "properties": {
        "cyclicDependencyCount": {
          "$ref": "#/definitions/countOrNull"
        },
        "maxFanOut": {
          "$ref": "#/definitions/countOrNull"
        },
        "maxFanIn": {
          "$ref": "#/definitions/countOrNull"
        },
        "abstractionRatio": {
          "$ref": "#/definitions/ratioOrNull"
        },
        "averageInstability": {
          "$ref": "#/definitions/ratioOrNull"
        },
        "orphanFileCount": {
          "$ref": "#/definitions/countOrNull"
        }
      }
    },
    "pipelineWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "stage"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "context": {
          "type": "object"
        },
        "stage": {
          "type": "string"
        }
      }
    },
    "functionFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "functionId",
        "name",
        "code",
        "message"
      ],
      "properties": {
        "functionId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "functionExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared",
        "adrDerived",
        "compiled",
        "disabled",
        "dropped",
        "skippedByMode",
        "noJudgeUnits",
        "executed",
        "failed"
      ],
      "properties": {
        "declared": {
          "$ref": "#/definitions/count"
        },
        "adrDerived": {
          "$ref": "#/definitions/count"
        },
        "compiled": {
          "$ref": "#/definitions/count"
        },
        "disabled": {
          "$ref": "#/definitions/count"
        },
        "dropped": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skippedByMode": {
          "$ref": "#/definitions/count"
        },
        "noJudgeUnits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "executed": {
          "$ref": "#/definitions/count"
        },
        "failed": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/functionFailure"
          }
        }
      }
    },
    "functionResultRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "functionId",
        "name",
        "dimension",
        "route",
        "passed",
        "violationCount",
        "executionTimeMs",
        "truncated"
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "route"
            ],
            "properties": {
              "route": {
                "enum": [
                  "symbolic",
                  "hybrid"
                ]
              }
            }
          },
          "then": {
            "required": [
              "tag"
            ]
          }
        },
        {
          "if": {
            "required": [
              "route"
            ],
            "properties": {
              "route": {
                "const": "neuronal"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "tag"
              ]
            }
          }
        }
      ],
      "properties": {
        "functionId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "dimension": {
          "$ref": "#/definitions/dimension"
        },
        "route": {
          "$ref": "#/definitions/route"
        },
        "tag": {
          "$ref": "#/definitions/templateTag"
        },
        "passed": {
          "type": "boolean"
        },
        "violationCount": {
          "$ref": "#/definitions/count"
        },
        "executionTimeMs": {
          "$ref": "#/definitions/nonNegativeNumber"
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "disabledFunctionRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "functionId",
        "name",
        "reason"
      ],
      "properties": {
        "functionId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "scoringWeights": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/dimension"
      },
      "additionalProperties": {
        "$ref": "#/definitions/nonNegativeNumber"
      }
    },
    "reportScoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weights",
        "thresholds",
        "confidenceThresholds",
        "verdictSource"
      ],
      "properties": {
        "weights": {
          "$ref": "#/definitions/scoringWeights"
        },
        "fullModeWeights": {
          "$ref": "#/definitions/scoringWeights"
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pass",
            "warning",
            "softBlock"
          ],
          "properties": {
            "pass": {
              "$ref": "#/definitions/unitInterval"
            },
            "warning": {
              "$ref": "#/definitions/unitInterval"
            },
            "softBlock": {
              "$ref": "#/definitions/unitInterval"
            }
          }
        },
        "confidenceThresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "high",
            "medium",
            "iccMinimum"
          ],
          "properties": {
            "high": {
              "$ref": "#/definitions/unitInterval"
            },
            "medium": {
              "$ref": "#/definitions/unitInterval"
            },
            "iccMinimum": {
              "$ref": "#/definitions/unitInterval"
            }
          }
        },
        "verdictSource": {
          "type": "string",
          "enum": [
            "ahsDeterministic",
            "ahsCombined",
            "ahsNeuronal"
          ]
        }
      }
    },
    "countByNodeType": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/nodeType"
      },
      "additionalProperties": {
        "$ref": "#/definitions/count"
      }
    },
    "countByEdgeType": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/edgeType"
      },
      "additionalProperties": {
        "$ref": "#/definitions/count"
      }
    },
    "graphStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeCount",
        "edgeCount",
        "layerCoverage",
        "nodeCountByType",
        "edgeCountByType"
      ],
      "properties": {
        "nodeCount": {
          "$ref": "#/definitions/count"
        },
        "edgeCount": {
          "$ref": "#/definitions/count"
        },
        "layerCoverage": {
          "$ref": "#/definitions/nonNegativeNumber"
        },
        "nodeCountByType": {
          "$ref": "#/definitions/countByNodeType"
        },
        "edgeCountByType": {
          "$ref": "#/definitions/countByEdgeType"
        }
      }
    },
    "layerAnnotationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mapped",
        "unmapped",
        "unmappedFiles"
      ],
      "properties": {
        "mapped": {
          "$ref": "#/definitions/count"
        },
        "unmapped": {
          "$ref": "#/definitions/count"
        },
        "unmappedFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "skippedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filePath",
        "reason"
      ],
      "properties": {
        "filePath": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "parseCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "parsed",
        "percentage",
        "skipped"
      ],
      "properties": {
        "total": {
          "$ref": "#/definitions/count"
        },
        "parsed": {
          "$ref": "#/definitions/count"
        },
        "percentage": {
          "$ref": "#/definitions/nonNegativeNumber"
        },
        "skipped": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/skippedFile"
          }
        }
      }
    },
    "importResolutionStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolvedInternal",
        "external",
        "unresolved",
        "unsupportedDynamic",
        "externalOutOfRootAlias",
        "droppedNoFileNode"
      ],
      "properties": {
        "resolvedInternal": {
          "$ref": "#/definitions/count"
        },
        "external": {
          "$ref": "#/definitions/count"
        },
        "unresolved": {
          "$ref": "#/definitions/count"
        },
        "unsupportedDynamic": {
          "$ref": "#/definitions/count"
        },
        "externalOutOfRootAlias": {
          "$ref": "#/definitions/count"
        },
        "droppedNoFileNode": {
          "$ref": "#/definitions/count"
        }
      }
    },
    "stageTimingEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "durationMs",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "durationMs": {
          "$ref": "#/definitions/nonNegativeNumber"
        },
        "status": {
          "type": "string",
          "enum": [
            "success",
            "warning",
            "error",
            "skipped"
          ]
        }
      }
    },
    "stageTimings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stages",
        "totalMs"
      ],
      "properties": {
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/stageTimingEntry"
          }
        },
        "totalMs": {
          "$ref": "#/definitions/nonNegativeNumber"
        }
      }
    },
    "droppedDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "reason",
        "declared",
        "executed"
      ],
      "properties": {
        "dimension": {
          "$ref": "#/definitions/dimension"
        },
        "reason": {
          "type": "string",
          "enum": [
            "disabled_by_spec",
            "execution_failure",
            "none_declared",
            "no-judge-units"
          ]
        },
        "declared": {
          "$ref": "#/definitions/count"
        },
        "executed": {
          "$ref": "#/definitions/count"
        }
      }
    },
    "judgeProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "runsPerUnit"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "claude-cli",
            "gemini",
            "mock",
            "null",
            "none"
          ]
        },
        "model": {
          "type": "string"
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "cliVersion": {
          "type": "string"
        },
        "cassetteMode": {
          "type": "string",
          "enum": [
            "record",
            "replay"
          ]
        },
        "runsPerUnit": {
          "$ref": "#/definitions/count"
        },
        "resolvedModel": {
          "type": "string"
        },
        "repetition": {
          "$ref": "#/definitions/count"
        },
        "isolationProbeSha256": {
          "type": "string"
        },
        "configListingSha256": {
          "type": "string"
        },
        "provenanceMixed": {
          "type": "boolean"
        },
        "seededList": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "neuralUnitRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unitId",
        "unitKind",
        "layer",
        "filePaths",
        "status",
        "verdict",
        "confidence",
        "confidenceStdDev",
        "flaggedUnstable",
        "validRunCount"
      ],
      "properties": {
