{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "FIG-05 SO2 latency per run and cycle query against the 30 s H13 budget, from so2-metrics latency.csv (scripts/figures.ts; ADR-021 X-5, item 8).",
  "usermeta": {
    "figure": "so2-latency"
  },
  "resolve": {
    "scale": {
      "color": "independent"
    },
    "legend": {
      "color": "independent"
    }
  },
  "hconcat": [
    {
      "width": 260,
      "height": 200,
      "mark": {
        "type": "point",
        "filled": true,
        "size": 50
      },
      "encoding": {
        "x": {
          "field": "file_count",
          "type": "quantitative",
          "title": "files"
        },
        "y": {
          "field": "total_s",
          "type": "quantitative",
          "title": "total evaluation time (s)"
        },
        "color": {
          "field": "gate_result",
          "type": "nominal",
          "title": "H13 gate"
        },
        "tooltip": [
          {
            "field": "run_id"
          },
          {
            "field": "project_id"
          },
          {
            "field": "status"
          },
          {
            "field": "file_count"
          },
          {
            "field": "total_s",
            "format": ".1f"
          },
          {
            "field": "gate_result"
          }
        ]
      },
      "transform": [
        {
          "filter": "datum.query === 'FF-S02'"
        }
      ]
    },
    {
      "width": 260,
      "height": 200,
      "layer": [
        {
          "mark": "bar",
          "encoding": {
            "x": {
              "field": "run_id",
              "type": "nominal",
              "sort": null,
              "title": "run",
              "axis": {
                "labelAngle": 0
              }
            },
            "y": {
              "field": "query_s",
              "type": "quantitative",
              "title": "cycle query time (s)"
            },
            "color": {
              "field": "exceeds",
              "type": "nominal",
              "title": "timed out or over budget"
            },
            "tooltip": [
              {
                "field": "project_id"
              },
              {
                "field": "query"
              },
              {
                "field": "query_s",
                "format": ".2f"
              },
              {
                "field": "query_status"
              },
              {
                "field": "gate_result"
              }
            ],
            "xOffset": {
              "field": "query",
              "type": "nominal",
              "sort": [
                "FF-S02",
                "universal cycle metric"
              ]
            }
          }
        },
        {
          "mark": {
            "type": "rule",
            "strokeDash": [
              4,
              3
            ]
          },
          "encoding": {
            "y": {
              "aggregate": "max",
              "field": "budget_s",
              "type": "quantitative"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.query_status !== 'ok'"
            }
          ],
          "mark": {
            "type": "text",
            "angle": -90,
            "align": "left",
            "dx": 4,
            "fontSize": 9
          },
          "encoding": {
            "x": {
              "field": "run_id",
              "type": "nominal",
              "sort": null
            },
            "xOffset": {
              "field": "query",
              "type": "nominal",
              "sort": [
                "FF-S02",
                "universal cycle metric"
              ]
            },
            "y": {
              "datum": 0,
              "type": "quantitative"
            },
            "text": {
              "field": "query_status"
            }
          }
        }
      ]
    }
  ]
}
