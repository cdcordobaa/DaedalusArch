{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://daedalus-arch.local/scripts/lib/schemas/prereg.schema.json",
  "$comment": "U5b PreRegistration (corpus/prereg.json; domain-entities §7; BR-U5b-50, 51). version > 1 additionally needs reason and previous (checked in scripts/lib/prereg.ts).",
  "title": "DaedalusArch pre-registration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "registeredAt", "matchingRuleVersion", "artefacts", "labellingBudgetCalls", "e1Grid"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "registeredAt": { "type": "string", "format": "date-time" },
    "reason": { "type": "string", "minLength": 1 },
    "matchingRuleVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "artefacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "pattern": "^[^/].*$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "labellingBudgetCalls": { "type": "integer", "minimum": 0 },
    "e1Grid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["models", "specLevels", "tasks", "runs"],
      "properties": {
        "models": { "enum": [3, 4] },
        "specLevels": { "const": 3 },
        "tasks": { "const": 2 },
        "runs": { "const": 3 },
        "arms": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "previous": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "commit"],
        "properties": {
          "version": { "type": "integer", "minimum": 1 },
          "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" }
        }
      }
    }
  }
}
