{
  "$id": "https://daedalusarch/v1.3/expected-findings.schema.json",
  "title": "Expected findings of one reference-project variant (FR-V3)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "style",
    "variant",
    "kind",
    "plants",
    "description",
    "patch",
    "expectedFindings"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "style": {
      "type": "string",
      "enum": [
        "clean-architecture",
        "layered",
        "nestjs",
        "hexagonal"
      ]
    },
    "variant": {
      "type": "string",
      "pattern": "^(clean|[vn][0-9]{2}-[a-z0-9-]+)$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "clean",
        "violation",
        "near-miss"
      ]
    },
    "plants": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^FF-[A-Z]+[0-9]{2}$"
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "patch": {
      "type": [
        "string",
        "null"
      ]
    },
    "expectedFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ruleId",
          "ruleName",
          "file",
          "reason"
        ],
        "properties": {
          "ruleId": {
            "type": "string",
            "pattern": "^FF-[A-Z]+[0-9]{2}$"
          },
          "ruleName": {
            "type": "string",
            "minLength": 3
          },
          "file": {
            "type": "string",
            "pattern": "^src/.+\\.ts$"
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "clean"
          }
        }
      },
      "then": {
        "properties": {
          "variant": {
            "const": "clean"
          },
          "plants": {
            "const": null
          },
          "patch": {
            "const": null
          }
        }
      },
      "else": {
        "properties": {
          "patch": {
            "type": "string",
            "const": "variant.patch"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "violation"
          }
        }
      },
      "then": {
        "properties": {
          "plants": {
            "type": "string"
          },
          "variant": {
            "pattern": "^v[0-9]{2}-"
          },
          "expectedFindings": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "near-miss"
          }
        }
      },
      "then": {
        "properties": {
          "plants": {
            "const": null
          },
          "variant": {
            "pattern": "^n[0-9]{2}-"
          }
        }
      }
    }
  ]
}
