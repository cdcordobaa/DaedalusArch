{
  "$id": "https://daedalusarch/v1.3/expected-graph.schema.json",
  "title": "Hand-written expected graph of a reference project (FR-V3, ground truth for FR-V2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "style", "variant", "note", "files", "edges"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "style": { "type": "string", "enum": ["clean-architecture", "layered", "nestjs", "hexagonal"] },
    "variant": { "const": "clean" },
    "note": { "type": "string" },
    "files": {
      "type": "array", "minItems": 15, "maxItems": 40,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "layer"],
        "properties": { "path": { "type": "string", "pattern": "^src/.+\\.ts$" }, "layer": { "type": ["string", "null"] } }
      }
    },
    "edges": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["from", "to", "kind"],
        "properties": {
          "from": { "type": "string", "pattern": "^src/.+\\.ts$" },
          "to": { "type": "string", "pattern": "^src/.+\\.ts$" },
          "kind": { "type": "string", "enum": ["import", "re-export"] }
        }
      }
    }
  }
}
