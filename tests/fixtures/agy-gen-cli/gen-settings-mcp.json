{
  "showTips": false,
  "toolPermission": "strict",
  "enableTerminalSandbox": true,
  "disableSlashCommands": true,
  "permissions": {
    "allow": [
      "read_file(<CWD>/**)",
      "write_file(<CWD>/**)",
      "<TYPECHECK_RULE>",
      "mcp(daedalus-arch/get_architecture_spec)",
      "mcp(daedalus-arch/which_layer)",
      "mcp(daedalus-arch/check_import)",
      "mcp(daedalus-arch/explain_violation)",
      "mcp(daedalus-arch/check_file)",
      "mcp(daedalus-arch/check_diff)",
      "mcp(daedalus-arch/suggest_placement)",
      "mcp(daedalus-arch/infer_spec)",
      "mcp(daedalus-arch/explain_finding)"
    ],
    "deny": [
      "read_url(*)",
      "execute_url(*)",
      "unsandboxed(*)",
      "mcp(daedalus-arch/evaluate_project)"
    ],
    "ask": []
  }
}
