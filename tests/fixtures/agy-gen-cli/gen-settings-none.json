{
  "showTips": false,
  "toolPermission": "strict",
  "enableTerminalSandbox": true,
  "disableSlashCommands": true,
  "permissions": {
    "allow": [
      "read_file(<CWD>/**)",
      "write_file(<CWD>/**)",
      "command(<H>/bin/tsc --noEmit --incremental false -p <H>/runs/<RUN>/tsconfig.json)"
    ],
    "deny": [
      "read_url(*)",
      "search_web(*)",
      "browser(*)",
      "subagent(*)",
      "schedule(*)",
      "generate_image(*)",
      "workflow(*)",
      "inbox(*)",
      "plugin(*)",
      "mcp(daedalus-arch/evaluate_project)",
      "mcp(*)"
    ],
    "ask": []
  }
}
