{
  "showTips": false,
  "toolPermission": "strict",
  "enableTerminalSandbox": true,
  "disableSlashCommands": true,
  "permissions": {
    "allow": [
      "read_file(<CWD>/**)",
      "write_file(<CWD>/**)",
      "<TYPECHECK_RULE>"
    ],
    "deny": [
      "read_url(*)",
      "execute_url(*)",
      "unsandboxed(*)",
      "mcp(*)"
    ],
    "ask": []
  }
}
