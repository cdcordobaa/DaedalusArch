@@ -0,0 +1,9 @@
+import { OverdueNotifier } from '../../application/ports/infrastructure/OverdueNotifier';
+
+export class ConsoleOverdueNotifier implements OverdueNotifier {
+  readonly sent: string[] = [];
+
+  async remind(email: string, loanIds: readonly string[]): Promise<void> {
+    this.sent.push(`${email}: ${loanIds.join(', ')}`);
+  }
+}
