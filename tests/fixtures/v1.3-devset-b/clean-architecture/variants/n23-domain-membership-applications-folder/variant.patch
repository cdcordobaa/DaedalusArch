@@ -0,0 +1,12 @@
+import { MembershipApplication } from '../applications/MembershipApplication';
+import { Member } from '../entities/Member';
+import { DomainError } from '../errors/DomainError';
+
+export class MembershipApproval {
+  approve(application: MembershipApplication, memberId: string): Member {
+    if (application.referees.length === 0) {
+      throw new DomainError('NO_REFEREE', `${application.applicantName} needs at least one referee`);
+    }
+    return new Member(memberId, application.applicantName, application.email, 3);
+  }
+}
