+import { Loan } from '../entities/Loan';
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+export const EXPRESS_GRACE_DAYS = 1;
+
+export function withinExpressGrace(loan: Loan, now: Date): boolean {
+  return now.getTime() - loan.dueAt.getTime() <= EXPRESS_GRACE_DAYS * DAY_MS;
+}
