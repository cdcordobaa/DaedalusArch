+import type { Request, Response } from 'express';
+import { LoanController } from './LoanController';
+
+export class ExpressLoanRoutes {
+  constructor(private readonly loans: LoanController) {}
+
+  async borrow(request: Request, response: Response): Promise<void> {
+    const result = await this.loans.borrow({ params: request.params, body: request.body });
+    response.status(result.status).json(result.body);
+  }
+
+  async overdue(_request: Request, response: Response): Promise<void> {
+    const result = await this.loans.overdue();
+    response.status(result.status).json(result.body);
+  }
+}
