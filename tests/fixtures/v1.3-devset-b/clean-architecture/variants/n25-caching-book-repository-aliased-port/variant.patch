+import { Book } from '../../domain/entities/Book';
+import type { BookRepository as BookCatalogue } from '../../domain/repositories/BookRepository';
+
+export class CachingBookRepository implements BookCatalogue {
+  private readonly cache = new Map<string, Book>();
+
+  constructor(private readonly source: BookCatalogue) {}
+
+  async findById(id: string): Promise<Book | undefined> {
+    const hit = this.cache.get(id);
+    if (hit !== undefined) return hit;
+    const book = await this.source.findById(id);
+    if (book !== undefined) this.cache.set(id, book);
+    return book;
+  }
+
+  async save(book: Book): Promise<void> {
+    await this.source.save(book);
+    this.cache.set(book.id, book);
+  }
+}
