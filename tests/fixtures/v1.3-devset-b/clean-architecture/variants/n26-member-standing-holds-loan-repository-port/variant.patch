+import { Member } from '../entities/Member';
+import { LoanRepository } from '../repositories/LoanRepository';
+import { FineCalculator } from './FineCalculator';
+
+export class MemberStanding {
+  private readonly fines = new FineCalculator(25);
+
+  constructor(private readonly loans: LoanRepository) {}
+
+  async outstandingFinesInCents(member: Member, now: Date): Promise<number> {
+    const active = await this.loans.findActiveByMember(member.id);
+    return active.reduce((sum, loan) => sum + this.fines.fineInCents(loan, now), 0);
+  }
+}
