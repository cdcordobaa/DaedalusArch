@@ -0,0 +1,20 @@
+import { RegisterMemberUseCase } from '../../application/use-cases/RegisterMemberUseCase';
+import { toErrorResponse } from './ErrorMapper';
+import { HttpRequest, HttpResponse, created } from './HttpTypes';
+
+export class MemberController {
+  constructor(private readonly registerMember: RegisterMemberUseCase) {}
+
+  async register(request: HttpRequest): Promise<HttpResponse> {
+    try {
+      const member = await this.registerMember.execute({
+        name: String(request.body['name']),
+        email: String(request.body['email']),
+        maxActiveLoans: Number(request.body['maxActiveLoans'] ?? 3),
+      });
+      return created(member);
+    } catch (error) {
+      return toErrorResponse(error);
+    }
+  }
+}
