@@ -0,0 +1,23 @@
+import { Member } from '../../domain/entities/Member';
+import { MemberRepository } from '../../domain/repositories/MemberRepository';
+import { MemberDto, toMemberDto } from '../dto/MemberDto';
+import { IdGenerator } from '../ports/IdGenerator';
+
+export interface RegisterMemberCommand {
+  name: string;
+  email: string;
+  maxActiveLoans: number;
+}
+
+export class RegisterMemberUseCase {
+  constructor(
+    private readonly members: MemberRepository,
+    private readonly ids: IdGenerator,
+  ) {}
+
+  async execute(command: RegisterMemberCommand): Promise<MemberDto> {
+    const member = new Member(this.ids.next('member'), command.name, command.email, command.maxActiveLoans);
+    await this.members.save(member);
+    return toMemberDto(member);
+  }
+}
