+import { DomainError } from '../../domain/errors/DomainError';
+import { BookRepository } from '../../domain/repositories/BookRepository';
+import { Isbn } from '../../domain/value-objects/Isbn';
+import { BookDto, toBookDto } from '../dto/BookDto';
+
+export class FindBookByIsbnUseCase {
+  constructor(private readonly books: BookRepository) {}
+
+  async execute(rawIsbn: string): Promise<BookDto> {
+    const book = await this.books.findByIsbn(Isbn.parse(rawIsbn));
+    if (book === undefined) throw new DomainError('BOOK_NOT_FOUND', `No book with ISBN ${rawIsbn}`);
+    return toBookDto(book);
+  }
+}
