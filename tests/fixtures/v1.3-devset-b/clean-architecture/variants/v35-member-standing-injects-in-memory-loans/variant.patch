@@ -0,0 +1,11 @@
+import { InMemoryLoanRepository } from '../../infrastructure/persistence/InMemoryLoanRepository';
+import { Member } from '../entities/Member';
+
+export class MemberStanding {
+  constructor(private readonly loans: InMemoryLoanRepository) {}
+
+  async isInGoodStanding(member: Member, now: Date): Promise<boolean> {
+    const active = await this.loans.findActiveByMember(member.id);
+    return !active.some((loan) => loan.isOverdue(now)) && active.length < member.maxActiveLoans;
+  }
+}
