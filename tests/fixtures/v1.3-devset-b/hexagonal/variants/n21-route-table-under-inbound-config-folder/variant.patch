+import { BookingController } from '../BookingController';
+import { HttpRequest, HttpResponse } from '../HttpTypes';
+import { RoomController } from '../RoomController';
+
+export interface Route {
+  method: 'GET' | 'POST' | 'DELETE';
+  path: string;
+  handle(request: HttpRequest): Promise<HttpResponse>;
+}
+
+export function buildRoutes(bookings: BookingController, rooms: RoomController): Route[] {
+  return [
+    { method: 'POST', path: '/bookings', handle: (r) => bookings.create(r) },
+    { method: 'DELETE', path: '/bookings/:id', handle: (r) => bookings.cancel(r) },
+    { method: 'GET', path: '/rooms/available', handle: (r) => rooms.available(r) },
+  ];
+}
