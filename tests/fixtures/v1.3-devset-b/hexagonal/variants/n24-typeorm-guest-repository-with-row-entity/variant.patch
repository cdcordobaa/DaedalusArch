+import { Column, Entity, PrimaryColumn } from 'typeorm';
+
+@Entity('guests')
+export class GuestEntity {
+  @PrimaryColumn()
+  id!: string;
+
+  @Column()
+  name!: string;
+
+  @Column()
+  email!: string;
+}
