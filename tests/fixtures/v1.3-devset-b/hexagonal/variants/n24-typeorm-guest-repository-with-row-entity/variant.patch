+import { Repository } from 'typeorm';
+import { GuestRepository } from '../../../application/ports/out/GuestRepository';
+import { Guest } from '../../../domain/model/Guest';
+import { GuestEntity } from './entities/GuestEntity';
+
+export class TypeOrmGuestRepository implements GuestRepository {
+  constructor(private readonly rows: Repository<GuestEntity>) {}
+
+  async findById(id: string): Promise<Guest | undefined> {
+    const row = await this.rows.findOneBy({ id });
+    return row === null ? undefined : new Guest(row.id, row.name, row.email);
+  }
+}
