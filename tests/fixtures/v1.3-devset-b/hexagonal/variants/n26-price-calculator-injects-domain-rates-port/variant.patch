+import { DateRange } from '../../../domain/model/DateRange';
+import { SeasonalRates } from '../../../domain/ports/SeasonalRates';
+
+const FRIDAY = 5;
+const SATURDAY = 6;
+
+export class WeekendRatesAdapter implements SeasonalRates {
+  constructor(private readonly weekendMultiplier = 1.2) {}
+
+  multiplierFor(stay: DateRange): number {
+    const day = stay.checkIn.getUTCDay();
+    return day === FRIDAY || day === SATURDAY ? this.weekendMultiplier : 1;
+  }
+}
