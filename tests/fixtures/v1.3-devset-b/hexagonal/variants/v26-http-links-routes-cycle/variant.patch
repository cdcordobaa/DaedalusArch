@@ -0,0 +1,12 @@
+import { BookingController } from './BookingController';
+import { RoomController } from './RoomController';
+
+type Handler<C> = { [K in keyof C]: C[K] extends (...args: never[]) => unknown ? K : never }[keyof C];
+
+export const ROUTES = {
+  'booking.create': { method: 'POST', path: '/bookings', handler: 'create' as Handler<BookingController> },
+  'booking.cancel': { method: 'DELETE', path: '/bookings/:id', handler: 'cancel' as Handler<BookingController> },
+  'room.available': { method: 'GET', path: '/rooms/available', handler: 'available' as Handler<RoomController> },
+} as const;
+
+export type RouteName = keyof typeof ROUTES;
