+import { InMemoryDatabase } from '../Database';
+import { BusinessDay, BusinessHoursRecord } from './BusinessHoursRecord';
+
+export class BusinessHoursGateway {
+  constructor(private readonly db: InMemoryDatabase) {}
+
+  findByDay(day: BusinessDay): BusinessHoursRecord | undefined {
+    return this.db.table<BusinessHoursRecord>('business_hours').get(day);
+  }
+
+  save(record: BusinessHoursRecord): void {
+    this.db.table<BusinessHoursRecord>('business_hours').set(record.day, { ...record });
+  }
+}
