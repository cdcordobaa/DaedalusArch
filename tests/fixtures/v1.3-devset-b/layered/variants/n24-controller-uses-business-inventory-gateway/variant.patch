@@ -0,0 +1,18 @@
+import { ProductGateway } from '../../persistence/ProductGateway';
+import { BusinessError } from '../errors/BusinessError';
+
+export interface StockLevel {
+  sku: string;
+  available: number;
+  reorder: boolean;
+}
+
+export class InventoryGateway {
+  constructor(private readonly products: ProductGateway) {}
+
+  stockOf(sku: string): StockLevel {
+    const row = this.products.findBySku(sku);
+    if (row === undefined) throw new BusinessError('NOT_FOUND', `No product ${sku}`);
+    return { sku: row.sku, available: row.stock, reorder: row.stock < 5 };
+  }
+}
