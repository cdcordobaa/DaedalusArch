+import { OrderGateway } from '../../persistence/OrderGateway';
+import { ProductGateway } from '../../persistence/ProductGateway';
+import { Product } from '../model/Product';
+import { toProduct } from './RecordMapping';
+
+export class RestockService {
+  constructor(
+    private readonly products: ProductGateway,
+    private readonly orders: OrderGateway,
+    private readonly threshold = 5,
+  ) {}
+
+  productsToReorder(): Product[] {
+    return this.products
+      .findAll()
+      .map(toProduct)
+      .filter((product) => product.stock < this.threshold);
+  }
+
+  restock(sku: string, quantity: number): void {
+    const row = this.products.findBySku(sku);
+    if (row !== undefined) this.products.updateStock(sku, row.stock + quantity);
+  }
+
+  openDemand(customerId: string): number {
+    return this.orders
+      .findByCustomer(customerId)
+      .filter((row) => row.status === 'placed')
+      .reduce((sum, row) => sum + row.lines.reduce((n, line) => n + line.quantity, 0), 0);
+  }
+}
