+import { CustomerGateway } from '../../persistence/CustomerGateway';
+import { OrderGateway } from '../../persistence/OrderGateway';
+import { BusinessError } from '../errors/BusinessError';
+import { Customer } from '../model/Customer';
+import { Order } from '../model/Order';
+import { toCustomer, toOrder } from './RecordMapping';
+
+export interface OrderHistory {
+  customer: Customer;
+  orders: Order[];
+}
+
+export class CustomerService {
+  constructor(
+    private readonly customers: CustomerGateway,
+    private readonly orders: OrderGateway,
+  ) {}
+
+  history(customerId: string): OrderHistory {
+    const record = this.customers.findById(customerId);
+    if (record === undefined) throw new BusinessError('NOT_FOUND', `No customer ${customerId}`);
+    const orders = this.orders.findByCustomer(customerId).map(toOrder);
+    return { customer: toCustomer(record), orders: orders.sort((a, b) => b.createdAt.getTime() - a.createdAt.getTime()) };
+  }
+}
