+import { CustomerService } from '../../business/services/CustomerService';
+import { renderHistory } from '../views/CustomerView';
+import { errorResponse } from './ErrorHandling';
+import { HttpRequest, HttpResponse } from './HttpTypes';
+
+export class CustomerController {
+  constructor(private readonly customers: CustomerService) {}
+
+  history(request: HttpRequest): HttpResponse {
+    try {
+      return { status: 200, body: renderHistory(this.customers.history(String(request.params['id']))) };
+    } catch (error) {
+      return errorResponse(error);
+    }
+  }
+}
