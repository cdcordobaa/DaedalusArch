+import { OrderHistory } from '../../business/services/CustomerService';
+import { renderOrder, OrderViewModel } from './OrderView';
+
+export interface OrderHistoryViewModel {
+  customer: string;
+  tier: string;
+  orders: OrderViewModel[];
+}
+
+export function renderHistory(history: OrderHistory): OrderHistoryViewModel {
+  return { customer: history.customer.name, tier: history.customer.loyaltyTier, orders: history.orders.map(renderOrder) };
+}
