+import { Attendee } from '../../domain/attendee';
+
+export class AttendeeResponseDto {
+  id!: string;
+  name!: string;
+  email!: string;
+
+  static from(attendee: Attendee): AttendeeResponseDto {
+    return Object.assign(new AttendeeResponseDto(), { id: attendee.id, name: attendee.name, email: attendee.email });
+  }
+}
