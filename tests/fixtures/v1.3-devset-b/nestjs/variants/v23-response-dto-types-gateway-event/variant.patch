@@ -0,0 +1,18 @@
+import { Injectable } from '@nestjs/common';
+
+export type RegistrationEvent = 'registered' | 'cancelled';
+
+type Listener = (event: RegistrationEvent, registrationId: string) => void;
+
+@Injectable()
+export class RegistrationsGateway {
+  private readonly listeners: Listener[] = [];
+
+  subscribe(listener: Listener): void {
+    this.listeners.push(listener);
+  }
+
+  publish(event: RegistrationEvent, registrationId: string): void {
+    for (const listener of this.listeners) listener(event, registrationId);
+  }
+}
