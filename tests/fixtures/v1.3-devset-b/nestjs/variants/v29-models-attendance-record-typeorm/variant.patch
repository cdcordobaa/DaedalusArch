--- /dev/null
+++ b/src/models/attendance-record.ts
@@ -0,0 +1,20 @@
+import { Column, Entity, PrimaryColumn } from 'typeorm';
+
+@Entity('attendance')
+export class AttendanceRecord {
+  @PrimaryColumn()
+  id!: string;
+
+  @Column()
+  workshopId!: string;
+
+  @Column()
+  attendeeId!: string;
+
+  @Column({ nullable: true })
+  checkedInAt?: Date;
+
+  get present(): boolean {
+    return this.checkedInAt !== undefined;
+  }
+}
