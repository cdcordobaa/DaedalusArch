+import { Injectable } from '@nestjs/common';
+
+@Injectable()
+export class InMemoryCheckInRepository {
+  private readonly rows: { workshopId: string; attendeeId: string; at: Date }[] = [];
+
+  async record(workshopId: string, attendeeId: string, at: Date): Promise<void> {
+    this.rows.push({ workshopId, attendeeId, at });
+  }
+
+  async countFor(workshopId: string): Promise<number> {
+    return this.rows.filter((r) => r.workshopId === workshopId).length;
+  }
+}
