@@ -0,0 +1,13 @@
+import { InMemoryAttendeeRepository } from '../attendees/in-memory-attendee.repository';
+import { Attendee } from './attendee';
+import { DomainError } from './domain-error';
+
+export class AttendeeDirectory {
+  constructor(private readonly attendees: InMemoryAttendeeRepository) {}
+
+  async require(id: string): Promise<Attendee> {
+    const attendee = await this.attendees.findById(id);
+    if (attendee === undefined) throw new DomainError('not-found', `No attendee ${id}`);
+    return attendee;
+  }
+}
