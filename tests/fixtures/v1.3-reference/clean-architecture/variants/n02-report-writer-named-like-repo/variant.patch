+import { LoanDto } from '../../application/dto/LoanDto';
+
+/** Formats the overdue list for the librarians' spreadsheet export. Not a repository: it stores nothing. */
+export class CsvReportWriter {
+  write(loans: readonly LoanDto[]): string {
+    const rows = loans.map((loan) => [loan.id, loan.bookId, loan.memberId, loan.dueAt].join(','));
+    return ['id,bookId,memberId,dueAt', ...rows].join('\n');
+  }
+}
