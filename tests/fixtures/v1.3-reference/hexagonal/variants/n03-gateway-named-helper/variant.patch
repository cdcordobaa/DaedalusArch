+/** Helper inside the payment adapter: how often to retry the processor. Not an adapter; it implements no port. */
+export class GatewayRetryPolicy {
+  constructor(private readonly maxAttempts: number) {}
+
+  async run<T>(attempt: () => Promise<T>): Promise<T> {
+    let lastError: unknown;
+    for (let i = 0; i < this.maxAttempts; i += 1) {
+      try {
+        return await attempt();
+      } catch (error) {
+        lastError = error;
+      }
+    }
+    throw lastError;
+  }
+}
