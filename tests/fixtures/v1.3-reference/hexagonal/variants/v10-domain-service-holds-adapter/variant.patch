--- a/src/domain/services/AvailabilityChecker.ts
+++ b/src/domain/services/AvailabilityChecker.ts
@@ -1,8 +1,15 @@
+import { InMemoryBookingRepository } from '../../adapters/outbound/persistence/InMemoryBookingRepository';
 import { Booking } from '../model/Booking';
 import { DateRange } from '../model/DateRange';
 import { Room } from '../model/Room';
 
 export class AvailabilityChecker {
+  private readonly history = new InMemoryBookingRepository();
+
+  async isAvailableNow(room: Room, stay: DateRange): Promise<boolean> {
+    return this.isAvailable(room, stay, await this.history.findByRoom(room.id));
+  }
+
   isAvailable(room: Room, stay: DateRange, bookings: readonly Booking[]): boolean {
     return !bookings.some((b) => b.isActive && b.roomId === room.id && b.stay.overlaps(stay));
   }
