@@ -0,0 +1,15 @@
+import { Injectable } from '@nestjs/common';
+import { WaitlistRepository } from '../domain/waitlist.repository';
+
+@Injectable()
+export class InMemoryWaitlistRepository implements WaitlistRepository {
+  private readonly queues = new Map<string, string[]>();
+
+  async add(workshopId: string, attendeeId: string): Promise<void> {
+    this.queues.set(workshopId, [...(this.queues.get(workshopId) ?? []), attendeeId]);
+  }
+
+  async next(workshopId: string): Promise<string | undefined> {
+    return this.queues.get(workshopId)?.shift();
+  }
+}
