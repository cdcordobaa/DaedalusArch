{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // the vendored SDK and the tree's own alias
    "paths": { "tagbank-sdk": ["vendor/tagbank-sdk/index.d.ts"], "@core/*": ["src/domain/*"] }
  },
  "include": ["src/**/*", "vendor/**/*"]
}
