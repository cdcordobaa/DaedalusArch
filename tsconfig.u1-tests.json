{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "CommonJS",
    "moduleResolution": "node",
    "verbatimModuleSyntax": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["node", "jest"],
    "rootDir": "."
  },
  "include": [
    "src/**/*.ts",
    "tests/unit/fitness-compiler/compiler-input.test.ts",
    "tests/unit/spec-parser/frozen-thresholds.test.ts",
    "tests/unit/spec-parser/function-fields.test.ts",
    "tests/unit/spec-parser/dimension-alias.test.ts",
    "tests/unit/spec-parser/layer-kind-resolver.test.ts",
    "tests/unit/fitness-compiler/pattern-compiler.test.ts",
    "tests/unit/fitness-compiler/layer-binding.test.ts",
    "tests/unit/fitness-compiler/template-applicability.test.ts",
    "tests/unit/fitness-compiler/exclude-markers.test.ts",
    "tests/unit/fitness-compiler/k1-layer-kinds.test.ts",
    "tests/unit/scripts/migrate-corpus-spec.test.ts",
    "scripts/migrate-corpus-spec.ts",
    "scripts/migrate-corpus-spec-cli.ts",
    "tests/unit/fitness-compiler/k2-typed-fields.test.ts",
    "tests/unit/fitness-compiler/unbound-probe.test.ts",
    "tests/unit/spec-parser/k3-cv02-pattern.test.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
