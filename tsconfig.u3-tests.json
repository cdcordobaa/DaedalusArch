{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "CommonJS",
    "moduleResolution": "node",
    "verbatimModuleSyntax": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["node", "jest"],
    "rootDir": "."
  },
  "include": [
    "src/**/*.ts",
    "tests/unit/shared/c10-bundled-patch.test.ts",
    "tests/unit/evaluation-engine/violation-id.test.ts",
    "tests/unit/evaluation-engine/evidence.test.ts",
    "tests/unit/evaluation-engine/cycle-canonicaliser.test.ts",
    "tests/unit/evaluation-engine/scc-cycles.test.ts",
    "tests/unit/scoring-engine/renormaliser.test.ts",
    "tests/unit/scoring-engine/warning-merge.test.ts",
    "tests/unit/scoring-engine/report-builder.test.ts",
    "tests/unit/evaluation-engine/fr12-mapping.test.ts",
    "tests/unit/evaluation-engine/cycle-sentinel.test.ts",
    "tests/unit/evaluation-engine/metric-filters.test.ts",
    "tests/unit/evaluation-engine/domain-purity.test.ts",
    "tests/unit/evaluation-engine/domain-state-purity.test.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
