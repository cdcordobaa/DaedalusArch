{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "CommonJS",
    "moduleResolution": "node",
    "verbatimModuleSyntax": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["node", "jest"],
    "rootDir": "."
  },
  "include": [
    "src/**/*.ts",
    "tests/unit/llm-critic/probe-fixtures.test.ts",
    "tests/unit/shared/types/u4-c10-patch.test.ts",
    "tests/unit/llm-critic/frozen.test.ts",
    "tests/unit/llm-critic/verdict-parser.test.ts",
    "tests/unit/llm-critic/judge-unit-selector.test.ts",
    "tests/unit/llm-critic/source-context.test.ts",
    "tests/unit/llm-critic/aggregation.test.ts",
    "tests/unit/llm-critic/cassette-provider.test.ts",
    "tests/unit/llm-critic/claude-cli-provider.test.ts",
    "tests/unit/llm-critic/provider-factory.test.ts",
    "tests/unit/cli/llm-options.test.ts",
    "tests/unit/llm-critic/judge-graph.test.ts",
    "tests/unit/llm-critic/critic-wiring.test.ts",
    "tests/unit/neuro-symbolic-router/router-modes.test.ts",
    "tests/unit/llm-critic/provenance.test.ts",
    "tests/unit/llm-critic/replay-no-binary.test.ts",
    "tests/unit/llm-critic/neural-result-rows.test.ts",
    "tests/unit/llm-critic/c9-hunks.test.ts",
    "tests/unit/llm-critic/rubric-single-source.test.ts",
    "tests/unit/scripts/corpus-rubric-u4.test.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
